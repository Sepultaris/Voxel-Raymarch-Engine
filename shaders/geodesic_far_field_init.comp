#version 460
#extension GL_GOOGLE_include_directive : require

#ifndef VOXEL_TILE_LOOKUP_WIDTH
#define VOXEL_TILE_LOOKUP_WIDTH 512
#endif
#ifndef VOXEL_TILE_LOOKUP_HEIGHT
#define VOXEL_TILE_LOOKUP_HEIGHT 256
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "shared/geodesic_tile_query_shared.inc"
layout(std430, set = 0, binding = 5) readonly buffer GeodesicTileBuffer {
    GeodesicTile geodesicTiles[];
};
#if VOXEL_SCALE_LAB
layout(std430, set = 0, binding = 9) buffer GeodesicColumnStateBuffer {
#else
layout(std430, set = 0, binding = 9) readonly buffer GeodesicColumnStateBuffer {
#endif
    uvec4 geodesicColumnStates[];
};
layout(std430, set = 0, binding = 15) buffer GeodesicDistanceBoundBuffer {
    uint geodesicFarField[];
};
#if VOXEL_SCALE_LAB
layout(std430, set = 0, binding = 16) buffer GeodesicMacroHierarchyBuffer {
    uvec4 geodesicMacroNodes[];
};
#endif

layout(push_constant) uniform FrameConstants {
    float time;
    float planetRadius;
    uint maxMarchSteps; // hierarchy level: zero rasterizes exact leaf envelopes
    float hitEpsilon;
    uvec2 resolution;
    float cameraDistance;
    uint voxelResolution;
    float cameraYaw;
    float cameraPitch;
    vec2 brushNdc;
    uint editMode;
    uint brushMaterial;
    uint simulationTick;
    uint visualizationMode;
    uint surfaceTileCount;
    uint residentPageCount;
    float planetOuterScale;
    uint geodesicTraversalMode;
    uint streamSamplePhase;
    uint terrainSeed;
    float terrainContinentScale;
    float terrainContinentStrength;
    float terrainMountainScale;
    float terrainMountainStrength;
    float terrainRoughness;
    float terrainOceanLevel;
    float terrainPolarStrength;
    uint cameraMode;
    float surfaceHeading;
    float surfaceLookPitch;
} frame;

const uint kBaseWidth = VOXEL_TILE_LOOKUP_WIDTH;
const uint kBaseHeight = VOXEL_TILE_LOOKUP_HEIGHT;
const uint kHierarchyLevels = 11u;
const uint kMacroGeometryInitLevel = 11u;
const uint kLocalAoInitLevel = 12u;
const float kPi = 3.14159265358979323846;

uint levelOffset(uint level) {
    uint offset = 0u;
    uint width = kBaseWidth;
    uint height = kBaseHeight;
    for (uint current = 0u; current < level; ++current) {
        offset += width * height;
        width = max(width >> 1u, 1u);
        height = max(height >> 1u, 1u);
    }
    return offset;
}

#if VOXEL_SCALE_LAB
vec2 octahedralEncode(vec3 normal) {
    normal /= abs(normal.x) + abs(normal.y) + abs(normal.z);
    vec2 encoded = normal.xy;
    if (normal.z < 0.0) {
        vec2 signs = mix(vec2(-1.0), vec2(1.0),
                         greaterThanEqual(encoded, vec2(0.0)));
        encoded = (1.0 - abs(encoded.yx)) * signs;
    }
    return clamp(encoded, -1.0, 1.0);
}

uint hierarchyNodeCount() {
    return levelOffset(kHierarchyLevels);
}

void initializeMacroNode(uint linear) {
    if (linear >= hierarchyNodeCount()) {
        return;
    }
    if (linear == 0u) {
        geodesicMacroNodes[0] = uvec4(0u);
    }
    uint remaining = linear;
    uint level = 0u;
    uint width = kBaseWidth;
    uint height = kBaseHeight;
    for (; level + 1u < kHierarchyLevels; ++level) {
        uint levelCount = width * height;
        if (remaining < levelCount) {
            break;
        }
        remaining -= levelCount;
        width = max(width >> 1u, 1u);
        height = max(height >> 1u, 1u);
    }
    uint x = remaining % width;
    uint y = remaining / width;
    float longitude = ((float(x) + 0.5) / float(width) - 0.5) *
                      (2.0 * kPi);
    float latitude = (0.5 - (float(y) + 0.5) / float(height)) * kPi;
    vec3 axis = vec3(cos(latitude) * cos(longitude), sin(latitude),
                     cos(latitude) * sin(longitude));
    // Great-circle distance is bounded by a meridian leg plus a parallel leg.
    // Include one base-cell halo because leaf envelopes rasterize ownership
    // expansion into adjacent cells.
    float angularRadius = min(kPi,
        0.5 * kPi / float(height) + kPi / float(width) +
        kPi / float(kBaseHeight) + 2.0 * kPi / float(kBaseWidth));
    geodesicMacroNodes[1u + linear] = uvec4(
        0u, packSnorm2x16(octahedralEncode(axis)),
        floatBitsToUint(angularRadius), 0xffffffffu);
}
#endif

#if VOXEL_SCALE_LAB
float localHorizonSample(uint neighborHeight, uint surfaceLevel,
                         float horizontalRunLayers) {
    float rise = float(neighborHeight > surfaceLevel
        ? neighborHeight - surfaceLevel : 0u);
    float run = max(horizontalRunLayers, 0.25);
    return rise > 0.0 ? rise * inversesqrt(rise * rise + run * run) : 0.0;
}

void initializeLocalAo(uint tileIndex) {
    if (tileIndex >= frame.surfaceTileCount) {
        return;
    }
    GeodesicTile tile = geodesicTiles[tileIndex];
    uint count = clamp(geodesicTileNeighborCount(tile), 5u, 6u);
    uvec4 state = geodesicColumnStates[tileIndex];
    float layerHeight = geodesicTileRadialDepth(tile) /
                        float(geodesicTileLayerCount(tile));
    float horizontalRunLayers = geodesicTileSurfaceWidth(tile) /
                                max(layerHeight, 1e-7);
    float horizon[6];
    float horizonSum = 0.0;
    for (uint slot = 0u; slot < count; ++slot) {
        horizon[slot] = localHorizonSample(
            geodesicColumnStates[geodesicTileNeighbor(tile, slot)].y,
            state.y, horizontalRunLayers);
        horizonSum += horizon[slot];
    }
    float wedgeSum = 0.0;
    for (uint slot = 0u; slot < count; ++slot) {
        wedgeSum += sqrt(horizon[slot] * horizon[(slot + 1u) % count]);
    }
    float raw = 0.62 * (horizonSum / float(count)) +
                0.38 * (wedgeSum / float(count));
    uint quantized = uint(round(clamp(smoothstep(0.03, 0.85, raw),
                                      0.0, 1.0) * 255.0));
    geodesicColumnStates[tileIndex].z =
        (state.z & ~0xff00u) | (quantized << 8u);
}
#endif

float longitudeSpanAtLatitude(float centerLatitude, float latitude,
                              float angularRadius) {
    float denominator = cos(centerLatitude) * cos(latitude);
    if (denominator <= 1e-12) {
        return kPi;
    }
    float cosineSpan = (cos(angularRadius) -
                        sin(centerLatitude) * sin(latitude)) / denominator;
    if (cosineSpan <= -1.0) {
        return kPi;
    }
    if (cosineSpan >= 1.0) {
        return 0.0;
    }
    return acos(cosineSpan);
}

void rasterizeLeafEnvelope(uint tileIndex) {
    if (tileIndex >= frame.surfaceTileCount) {
        return;
    }
    GeodesicTile tile = geodesicTiles[tileIndex];
    uvec4 state = geodesicColumnStates[tileIndex];
    if (state.y == 0u) {
        return;
    }

    float depth = geodesicTileRadialDepth(tile);
    float layerThickness = depth / float(geodesicTileLayerCount(tile));
    float outerPlane = 1.0 - depth + float(state.y) * layerThickness +
                       layerThickness * 2e-5;
    uint minimumOneRingHeight = state.y;
    for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
        minimumOneRingHeight = min(
            minimumOneRingHeight,
            geodesicColumnStates[geodesicTileNeighbor(tile, slot)].y);
    }
    float minimumRadius = max(1.0 - depth,
        1.0 - depth + float(minimumOneRingHeight) * layerThickness -
            layerThickness * 1.001);
    uint minimumRadiusBits = max(floatBitsToUint(minimumRadius) - 2u,
                                 floatBitsToUint(1.0 - depth));
    // center.w is 0.62 times the farthest one-ring angle. Every exact dual
    // cell lies inside that angular cap (established by topology generation).
    // Include the exact expanded-prism tangent overlap used by leaf
    // intersection. Without it, a boundary wall can extend a few ULP beyond
    // the unexpanded dual-cell cap.
    float angularRadius = tile.center.w / 0.62 + 4e-6;
    // One radial layer covers any ownership-expanded side fragment whose cap
    // belongs to the adjacent column. Clamping to the topology's exact global
    // prism bound keeps the value finite and no less conservative.
    float outerRadius = min(frame.planetOuterScale,
        (outerPlane + layerThickness) / max(cos(angularRadius), 1e-7));
    uint radiusBits = min(floatBitsToUint(outerRadius) + 2u,
                          floatBitsToUint(frame.planetOuterScale));

    vec3 center = normalize(tile.center.xyz);
    float centerLatitude = asin(clamp(center.y, -1.0, 1.0));
    float centerLongitude = atan(center.z, center.x);
    float minimumLatitude = max(centerLatitude - angularRadius, -0.5 * kPi);
    float maximumLatitude = min(centerLatitude + angularRadius, 0.5 * kPi);
    int firstY = max(int(floor((0.5 - maximumLatitude / kPi) *
                               float(kBaseHeight))) - 1, 0);
    int lastY = min(int(floor((0.5 - minimumLatitude / kPi) *
                              float(kBaseHeight))) + 1,
                    int(kBaseHeight) - 1);
    int centerX = int(floor((centerLongitude / (2.0 * kPi) + 0.5) *
                            float(kBaseWidth)));

    for (int y = firstY; y <= lastY; ++y) {
        float rowNorth = (0.5 - float(y) / float(kBaseHeight)) * kPi;
        float rowSouth = (0.5 - float(y + 1) / float(kBaseHeight)) * kPi;
        float closestLatitude = clamp(centerLatitude, rowSouth, rowNorth);
        float span = max(longitudeSpanAtLatitude(centerLatitude, rowNorth,
                                                 angularRadius),
                         longitudeSpanAtLatitude(centerLatitude, rowSouth,
                                                 angularRadius));
        span = max(span, longitudeSpanAtLatitude(centerLatitude,
                                                 closestLatitude,
                                                 angularRadius));
        if (abs(centerLatitude) + angularRadius >= 0.5 * kPi) {
            span = kPi;
        }
        int halfCells = min(int(kBaseWidth / 2u),
            int(ceil(span * float(kBaseWidth) / (2.0 * kPi))) + 1);
        for (int xOffset = -halfCells; xOffset <= halfCells; ++xOffset) {
            int wrappedX = (centerX + xOffset) % int(kBaseWidth);
            if (wrappedX < 0) {
                wrappedX += int(kBaseWidth);
            }
            atomicMax(geodesicFarField[1u + uint(wrappedX) +
                                        kBaseWidth * uint(y)], radiusBits);
#if VOXEL_SCALE_LAB
            uint macroIndex = 1u + uint(wrappedX) +
                              kBaseWidth * uint(y);
            atomicMax(geodesicMacroNodes[macroIndex].x, radiusBits);
            atomicMin(geodesicMacroNodes[macroIndex].w, minimumRadiusBits);
#endif
        }
    }
}

void reduceLevel(uint level, uint linear) {
    uint width = max(kBaseWidth >> level, 1u);
    uint height = max(kBaseHeight >> level, 1u);
    if (linear >= width * height) {
        return;
    }
    uint childWidth = max(kBaseWidth >> (level - 1u), 1u);
    uint childHeight = max(kBaseHeight >> (level - 1u), 1u);
    uint x = linear % width;
    uint y = linear / width;
    uint childOffset = 1u + levelOffset(level - 1u);
    uint maximumRadius = 0u;
    uint minimumRadius = 0xffffffffu;
    for (uint childY = y * 2u;
         childY < min(y * 2u + 2u, childHeight); ++childY) {
        for (uint childX = x * 2u;
             childX < min(x * 2u + 2u, childWidth); ++childX) {
            maximumRadius = max(maximumRadius,
                geodesicFarField[childOffset + childX + childWidth * childY]);
#if VOXEL_SCALE_LAB
            uvec4 child = geodesicMacroNodes[
                childOffset + childX + childWidth * childY];
            minimumRadius = min(minimumRadius, child.w);
#endif
        }
    }
    geodesicFarField[1u + levelOffset(level) + linear] = maximumRadius;
#if VOXEL_SCALE_LAB
    uint macroIndex = 1u + levelOffset(level) + linear;
    geodesicMacroNodes[macroIndex].x = maximumRadius;
    geodesicMacroNodes[macroIndex].w = minimumRadius;
#endif
}

void main() {
    uint linear = gl_GlobalInvocationID.x;
    uint level = frame.maxMarchSteps;
#if VOXEL_SCALE_LAB
    if (level == kLocalAoInitLevel) {
        initializeLocalAo(linear);
    } else if (level == kMacroGeometryInitLevel) {
        initializeMacroNode(linear);
    } else
#endif
    if (level == 0u) {
        rasterizeLeafEnvelope(linear);
    } else if (level < kHierarchyLevels) {
        reduceLevel(level, linear);
    }
}
