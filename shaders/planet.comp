uint flattenCell(uvec3 cell, uint resolution) {
    return cell.x + resolution * (cell.y + resolution * cell.z);
}

uint flattenMacrocell(uvec3 cell, uint resolution) {
    uint macroResolution = resolution / kMacrocellSize;
    uvec3 macrocell = cell / kMacrocellSize;
    return macrocell.x + macroResolution * (macrocell.y + macroResolution * macrocell.z);
}

bool insideGrid(ivec3 cell, int resolution) {
    return all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, ivec3(resolution)));
}

float macroSphereDistance(vec3 point) {
    return length(point) - frame.planetRadius;
}

float axisExitDistance(float position, float direction, float minimumValue, float maximumValue) {
    if (abs(direction) < 1e-8) {
        return 1e30;
    }
    float boundary = direction > 0.0 ? maximumValue : minimumValue;
    return max((boundary - position) / direction, 0.0);
}

struct DdaHit {
    bool hit;
    float distance;
    vec3 normal;
    uint material;
    uint steps;
};

DdaHit traceVoxelVolume(vec3 origin, vec3 direction) {
    DdaHit result = DdaHit(false, 0.0, vec3(0.0), 0, 0);
    float halfExtent = frame.planetRadius * 1.15;
    vec3 gridMinimum = vec3(-halfExtent);
    float cellSize = (2.0 * halfExtent) / float(frame.voxelResolution);
    float localTravel = 0.0;
    vec3 entryNormal = normalize(origin);

    for (uint iteration = 0; iteration < kMaximumDdaSteps; ++iteration) {
        result.steps = iteration + 1;
        vec3 position = origin + direction * localTravel;
        ivec3 cell = ivec3(floor((position - gridMinimum) / cellSize));
        if (!insideGrid(cell, int(frame.voxelResolution))) {
            return result;
        }

        uvec3 unsignedCell = uvec3(cell);
        uint macroIndex = flattenMacrocell(unsignedCell, frame.voxelResolution);
        if (macrocellOccupancy[macroIndex] == 0) {
            uvec3 macrocell = unsignedCell / kMacrocellSize;
            vec3 macroMinimum = gridMinimum + vec3(macrocell * kMacrocellSize) * cellSize;
            vec3 macroMaximum = macroMinimum + vec3(float(kMacrocellSize) * cellSize);
            vec3 exitDistances = vec3(
                axisExitDistance(position.x, direction.x, macroMinimum.x, macroMaximum.x),
                axisExitDistance(position.y, direction.y, macroMinimum.y, macroMaximum.y),
                axisExitDistance(position.z, direction.z, macroMinimum.z, macroMaximum.z));
            float skipDistance = min(exitDistances.x, min(exitDistances.y, exitDistances.z));
            localTravel += skipDistance + cellSize * 0.001;
            continue;
        }

        uint material = cells[flattenCell(unsignedCell, frame.voxelResolution)] & 0xffu;
        if (material != 0) {
            result.hit = true;
            result.distance = localTravel;
            result.normal = entryNormal;
            result.material = material;
            return result;
        }

        vec3 cellMinimum = gridMinimum + vec3(cell) * cellSize;
        vec3 cellMaximum = cellMinimum + vec3(cellSize);
        vec3 exitDistances = vec3(
            axisExitDistance(position.x, direction.x, cellMinimum.x, cellMaximum.x),
            axisExitDistance(position.y, direction.y, cellMinimum.y, cellMaximum.y),
            axisExitDistance(position.z, direction.z, cellMinimum.z, cellMaximum.z));

        int axis = exitDistances.x <= exitDistances.y && exitDistances.x <= exitDistances.z ? 0
                 : exitDistances.y <= exitDistances.z ? 1 : 2;
        entryNormal = vec3(0.0);
        entryNormal[axis] = -sign(direction[axis]);
        localTravel += exitDistances[axis] + cellSize * 0.001;
    }
    return result;
}

vec3 materialColor(uint material) {
    if (material == 2u) {
        return vec3(0.66, 0.46, 0.22);
    }
    if (material == 3u) {
        return vec3(0.025, 0.22, 0.48);
    }
    if (material == 4u) {
        return vec3(0.82, 0.91, 0.96);
    }
    if (material == 5u) {
        return vec3(0.24, 0.25, 0.27);
    }
    return vec3(0.10, 0.31, 0.16);
}

vec3 shadeVoxel(uint material, vec3 position, vec3 normal, vec3 rayDirection, uint ddaSteps) {
#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
    float sunAzimuth = frame.terrainContinentScale;
    float sunElevation = frame.terrainContinentStrength;
    float sunElevationCosine = cos(sunElevation);
    vec3 lightDirection = normalize(vec3(
        sunElevationCosine * sin(sunAzimuth), sin(sunElevation),
        sunElevationCosine * cos(sunAzimuth)));
#else
    const vec3 lightDirection = normalize(vec3(-0.45, 0.75, 0.35));
#endif
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float ambient = 0.16 + 0.18 * max(normal.y, 0.0);
    float rim = pow(1.0 - max(dot(normal, -rayDirection), 0.0), 3.0);
    float traversalHeat = min(float(ddaSteps) / 96.0, 1.0);
    vec3 base = materialColor(material);
    return base * (ambient + diffuse * 0.82) +
           rim * vec3(0.08, 0.44, 0.70) +
           traversalHeat * vec3(0.025, 0.0, 0.035);
}

float ddaWorkHeatmapCue(uint leafEvents) {
    float normalized = clamp(float(leafEvents) / 256.0, 0.0, 1.0);
    return smoothstep(0.08, 0.65, normalized);
}

float localGeodesicAoStrength() {
    return float((frame.maxMarchSteps >> 16u) & 0xffu) * (0.30 / 255.0);
}

uint tileNeighbor(GeodesicTile tile, uint slot) {
    return geodesicTileNeighbor(tile, slot);
}

float localGeodesicHorizonSample(uint neighborHeight, uint surfaceLevel,
                                 float horizontalRunLayers) {
    float rise = float(neighborHeight > surfaceLevel
                           ? neighborHeight - surfaceLevel : 0u);
    float run = max(horizontalRunLayers, 0.25);
    return rise > 0.0 ? rise * inversesqrt(rise * rise + run * run) : 0.0;
}

float localGeodesicAoCue(uint tileIndex, uint hitLayer,
                          uint sideNeighborTag) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    uint count = clamp(geodesicTileNeighborCount(tile), 5u, 6u);
    bool sideHit = sideNeighborTag != 0u;
#if VOXEL_SCALE_LAB
    // The scale lab precomputes the camera-invariant cap cue once from this
    // exact one-ring. Side/corner hits retain the full layer-aware evaluation.
    if (!sideHit) {
        return float((geodesicColumnStates[tileIndex].z >> 8u) & 0xffu) /
               255.0;
    }
#endif
    uint sideNeighborSlot = 0xffffffffu;
    uint sideNeighbor = sideHit ? sideNeighborTag - 1u : 0xffffffffu;
    float layerHeight = geodesicTileRadialDepth(tile) /
                        float(geodesicTileLayerCount(tile));
    float horizontalRunLayers = geodesicTileSurfaceWidth(tile) /
                                max(layerHeight, 1e-7);
    float horizon[6];
    float weights[6];
    uint columnHeight = geodesicColumnStates[tileIndex].y;
    uint surfaceLevel = min(hitLayer + 1u, columnHeight);

    if (sideHit) {
        for (uint slot = 0u; slot < count; ++slot) {
            if (tileNeighbor(tile, slot) == sideNeighbor) {
                sideNeighborSlot = slot;
                break;
            }
        }
        sideHit = sideNeighborSlot < count;
    }

    float horizonSum = 0.0;
    float weightSum = 0.0;
    for (uint slot = 0u; slot < count; ++slot) {
        float weight = 1.0;
        if (sideHit) {
            uint forward = (slot + count - sideNeighborSlot) % count;
            uint ringDistance = min(forward, count - forward);
            weight = ringDistance == 0u ? 0.0
                   : ringDistance == 1u ? 1.0
                   : ringDistance == 2u ? 0.35 : 0.15;
        }
        uint neighbor = tileNeighbor(tile, slot);
        horizon[slot] = localGeodesicHorizonSample(
            geodesicColumnStates[neighbor].y, surfaceLevel,
            horizontalRunLayers);
        weights[slot] = weight;
        horizonSum += horizon[slot] * weight;
        weightSum += weight;
    }

    float horizonMean = weightSum > 0.0 ? horizonSum / weightSum : 0.0;
    float wedgeSum = 0.0;
    float wedgeWeightSum = 0.0;
    for (uint slot = 0u; slot < count; ++slot) {
        uint next = (slot + 1u) % count;
        float weight = min(weights[slot], weights[next]);
        wedgeSum += sqrt(horizon[slot] * horizon[next]) * weight;
        wedgeWeightSum += weight;
    }
    float wedgeMean = wedgeWeightSum > 0.0
        ? wedgeSum / wedgeWeightSum : 0.0;
    float raw = 0.62 * horizonMean + 0.38 * wedgeMean;
    if (sideHit) {
        // Only local corner enclosure darkens a wall. Long exposed cliffs do
        // not inherit a full cap-strength term and therefore cannot stripe.
        raw = min(raw * 0.65, 0.75);
    }
    return smoothstep(0.03, 0.85, raw);
}

float localGeodesicSunOcclusion(uint tileIndex, uint hitLayer,
                                vec3 sunDirection) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    vec3 radial = normalize(tile.center.xyz);
    float sunRadial = dot(sunDirection, radial);
    vec3 sunTangent = sunDirection - radial * sunRadial;
    float tangentLength = length(sunTangent);
    if (!(sunRadial > 0.0) || !(tangentLength > 1e-5)) {
        return 0.0;
    }
    sunTangent /= tangentLength;
    float sunSlope = sunRadial / tangentLength;
    uint count = clamp(geodesicTileNeighborCount(tile), 5u, 6u);
    float layerHeight = geodesicTileRadialDepth(tile) /
                        float(geodesicTileLayerCount(tile));
    float runLayers = geodesicTileSurfaceWidth(tile) /
                      max(layerHeight, 1e-7);
    uint surfaceLevel = min(hitLayer + 1u,
                            geodesicColumnStates[tileIndex].y);
    float occlusion = 0.0;
    for (uint slot = 0u; slot < count; ++slot) {
        uint neighbor = tileNeighbor(tile, slot);
        uint neighborHeight = geodesicColumnStates[neighbor].y;
        float rise = float(neighborHeight > surfaceLevel
                               ? neighborHeight - surfaceLevel : 0u);
        if (!(rise > 0.0)) {
            continue;
        }
        vec3 neighborRadial = normalize(geodesicTiles[neighbor].center.xyz);
        vec3 neighborTangent = neighborRadial - radial *
            dot(neighborRadial, radial);
        float neighborLength = length(neighborTangent);
        if (!(neighborLength > 1e-7)) {
            continue;
        }
        float alignment = dot(neighborTangent / neighborLength, sunTangent);
        float directionalWeight = smoothstep(0.52, 0.92, alignment);
        float obstacleSlope = rise / max(runLayers, 0.25);
        // A restrained transition covers uncertainty between the five/six
        // one-ring directions. This is a one-cell contact horizon, never a
        // long shadow ray, and cannot affect traversal or silhouettes.
        float blocked = smoothstep(sunSlope - 0.16,
                                   sunSlope + 0.16, obstacleSlope);
        occlusion = max(occlusion, blocked * directionalWeight);
    }
    return clamp(occlusion, 0.0, 1.0);
}

#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
vec3 unpackProductionLightingRgb(uint packed) {
    return vec3(float(packed & 0xffu),
                float((packed >> 8u) & 0xffu),
                float((packed >> 16u) & 0xffu)) * (1.0 / 255.0);
}

vec3 productionToneMap(vec3 hdr, float exposure) {
    hdr = max(hdr * exposure, vec3(0.0));
    vec3 mapped = (hdr * (2.51 * hdr + 0.03)) /
        (hdr * (2.43 * hdr + 0.59) + 0.14);
    return sqrt(clamp(mapped, vec3(0.0), vec3(1.0)));
}

vec3 productionSunDirection() {
    float azimuth = frame.terrainContinentScale;
    float elevation = frame.terrainContinentStrength;
    float elevationCosine = cos(elevation);
    return normalize(vec3(elevationCosine * sin(azimuth), sin(elevation),
                          elevationCosine * cos(azimuth)));
}

float productionMaterialRoughness(uint material, float globalRoughness) {
    float roughness = clamp(globalRoughness, 0.12, 1.0);
    if (material == 3u) {
        return clamp(roughness * 0.24, 0.08, 0.28);
    }
    if (material == 4u) {
        return clamp(roughness * 0.76, 0.35, 0.82);
    }
    if (material == 5u) {
        return clamp(roughness * 1.15, 0.55, 1.0);
    }
    return clamp(roughness, 0.35, 1.0);
}
#endif

struct TerrainMicroField {
    float depth01;
    vec3 directionGradient;
};

TerrainMicroField evaluateTerrainMicroField(vec3 direction) {
    // Three deterministic analytic octaves. The weighted product is bounded
    // to [-1,1], and its derivative is analytic, avoiding finite-difference
    // noise and stochastic samples in the close-up normal.
    const vec3 basis0 = vec3(0.5773502692);
    const vec3 basis1 = vec3(0.7071067812, -0.7071067812, 0.0);
    const vec3 basis2 = vec3(0.4082482905, 0.4082482905, -0.8164965809);
    float value = 0.0;
    vec3 gradient = vec3(0.0);
    float amplitude = 0.5;
    float frequency = 512.0;
    vec3 phase = vec3(0.37, 1.11, 2.03);
    const float amplitudeSum = 0.875;
    for (uint octave = 0u; octave < 3u; ++octave) {
        float a = frequency * dot(direction, basis0) + phase.x;
        float b = frequency * dot(direction, basis1) + phase.y;
        float c = frequency * dot(direction, basis2) + phase.z;
        vec3 sine = sin(vec3(a, b, c));
        vec3 cosine = cos(vec3(a, b, c));
        value += amplitude * sine.x * sine.y * sine.z;
        gradient += amplitude * frequency * (
            cosine.x * sine.y * sine.z * basis0 +
            sine.x * cosine.y * sine.z * basis1 +
            sine.x * sine.y * cosine.z * basis2);
        amplitude *= 0.5;
        frequency *= 2.0;
        phase += vec3(1.73, 2.41, 0.89);
    }
    TerrainMicroField result;
    result.depth01 = 0.5 + 0.5 * clamp(value / amplitudeSum, -1.0, 1.0);
    result.directionGradient = 0.5 * gradient / amplitudeSum;
    return result;
}

float terrainMicroSdfStrength() {
    return float((frame.maxMarchSteps >> 29u) & 0x7u) * 0.025;
}

bool refineTerrainMicroSdf(GeodesicTile tile, uvec4 columnState,
                           uint hitLayer, uint material,
                           vec3 cameraPosition, vec3 rayDirection,
                           float baseDistance, out vec3 refinedNormal,
                           out float depth01, out float activation) {
    refinedNormal = normalize(tile.center.xyz);
    depth01 = 0.0;
    activation = 0.0;
    if (material == 3u || columnState.w != 0u ||
        hitLayer + 1u != columnState.y) {
        return false;
    }
    vec3 basePosition = cameraPosition + rayDirection * baseDistance;
    float baseRadius = length(basePosition);
    if (!(baseRadius > 0.0) || isnan(baseRadius) || isinf(baseRadius)) {
        microSdfStatus |= 1u;
        return false;
    }
    vec3 radial = basePosition / baseRadius;
    float incidence = dot(refinedNormal, -rayDirection);
    if (!(incidence > 0.35) || isnan(incidence) || isinf(incidence)) {
        return false;
    }
    float pixelScale = (float(frame.resolution.y) * 0.5) /
                       max(baseDistance, frame.hitEpsilon);
    float projectedCellPixels = geodesicTileSurfaceWidth(tile) *
        frame.planetRadius * pixelScale;
    float footprintFade = smoothstep(5.0, 14.0, projectedCellPixels);
    float centerRatio = length(radial - refinedNormal) /
                        max(tile.center.w, 1e-7);
    // The relief support is well inside the dual cell. It reaches zero before
    // every ownership plane, so it cannot bridge a pentagon/hexagon seam.
    float interiorFade = 1.0 - smoothstep(0.45, 0.78, centerRatio);
    float incidenceFade = smoothstep(0.35, 0.65, incidence);
    activation = footprintFade * interiorFade * incidenceFade;
    float strength = terrainMicroSdfStrength();
    if (!(activation > 0.0) || !(strength > 0.0)) {
        return false;
    }
    float tileDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerHeight = tileDepth / float(geodesicTileLayerCount(tile));
    float maximumDepth = layerHeight * strength * activation;
    float rayOffset = 0.0;
    TerrainMicroField field;
    // Two fixed-point evaluations refine the bounded inward height surface.
    // The accepted macro hit and reported depth remain unchanged.
    for (uint iteration = 0u; iteration < 2u; ++iteration) {
        vec3 samplePosition = basePosition + rayDirection * rayOffset;
        float sampleRadius = length(samplePosition);
        if (!(sampleRadius > 0.0) || isnan(sampleRadius) || isinf(sampleRadius)) {
            microSdfStatus |= 1u;
            return false;
        }
        field = evaluateTerrainMicroField(samplePosition / sampleRadius);
        float nextOffset = maximumDepth * field.depth01 / incidence;
        if (isnan(nextOffset) || isinf(nextOffset)) {
            microSdfStatus |= 1u;
            return false;
        }
        rayOffset = clamp(nextOffset, 0.0, maximumDepth / incidence);
    }
    vec3 refinedPosition = basePosition + rayDirection * rayOffset;
    float refinedRadius = length(refinedPosition);
    if (!(refinedRadius > 0.0) || isnan(refinedRadius) || isinf(refinedRadius)) {
        microSdfStatus |= 1u;
        return false;
    }
    vec3 refinedDirection = refinedPosition / refinedRadius;
    float refinedCenterRatio = length(refinedDirection - refinedNormal) /
                               max(tile.center.w, 1e-7);
    if (refinedCenterRatio >= 0.80) {
        microSdfStatus |= 2u;
        return false;
    }
    field = evaluateTerrainMicroField(refinedDirection);
    vec3 tangentGradient = field.directionGradient - refinedDirection *
        dot(field.directionGradient, refinedDirection);
    vec3 depthGradient = tangentGradient * (maximumDepth / refinedRadius);
    vec3 candidateNormal = refinedNormal + depthGradient;
    float normalLengthSquared = dot(candidateNormal, candidateNormal);
    if (!(normalLengthSquared > 0.0) || isnan(normalLengthSquared) ||
        isinf(normalLengthSquared)) {
        microSdfStatus |= 1u;
        return false;
    }
    if (incidence * rayOffset > maximumDepth +
        max(maximumDepth * 2e-6, 1e-12)) {
        microSdfStatus |= 4u;
        return false;
    }
    refinedNormal = candidateNormal * inversesqrt(normalLengthSquared);
    depth01 = field.depth01;
    return true;
}

#if VOXEL_ADAPTIVE_SDF_LAB
const uint kAdaptiveSdfMaximumLevels = 9u;
const uint kAdaptiveSdfRootIterations = 7u;

struct AdaptivePlanetField {
    float depthLayerFraction;
    vec3 directionGradient;
    float evaluatedAmplitude;
};

uint adaptiveSdfHash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float adaptiveSdfPhase(uint seed, uint lane) {
    uint bits = adaptiveSdfHash(seed ^ (0x9e3779b9u * (lane + 1u)));
    return float(bits & 0x00ffffffu) *
        (6.2831853071795864769 / 16777216.0);
}

float adaptiveSdfTargetPixels() {
    return max(float((frame.visualizationMode >> 13u) & 0xffu) * 0.125,
               0.125);
}

float adaptiveSdfLayerFraction() {
    return float((frame.visualizationMode >> 23u) & 0xffu) *
        (0.20 / 255.0);
}

uint adaptiveSdfMaximumLevels() {
    return min((frame.visualizationMode >> 9u) & 0xfu,
               kAdaptiveSdfMaximumLevels);
}

AdaptivePlanetField evaluateAdaptivePlanetField(vec3 direction,
                                                 float continuousLevel,
                                                 float layerFraction) {
    const vec3 basis0 = vec3(0.5773502692);
    const vec3 basis1 = vec3(0.7071067812, -0.7071067812, 0.0);
    const vec3 basis2 = vec3(0.4082482905, 0.4082482905, -0.8164965809);
    AdaptivePlanetField result = AdaptivePlanetField(0.0, vec3(0.0), 0.0);
    float frequency = 384.0;
    float amplitude = layerFraction * 0.5;
    for (uint octave = 0u; octave < kAdaptiveSdfMaximumLevels; ++octave) {
        float weight = smoothstep(0.0, 1.0,
            continuousLevel - float(octave));
        if (!(weight > 0.0)) {
            frequency *= 2.0;
            amplitude *= 0.5;
            continue;
        }
        vec3 angle = vec3(
            frequency * dot(direction, basis0) +
                adaptiveSdfPhase(frame.terrainSeed, octave * 3u + 0u),
            frequency * dot(direction, basis1) +
                adaptiveSdfPhase(frame.terrainSeed, octave * 3u + 1u),
            frequency * dot(direction, basis2) +
                adaptiveSdfPhase(frame.terrainSeed, octave * 3u + 2u));
        vec3 sine = sin(angle);
        vec3 cosine = cos(angle);
        float weightedAmplitude = amplitude * weight;
        float product = sine.x * sine.y * sine.z;
        result.depthLayerFraction +=
            weightedAmplitude * (0.5 + 0.5 * product);
        result.evaluatedAmplitude += weightedAmplitude;
        result.directionGradient += weightedAmplitude * 0.5 * frequency *
            (cosine.x * sine.y * sine.z * basis0 +
             sine.x * cosine.y * sine.z * basis1 +
             sine.x * sine.y * cosine.z * basis2);
        frequency *= 2.0;
        amplitude *= 0.5;
    }
    return result;
}

float requestedAdaptiveSdfLevel(GeodesicTile candidate,
                                vec3 cameraPosition,
                                float targetPixels,
                                uint maximumLevels) {
    float surfaceWidthWorld = geodesicTileSurfaceWidth(candidate) *
                              frame.planetRadius;
    float centerDistance = length(cameraPosition -
        candidate.center.xyz * frame.planetRadius);
    if (frame.cameraMode == 1u && centerDistance < surfaceWidthWorld * 4.0) {
        return float(maximumLevels);
    }
    float projectedPixels = surfaceWidthWorld *
        (float(frame.resolution.y) * 0.5) /
        max(centerDistance, frame.hitEpsilon);
    return clamp(log2(max(projectedPixels / targetPixels, 1.0)),
                 0.0, float(maximumLevels));
}

bool refineAdaptivePlanetSdf(uint tileIndex, GeodesicTile tile,
                             uvec4 columnState,
                             uint hitLayer, uint material,
                             vec3 cameraPosition, vec3 rayDirection,
                             float baseDistance, out vec3 refinedNormal,
                             out float depthLayerFraction,
                             out float activation, out float continuousLevel,
                             out float refinedDistance) {
    refinedNormal = normalize(tile.center.xyz);
    depthLayerFraction = 0.0;
    activation = 0.0;
    continuousLevel = 0.0;
    refinedDistance = baseDistance;
    if (material == 3u || columnState.w != 0u ||
        hitLayer + 1u != columnState.y) {
        return false;
    }
    vec3 basePosition = cameraPosition + rayDirection * baseDistance;
    float baseRadius = length(basePosition);
    if (!(baseRadius > 0.0) || isnan(baseRadius) || isinf(baseRadius)) {
        adaptiveSdfStatus |= 1u;
        return false;
    }
    float incidence = dot(refinedNormal, -rayDirection);
    if (!(incidence > 0.35) || isnan(incidence) || isinf(incidence)) {
        return false;
    }
    float targetPixels = adaptiveSdfTargetPixels();
    uint maximumLevels = adaptiveSdfMaximumLevels();
    continuousLevel = requestedAdaptiveSdfLevel(
        tile, cameraPosition, targetPixels, maximumLevels);
    // Two-to-one balance: a tile may be at most one subdivision finer than
    // the coarsest raw request in its exact topology ring. Coarser neighbors
    // never get replaced by a box surface; they evaluate the same continuous
    // field with fewer band-limited octaves.
    float coarsestNeighborLevel = float(maximumLevels);
    for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
        GeodesicTile adjacent = geodesicTiles[tileNeighbor(tile, slot)];
        coarsestNeighborLevel = min(
            coarsestNeighborLevel,
            requestedAdaptiveSdfLevel(
                adjacent, cameraPosition, targetPixels, maximumLevels));
    }
    continuousLevel = min(continuousLevel, coarsestNeighborLevel + 1.0);
    float levelActivation = smoothstep(0.0, 1.0, continuousLevel);
    if (!(levelActivation > 0.0)) {
        return false;
    }
    vec3 radial = basePosition / baseRadius;
    float centerRatio = length(radial - refinedNormal) /
                        max(tile.center.w, 1e-7);
    // This is a topology guard, not a visual LOD. The continuous SDF reaches
    // exactly zero before the parent owner's side planes, so adjacent levels
    // cannot open a crack or move a hit into another macro voxel.
    float interiorFade = 1.0 - smoothstep(0.62, 0.78, centerRatio);
    float incidenceFade = smoothstep(0.35, 0.65, incidence);
    activation = levelActivation * interiorFade * incidenceFade;
    float layerFraction = adaptiveSdfLayerFraction();
    if (!(activation > 0.0) || !(layerFraction > 0.0)) {
        return false;
    }

    float tileDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerHeight = tileDepth / float(geodesicTileLayerCount(tile));
    float maximumDepth = layerHeight * layerFraction * activation;
    float lowOffset = 0.0;
    float highOffset = maximumDepth / incidence;
    AdaptivePlanetField field;
    for (uint iteration = 0u; iteration < kAdaptiveSdfRootIterations; ++iteration) {
        float candidateOffset = 0.5 * (lowOffset + highOffset);
        vec3 candidatePosition = basePosition + rayDirection * candidateOffset;
        float candidateRadius = length(candidatePosition);
        if (!(candidateRadius > 0.0) || isnan(candidateRadius) ||
            isinf(candidateRadius)) {
            adaptiveSdfStatus |= 1u;
            return false;
        }
        field = evaluateAdaptivePlanetField(
            candidatePosition / candidateRadius, continuousLevel, layerFraction);
        float implicitValue = dot(refinedNormal,
                                  candidatePosition - basePosition) +
                              layerHeight * activation *
                                  field.depthLayerFraction;
        if (isnan(implicitValue) || isinf(implicitValue)) {
            adaptiveSdfStatus |= 1u;
            return false;
        }
        if (implicitValue > 0.0) {
            lowOffset = candidateOffset;
        } else {
            highOffset = candidateOffset;
        }
    }
    adaptiveSdfRootSteps += kAdaptiveSdfRootIterations;
    float rayOffset = 0.5 * (lowOffset + highOffset);
    vec3 refinedPosition = basePosition + rayDirection * rayOffset;
    float refinedRadius = length(refinedPosition);
    if (!(refinedRadius > 0.0) || isnan(refinedRadius) || isinf(refinedRadius)) {
        adaptiveSdfStatus |= 1u;
        return false;
    }
    vec3 refinedDirection = refinedPosition / refinedRadius;
    float refinedCenterRatio = length(refinedDirection - refinedNormal) /
                               max(tile.center.w, 1e-7);
    if (refinedCenterRatio >= 0.80) {
        adaptiveSdfStatus |= 2u;
        return false;
    }
    field = evaluateAdaptivePlanetField(
        refinedDirection, continuousLevel, layerFraction);
    vec3 tangentGradient = field.directionGradient - refinedDirection *
        dot(field.directionGradient, refinedDirection);
    vec3 candidateNormal = refinedNormal +
        tangentGradient * (layerHeight * activation / refinedRadius);
    float normalLengthSquared = dot(candidateNormal, candidateNormal);
    if (!(normalLengthSquared > 0.0) || isnan(normalLengthSquared) ||
        isinf(normalLengthSquared)) {
        adaptiveSdfStatus |= 1u;
        return false;
    }
    refinedNormal = candidateNormal * inversesqrt(normalLengthSquared);
    depthLayerFraction = field.depthLayerFraction * activation;
    refinedDistance = baseDistance + rayOffset;
    adaptiveSdfLevel = uint(clamp(ceil(continuousLevel), 0.0, 32.0));
    return true;
}
#endif

uint refineSurfaceTile(uint tileIndex, vec3 direction) {
    for (uint iteration = 0u; iteration < 32u; ++iteration) {
#if VOXEL_SCALE_LAB
        if (frame.geodesicTraversalMode == 8u) {
            ++scaleAtlasRefinements;
        }
#endif
        GeodesicTile tile = geodesicTiles[tileIndex];
        float bestAlignment = dot(direction, tile.center.xyz);
        uint bestTile = tileIndex;
        for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
            uint candidate = tileNeighbor(tile, slot);
            float alignment = dot(direction, geodesicTiles[candidate].center.xyz);
            if (alignment > bestAlignment) {
                bestAlignment = alignment;
                bestTile = candidate;
            }
        }
        if (bestTile == tileIndex) {
            break;
        }
        tileIndex = bestTile;
    }
    return tileIndex;
}

uint lookupSurfaceTileSeed(vec3 direction) {
    float longitude = atan(direction.z, direction.x);
    float latitude = asin(clamp(direction.y, -1.0, 1.0));
    uint lookupX = min(uint((longitude / (2.0 * kPi) + 0.5) * float(kTileLookupWidth)),
                       kTileLookupWidth - 1u);
    uint lookupY = min(uint((0.5 - latitude / kPi) * float(kTileLookupHeight)),
                       kTileLookupHeight - 1u);
    return tileDirectionLookup[lookupX + kTileLookupWidth * lookupY];
}

uint findSurfaceTile(vec3 direction) {
    return refineSurfaceTile(lookupSurfaceTileSeed(direction), direction);
}

bool raySphereInterval(vec3 origin, vec3 direction, float radius,
                       out float nearDistance, out float farDistance) {
    float projection = dot(origin, direction);
    float discriminant = projection * projection - dot(origin, origin) + radius * radius;
    if (discriminant < 0.0) {
        return false;
    }
    float root = sqrt(discriminant);
    nearDistance = -projection - root;
    farDistance = -projection + root;
    if (farDistance < 0.0) {
        return false;
    }
    nearDistance = max(nearDistance, 0.0);
    return true;
}

#if VOXEL_FRACTAL_PLANET_SDF_LAB
const uint kFractalPlanetMaximumLevels = 10u;
const uint kFractalPlanetRootIterations = 8u;
const uint kFractalPlanetMarchSteps = 256u;
const float kFractalPlanetParentAngularWidth = 0.003;
const float kFractalPlanetBaseRadiusScale = 1.012;
const float kFractalPlanetSeaRadiusScale = 1.006;
const float kFractalPlanetOuterRadiusScale = 1.048;

struct FractalPlanetField {
    float terrainRadiusScale;
    float surfaceRadiusScale;
    float unresolvedMicroBound;
    vec3 directionGradient;
    bool water;
    bool finiteValue;
};

uint fractalPlanetHash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float fractalPlanetPhase(uint seed, uint lane) {
    uint bits = fractalPlanetHash(seed ^ (0x9e3779b9u * (lane + 1u)));
    return float(bits & 0x00ffffffu) *
        (6.2831853071795864769 / 16777216.0);
}

uint fractalPlanetMaximumLevels() {
    return min((frame.visualizationMode >> 9u) & 0xfu,
               kFractalPlanetMaximumLevels);
}

float fractalPlanetTargetPixels() {
    return max(float((frame.visualizationMode >> 13u) & 0xffu) * 0.125,
               0.125);
}

float fractalPlanetMicroRelief() {
    float packedFraction = float((frame.visualizationMode >> 23u) & 0xffu) *
        (0.20 / 255.0);
    return packedFraction * 0.09;
}

float fractalPlanetContinuousLevel(float cameraDistance) {
#if VOXEL_FRACTAL_VOXEL_SDF_LAB
    return float(fractalPlanetMaximumLevels()) +
        float((frame.visualizationMode >> 13u) & 0xffu) / 255.0;
#else
    uint maximumLevels = fractalPlanetMaximumLevels();
    float parentWidth = kFractalPlanetParentAngularWidth * frame.planetRadius;
    float projectedPixels = parentWidth *
        (float(frame.resolution.y) * 0.5) /
        max(cameraDistance, frame.hitEpsilon * 0.25);
    return clamp(log2(max(projectedPixels /
                          fractalPlanetTargetPixels(), 1.0)),
                 0.0, float(maximumLevels));
#endif
}

FractalPlanetField evaluateFractalPlanetField(
    vec3 direction, float continuousLevel, uint evaluationLevels) {
    const vec3 basis0 = vec3(0.5773502692);
    const vec3 basis1 = vec3(0.7071067812, -0.7071067812, 0.0);
    const vec3 basis2 = vec3(0.4082482905, 0.4082482905, -0.8164965809);
    FractalPlanetField result = FractalPlanetField(
        kFractalPlanetBaseRadiusScale, kFractalPlanetSeaRadiusScale,
        0.0, vec3(0.0), false, false);
    continuousLevel = clamp(continuousLevel, 0.0,
                            float(kFractalPlanetMaximumLevels));
    evaluationLevels = min(evaluationLevels, kFractalPlanetMaximumLevels);
    float macroFrequency[3] = float[3](1.7, 4.3, 11.0);
    float macroAmplitude[3] = float[3](0.010, 0.006, 0.003);
    uint macroLane[3] = uint[3](40u, 50u, 60u);
    for (uint band = 0u; band < 3u; ++band) {
        float frequency = macroFrequency[band];
        vec3 angle = vec3(
            frequency * dot(direction, basis0) +
                fractalPlanetPhase(frame.terrainSeed, macroLane[band] + 0u),
            frequency * dot(direction, basis1) +
                fractalPlanetPhase(frame.terrainSeed, macroLane[band] + 1u),
            frequency * dot(direction, basis2) +
                fractalPlanetPhase(frame.terrainSeed, macroLane[band] + 2u));
        vec3 s = sin(angle);
        vec3 c = cos(angle);
        float amplitude = macroAmplitude[band];
        result.terrainRadiusScale += amplitude * s.x * s.y * s.z;
        result.directionGradient += amplitude * frequency *
            (c.x * s.y * s.z * basis0 +
             s.x * c.y * s.z * basis1 +
             s.x * s.y * c.z * basis2);
    }
    float amplitude = fractalPlanetMicroRelief() * 0.5;
    float frequency = 48.0;
    for (uint octave = 0u; octave < kFractalPlanetMaximumLevels; ++octave) {
        float weight = smoothstep(0.0, 1.0,
            continuousLevel - float(octave));
        if (weight > 0.0 && octave < evaluationLevels) {
            vec3 angle = vec3(
                frequency * dot(direction, basis0) +
                    fractalPlanetPhase(frame.terrainSeed, octave * 3u + 0u),
                frequency * dot(direction, basis1) +
                    fractalPlanetPhase(frame.terrainSeed, octave * 3u + 1u),
                frequency * dot(direction, basis2) +
                    fractalPlanetPhase(frame.terrainSeed, octave * 3u + 2u));
            vec3 s = sin(angle);
            vec3 c = cos(angle);
            float weightedAmplitude = amplitude * weight;
            result.terrainRadiusScale += weightedAmplitude * s.x * s.y * s.z;
            result.directionGradient += weightedAmplitude * frequency *
                (c.x * s.y * s.z * basis0 +
                 s.x * c.y * s.z * basis1 +
                 s.x * s.y * c.z * basis2);
        } else if (weight > 0.0) {
            result.unresolvedMicroBound += amplitude * weight;
        }
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    result.water = result.terrainRadiusScale < kFractalPlanetSeaRadiusScale;
    result.surfaceRadiusScale = max(result.terrainRadiusScale,
                                    kFractalPlanetSeaRadiusScale);
    if (result.water) {
        result.directionGradient = vec3(0.0);
    }
    result.finiteValue =
        !isnan(result.terrainRadiusScale) && !isinf(result.terrainRadiusScale) &&
        !isnan(result.surfaceRadiusScale) && !isinf(result.surfaceRadiusScale) &&
        !isnan(result.unresolvedMicroBound) && !isinf(result.unresolvedMicroBound) &&
        !any(isnan(result.directionGradient)) &&
        !any(isinf(result.directionGradient));
    return result;
}

bool intersectEditedFractalOwner(vec3 cameraPosition, vec3 rayDirection,
                                 vec3 nominalDirection,
                                 out float editedDistance,
                                 out vec3 editedNormal,
                                 out uint editedMaterial) {
    uint owner = findSurfaceTile(nominalDirection);
    uvec4 state = geodesicColumnStates[owner];
    if (state.w == 0u) {
        return false;
    }
    if (state.y == 0u) {
        editedDistance = kFarDistance;
        editedNormal = nominalDirection;
        editedMaterial = 0u;
        return true;
    }
    GeodesicTile tile = geodesicTiles[owner];
    float totalDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerHeight = totalDepth / float(geodesicTileLayerCount(tile));
    float columnBase = frame.planetRadius - totalDepth;
    float outerHeight = columnBase + float(state.y) * layerHeight;
    float denominator = dot(tile.center.xyz, rayDirection);
    if (abs(denominator) < 1e-12) {
        return false;
    }
    float candidate = (outerHeight - dot(tile.center.xyz, cameraPosition)) /
                      denominator;
    if (!(candidate >= 0.0) || isnan(candidate) || isinf(candidate)) {
        return false;
    }
    vec3 candidateDirection = normalize(cameraPosition + rayDirection * candidate);
    if (findSurfaceTile(candidateDirection) != owner) {
        return false;
    }
    editedDistance = candidate;
    editedNormal = tile.center.xyz;
    editedMaterial = state.z & 0xffu;
    return true;
}

#if VOXEL_FRACTAL_VOXEL_SDF_LAB
const uint kFractalVoxelCellSteps = 512u;
const uint kFractalVoxelRootIterations = 8u;
const uint kFractalVoxelCellProbes = 12u;

struct FractalVoxelCell {
    float corner[8];
    vec3 minimum;
    float size;
    vec3 local;
    float value;
    vec3 gradient;
    float rangeMinimum;
    float rangeMaximum;
    float projectedPixels;
    float transition;
    uint level;
    bool finiteValue;
};

float fractalVoxelTransition() {
    return float((frame.visualizationMode >> 13u) & 0xffu) / 255.0;
}

float fractalVoxelTrilinear(float values[8], vec3 local) {
    local = clamp(local, vec3(0.0), vec3(1.0));
    float x00 = mix(values[0], values[1], local.x);
    float x10 = mix(values[2], values[3], local.x);
    float x01 = mix(values[4], values[5], local.x);
    float x11 = mix(values[6], values[7], local.x);
    return mix(mix(x00, x10, local.y),
               mix(x01, x11, local.y), local.z);
}

vec3 fractalVoxelTrilinearGradient(float values[8], vec3 local,
                                   float cellSize) {
    local = clamp(local, vec3(0.0), vec3(1.0));
    float dx0 = mix(values[1] - values[0], values[3] - values[2], local.y);
    float dx1 = mix(values[5] - values[4], values[7] - values[6], local.y);
    float dx = mix(dx0, dx1, local.z);
    float dy0 = mix(values[2] - values[0], values[3] - values[1], local.x);
    float dy1 = mix(values[6] - values[4], values[7] - values[5], local.x);
    float dy = mix(dy0, dy1, local.z);
    float dz0 = mix(values[4] - values[0], values[5] - values[1], local.x);
    float dz1 = mix(values[6] - values[2], values[7] - values[3], local.x);
    float dz = mix(dz0, dz1, local.y);
    return vec3(dx, dy, dz) / max(cellSize, 1e-12);
}

float fractalVoxelMacroRadius(vec3 direction) {
    float crossShape = direction.x * direction.y +
                       direction.y * direction.z +
                       direction.z * direction.x;
    float axialShape = direction.x * direction.x -
                       direction.z * direction.z;
    float cubicShape = direction.x * direction.y * direction.z;
    return kFractalPlanetBaseRadiusScale +
           0.008 * crossShape + 0.004 * axialShape +
           0.003 * cubicShape;
}

uint fractalVoxelVertexHash(ivec3 coordinate, uint level) {
    uint hash = fractalPlanetHash(uint(coordinate.x) ^ 0xa511e9b3u);
    hash = fractalPlanetHash(hash ^ uint(coordinate.y) ^ 0x63d83595u);
    hash = fractalPlanetHash(hash ^ uint(coordinate.z) ^ 0xb5297a4du);
    return fractalPlanetHash(hash ^ frame.terrainSeed ^
                             (level * 0x9e3779b9u));
}

float fractalVoxelSourceSigned(vec3 position, uint sampleLevel,
                               out bool finiteValue) {
    float radius = length(position);
    if (!(radius > 0.0) || isnan(radius) || isinf(radius)) {
        finiteValue = false;
        return kFarDistance;
    }
    sampleLevel = min(sampleLevel, kFractalPlanetMaximumLevels);
    float sampleSize = frame.planetRadius *
        kFractalPlanetParentAngularWidth / exp2(float(sampleLevel));
    ivec3 coordinate = ivec3(round(position / sampleSize));
    uint canonicalLevel = sampleLevel;
    while (canonicalLevel > 0u &&
           (coordinate.x & 1) == 0 &&
           (coordinate.y & 1) == 0 &&
           (coordinate.z & 1) == 0) {
        coordinate /= 2;
        --canonicalLevel;
    }
    uint bits = fractalVoxelVertexHash(coordinate, canonicalLevel);
    float signedNoise = float(bits & 0xffffu) *
        (2.0 / 65535.0) - 1.0;
    float amplitude = fractalPlanetMicroRelief() * 0.5 /
        exp2(float(canonicalLevel));
    vec3 direction = position / radius;
    float terrainRadius = fractalVoxelMacroRadius(direction) +
                          amplitude * signedNoise;
    float surfaceRadius = max(terrainRadius,
                              kFractalPlanetSeaRadiusScale);
    finiteValue = !isnan(surfaceRadius) && !isinf(surfaceRadius);
    return radius - frame.planetRadius * surfaceRadius;
}

vec3 fractalVoxelCornerOffset(uint corner) {
    return vec3(float(corner & 1u),
                float((corner >> 1u) & 1u),
                float((corner >> 2u) & 1u));
}

FractalVoxelCell evaluateFractalVoxelCell(vec3 position,
                                          float rayTravel) {
    FractalVoxelCell result;
    result.finiteValue = true;
    uint parentLevel = fractalPlanetMaximumLevels();
    float transition = parentLevel < kFractalPlanetMaximumLevels
        ? fractalVoxelTransition() : 0.0;
    float parentSize = frame.planetRadius *
        kFractalPlanetParentAngularWidth / exp2(float(parentLevel));
    vec3 parentMinimum = floor(position / parentSize) * parentSize;
    float parentCorner[8];
    for (uint corner = 0u; corner < 8u; ++corner) {
        bool finiteCorner = false;
        parentCorner[corner] = fractalVoxelSourceSigned(
            parentMinimum + fractalVoxelCornerOffset(corner) * parentSize,
            parentLevel, finiteCorner);
        result.finiteValue = result.finiteValue && finiteCorner;
    }

    bool useChild = transition > 1e-5 &&
                    parentLevel < kFractalPlanetMaximumLevels;
    result.size = useChild ? parentSize * 0.5 : parentSize;
    result.minimum = floor(position / result.size) * result.size;
    result.level = parentLevel + (useChild ? 1u : 0u);
    result.transition = transition;
    result.rangeMinimum = kFarDistance;
    result.rangeMaximum = -kFarDistance;
    for (uint corner = 0u; corner < 8u; ++corner) {
        vec3 cornerPosition = result.minimum +
            fractalVoxelCornerOffset(corner) * result.size;
        float parentValue = fractalVoxelTrilinear(
            parentCorner, (cornerPosition - parentMinimum) / parentSize);
        float value = parentValue;
        if (useChild) {
            bool finiteCorner = false;
            float childValue = fractalVoxelSourceSigned(
                cornerPosition, parentLevel + 1u, finiteCorner);
            result.finiteValue = result.finiteValue && finiteCorner;
            value = mix(parentValue, childValue, transition);
        }
        result.corner[corner] = value;
        result.rangeMinimum = min(result.rangeMinimum, value);
        result.rangeMaximum = max(result.rangeMaximum, value);
    }
    result.local = clamp((position - result.minimum) / result.size,
                         vec3(0.0), vec3(1.0));
    result.value = fractalVoxelTrilinear(result.corner, result.local);
    result.gradient = fractalVoxelTrilinearGradient(
        result.corner, result.local, result.size);
    result.projectedPixels = result.size *
        (float(frame.resolution.y) * 0.5) /
        max(rayTravel, frame.hitEpsilon * 0.25);
    result.finiteValue = result.finiteValue &&
        !isnan(result.value) && !isinf(result.value) &&
        !any(isnan(result.gradient)) && !any(isinf(result.gradient));
    return result;
}

float fractalVoxelDistanceToExit(vec3 position, vec3 rayDirection,
                                 vec3 cellMinimum, float cellSize) {
    vec3 cellMaximum = cellMinimum + vec3(cellSize);
    float exitDistance = kFarDistance;
    for (uint axis = 0u; axis < 3u; ++axis) {
        if (rayDirection[axis] > 0.0) {
            exitDistance = min(exitDistance,
                (cellMaximum[axis] - position[axis]) / rayDirection[axis]);
        } else if (rayDirection[axis] < 0.0) {
            exitDistance = min(exitDistance,
                (cellMinimum[axis] - position[axis]) / rayDirection[axis]);
        }
    }
    return max(exitDistance, 0.0);
}

float fractalVoxelNextTravel(float value) {
    if (!(value >= 0.0) || isnan(value) || isinf(value)) {
        return value;
    }
    return uintBitsToFloat(floatBitsToUint(value) + 1u);
}

vec3 shadeVoxelizedFractalPlanet(vec3 cameraPosition, vec3 rayDirection,
                                  out bool hitPlanet) {
    hitPlanet = false;
    fractalPlanetHit = 0u;
    fractalPlanetIntervalSkips = 0u;
    fractalPlanetNonfinite = 0u;
    fractalPlanetRootSteps = 0u;
    fractalPlanetLeafLevel = 0u;
    fractalPlanetRecoveredHit = 0u;
    fractalPlanetClosedShellMiss = 0u;
    float nearDistance;
    float farDistance;
    if (!raySphereInterval(cameraPosition, rayDirection,
                           frame.planetRadius * kFractalPlanetOuterRadiusScale,
                           nearDistance, farDistance)) {
        return vec3(0.0);
    }
    float seaNearDistance;
    float seaFarDistance;
    bool crossesClosedSea = raySphereInterval(
        cameraPosition, rayDirection,
        frame.planetRadius * kFractalPlanetSeaRadiusScale,
        seaNearDistance, seaFarDistance);
    float travel = nearDistance;
    float lastOutsideTravel = travel;
    bool lastOutsideValid = false;
    float hitDistance = kFarDistance;
    FractalVoxelCell hitCell;
    float sourceLipschitz = 8.0;
    float baseCellSize = frame.planetRadius *
        kFractalPlanetParentAngularWidth /
        exp2(float(fractalPlanetMaximumLevels()));
    float workingCellSize = fractalVoxelTransition() > 1e-5 &&
                            fractalPlanetMaximumLevels() <
                                kFractalPlanetMaximumLevels
        ? baseCellSize * 0.5 : baseCellSize;
    float interpolationBound = sourceLipschitz * workingCellSize * 1.7321;
    const float hitTolerance = max(frame.planetRadius * 1e-6,
                                   frame.hitEpsilon * 0.01);

    for (uint stepIndex = 0u;
         stepIndex < kFractalVoxelCellSteps && travel <= farDistance;
         ++stepIndex) {
        vec3 position = cameraPosition + rayDirection * travel;
        float radius = length(position);
        if (!(radius > 0.0) || isnan(radius) || isinf(radius)) {
            fractalPlanetNonfinite = 1u;
            return vec3(0.0);
        }
        vec3 direction = position / radius;
        float macroSurface = max(fractalVoxelMacroRadius(direction),
                                 kFractalPlanetSeaRadiusScale);
        float coarseLower = radius - frame.planetRadius * macroSurface -
            frame.planetRadius * fractalPlanetMicroRelief() * 0.5;
        if (coarseLower > interpolationBound) {
            lastOutsideTravel = travel;
            lastOutsideValid = true;
            travel += max((coarseLower - interpolationBound) /
                          max(sourceLipschitz, 1.0),
                          hitTolerance * 0.5);
            fractalPlanetIntervalSkips++;
            continue;
        }

        FractalVoxelCell cell = evaluateFractalVoxelCell(position, travel);
        if (!cell.finiteValue) {
            fractalPlanetNonfinite = 1u;
            return vec3(0.0);
        }
        float cellExit = fractalVoxelDistanceToExit(
            position, rayDirection, cell.minimum, cell.size);
        float exitTravel = min(travel + cellExit, farDistance);
        if (cell.rangeMinimum > hitTolerance) {
            lastOutsideTravel = exitTravel;
            lastOutsideValid = true;
            travel = fractalVoxelNextTravel(exitTravel);
            fractalPlanetIntervalSkips++;
            continue;
        }

        float bracketLow = travel;
        float bracketHigh = travel;
        bool bracketFound = false;
        float previousTravel = travel;
        float previousValue = cell.value;
        float closestValue = abs(previousValue);
        float closestTravel = travel;
        if (previousValue <= 0.0) {
            if (lastOutsideValid) {
                bracketLow = max(lastOutsideTravel, travel - cell.size);
                bracketHigh = travel;
                bracketFound = true;
            } else {
                hitDistance = travel;
                hitCell = cell;
                break;
            }
        }
        for (uint probe = 1u;
             probe <= kFractalVoxelCellProbes && !bracketFound;
             ++probe) {
            float candidateTravel = mix(
                travel, exitTravel,
                float(probe) / float(kFractalVoxelCellProbes));
            vec3 candidatePosition = cameraPosition +
                rayDirection * candidateTravel;
            float candidateValue = fractalVoxelTrilinear(
                cell.corner,
                (candidatePosition - cell.minimum) / cell.size);
            if (abs(candidateValue) < closestValue) {
                closestValue = abs(candidateValue);
                closestTravel = candidateTravel;
            }
            if (previousValue > 0.0 && candidateValue <= 0.0) {
                bracketLow = previousTravel;
                bracketHigh = candidateTravel;
                bracketFound = true;
                break;
            }
            previousTravel = candidateTravel;
            previousValue = candidateValue;
        }
        if (bracketFound) {
            for (uint root = 0u; root < kFractalVoxelRootIterations; ++root) {
                float candidateTravel = 0.5 * (bracketLow + bracketHigh);
                vec3 candidatePosition = cameraPosition +
                    rayDirection * candidateTravel;
                float candidateValue = fractalVoxelTrilinear(
                    cell.corner,
                    (candidatePosition - cell.minimum) / cell.size);
                if (candidateValue > 0.0) {
                    bracketLow = candidateTravel;
                } else {
                    bracketHigh = candidateTravel;
                }
            }
            hitDistance = 0.5 * (bracketLow + bracketHigh);
            hitCell = cell;
            fractalPlanetRootSteps += kFractalVoxelRootIterations;
            break;
        }
        if (closestValue <= hitTolerance) {
            hitDistance = closestTravel;
            hitCell = cell;
            break;
        }
        lastOutsideTravel = exitTravel;
        lastOutsideValid = true;
        travel = fractalVoxelNextTravel(exitTravel);
    }

    if (!(hitDistance < kFarDistance)) {
        if (crossesClosedSea) {
            fractalPlanetClosedShellMiss = 1u;
        }
        return vec3(0.0);
    }
    vec3 hitPosition = cameraPosition + rayDirection * hitDistance;
    float hitRadius = length(hitPosition);
    vec3 radial = hitPosition / max(hitRadius, 1e-12);
    vec3 hitLocal = clamp((hitPosition - hitCell.minimum) / hitCell.size,
                          vec3(0.0), vec3(1.0));
    vec3 normal = fractalVoxelTrilinearGradient(
        hitCell.corner, hitLocal, hitCell.size);
    float normalLength = length(normal);
    normal = normalLength > 1e-8 ? normal / normalLength : radial;
    uint material = hitRadius / frame.planetRadius <=
                            kFractalPlanetSeaRadiusScale + 2e-4
        ? 3u : 5u;

    float editedDistance;
    vec3 editedNormal;
    uint editedMaterial;
    if (intersectEditedFractalOwner(cameraPosition, rayDirection, radial,
                                    editedDistance, editedNormal,
                                    editedMaterial)) {
        if (!(editedDistance < kFarDistance)) {
            return vec3(0.0);
        }
        hitDistance = editedDistance;
        normal = normalize(editedNormal);
        material = editedMaterial;
        hitPosition = cameraPosition + rayDirection * hitDistance;
        hitRadius = length(hitPosition);
        radial = hitPosition / max(hitRadius, 1e-12);
    }
    hitPlanet = true;
    fractalPlanetHit = 1u;
    fractalPlanetLeafLevel = hitCell.level;
    uint debugMode = (frame.visualizationMode >> 21u) & 0x3u;
    if (debugMode == 1u) {
        float inBand = smoothstep(0.65, 0.8, hitCell.projectedPixels) *
                       (1.0 - smoothstep(1.6, 1.85,
                                        hitCell.projectedPixels));
        float normalizedPixels = clamp(hitCell.projectedPixels / 2.0,
                                       0.0, 1.0);
        return mix(vec3(0.9, 0.05, 0.02),
                   vec3(0.05, 0.95, 0.35), inBand) *
               (0.45 + 0.55 * normalizedPixels);
    }
    if (debugMode == 2u) {
        float level = float(hitCell.level) /
            float(kFractalPlanetMaximumLevels + 1u);
        return vec3(level, hitCell.transition,
                    1.0 - hitCell.transition);
    }
    if (debugMode == 3u) {
        vec3 edgeDistance = min(hitLocal, vec3(1.0) - hitLocal);
        float edge = 1.0 - smoothstep(0.0, 0.075,
            min(edgeDistance.x, min(edgeDistance.y, edgeDistance.z)));
        vec3 levelColor = vec3(
            float((hitCell.level * 37u) & 255u) / 255.0,
            float((hitCell.level * 73u + 51u) & 255u) / 255.0,
            float((hitCell.level * 19u + 137u) & 255u) / 255.0);
        return mix(levelColor * 0.45, vec3(1.0), edge);
    }
    float normalizedHeight = clamp((hitRadius / frame.planetRadius - 0.995) /
                                   0.045, 0.0, 1.0);
    vec3 base = material == 3u
        ? vec3(0.08, 0.46, 0.66)
        : mix(vec3(0.26, 0.48, 0.20), vec3(0.82, 0.80, 0.70),
              smoothstep(0.48, 0.88, normalizedHeight));
#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
    vec3 lightDirection = productionSunDirection();
#else
    const vec3 lightDirection = normalize(vec3(-0.45, 0.75, 0.35));
#endif
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float ambient = 0.22 + 0.08 * max(normal.y, 0.0);
    float rim = pow(1.0 - max(dot(normal, -rayDirection), 0.0), 3.0);
    return base * (ambient + 0.86 * diffuse) +
           rim * vec3(0.04, 0.24, 0.34);
}
#endif

#if VOXEL_FRACTAL_VOXEL_SDF_LAB
vec3 shadeReadableFractalVoxelSurface(
    vec3 normal, vec3 radial, vec3 rayDirection, float surfaceHeight,
    uint material, float cavityAo, float cellEdge);
#endif

vec3 shadeTrueFractalPlanet(vec3 cameraPosition, vec3 rayDirection,
                            out bool hitPlanet) {
    hitPlanet = false;
    fractalPlanetHit = 0u;
    fractalPlanetIntervalSkips = 0u;
    fractalPlanetNonfinite = 0u;
    fractalPlanetRootSteps = 0u;
    fractalPlanetLeafLevel = 0u;
    fractalPlanetRecoveredHit = 0u;
    fractalPlanetClosedShellMiss = 0u;
    fractalPlanetDirectHitDistance = kFarDistance;
    fractalPlanetDirectEdited = 0u;
    fractalPlanetDirectNormal = vec3(0.0, 0.0, 1.0);
    fractalPlanetDirectRadial = vec3(0.0, 0.0, 1.0);
    fractalPlanetDirectSurfaceHeight = 0.0;
    fractalPlanetDirectMaterial = 0u;
    float nearDistance;
    float farDistance;
    if (!raySphereInterval(cameraPosition, rayDirection,
                           frame.planetRadius * kFractalPlanetOuterRadiusScale,
                           nearDistance, farDistance)) {
        return vec3(0.0);
    }
    float seaNearDistance;
    float seaFarDistance;
    bool crossesClosedSea = raySphereInterval(
        cameraPosition, rayDirection,
        frame.planetRadius * kFractalPlanetSeaRadiusScale,
        seaNearDistance, seaFarDistance);
    float travel = nearDistance;
    float lastOutsideTravel = travel;
    bool lastOutsideValid = false;
    float hitDistance = kFarDistance;
    FractalPlanetField hitField;
    float hitLevel = 0.0;
    const float hitTolerance = max(frame.planetRadius * 2e-6,
                                   frame.hitEpsilon * 0.02);
    for (uint stepIndex = 0u;
         stepIndex < kFractalPlanetMarchSteps && travel <= farDistance;
         ++stepIndex) {
        vec3 position = cameraPosition + rayDirection * travel;
        float radius = length(position);
        if (!(radius > 0.0) || isnan(radius) || isinf(radius)) {
            fractalPlanetNonfinite = 1u;
            return vec3(0.0);
        }
        vec3 direction = position / radius;
        float continuousLevel = (frame.visualizationMode & (1u << 8u)) != 0u
            ? fractalPlanetContinuousLevel(travel)
            : 0.0;
        uint desiredLevels = uint(clamp(ceil(continuousLevel), 0.0,
                                        float(kFractalPlanetMaximumLevels)));
        uint coarseLevels = min(desiredLevels, 2u);
        FractalPlanetField coarse = evaluateFractalPlanetField(
            direction, continuousLevel, coarseLevels);
        if (!coarse.finiteValue) {
            fractalPlanetNonfinite = 1u;
            return vec3(0.0);
        }
        float coarseSigned = radius -
            frame.planetRadius * coarse.surfaceRadiusScale;
        float unresolvedWorld =
            frame.planetRadius * coarse.unresolvedMicroBound;
        // Only an interval whose lower bound is positive is proven empty.
        // The old abs(coarseSigned) test also classified intervals proven
        // inside solid terrain as empty. It skipped the near entry and could
        // return a far exit sheet or sky, matching the recorded islands.
        float conservativeOutside = max(coarseSigned - unresolvedWorld, 0.0);
        float leafWidth = frame.planetRadius *
            kFractalPlanetParentAngularWidth /
            exp2(float(desiredLevels));
        // Closed-form derivative bounds: the three macro bands contribute
        // <0.23, and every active micro octave contributes <0.864 to the
        // direction-gradient norm. Include the radial derivative and margin.
        float lipschitzBound = 1.25 + 0.864 * float(desiredLevels);
        float outsideLipschitzBound =
            1.25 + 0.864 * float(coarseLevels);
        float refinementBand = max(hitTolerance * 2.0,
                                   unresolvedWorld * 0.125);
        if (conservativeOutside > refinementBand) {
            // Macro field plus unresolved-octave interval proves this span
            // empty. It can advance the ray but can never produce a hit.
            // The Lipschitz inequality is valid across virtual-address
            // boundaries, so a proven empty interval may cross many leaves.
            // Leaf size selects the band limit; it is not a step-size clamp.
            lastOutsideTravel = travel;
            lastOutsideValid = true;
            float advance = max(conservativeOutside / outsideLipschitzBound,
                                hitTolerance * 0.5);
            travel += advance;
            fractalPlanetIntervalSkips++;
            continue;
        }
        FractalPlanetField exact = evaluateFractalPlanetField(
            direction, continuousLevel, desiredLevels);
        if (!exact.finiteValue) {
            fractalPlanetNonfinite = 1u;
            return vec3(0.0);
        }
        float exactSigned = radius -
            frame.planetRadius * exact.surfaceRadiusScale;
        if (abs(exactSigned) <= hitTolerance ||
            (lastOutsideValid && exactSigned < 0.0)) {
            float low = lastOutsideValid ? lastOutsideTravel
                                         : max(travel - leafWidth, nearDistance);
            float high = travel;
            for (uint root = 0u; root < kFractalPlanetRootIterations; ++root) {
                float candidate = 0.5 * (low + high);
                vec3 candidatePosition = cameraPosition + rayDirection * candidate;
                float candidateRadius = length(candidatePosition);
                vec3 candidateDirection = candidatePosition /
                    max(candidateRadius, 1e-12);
                float candidateLevel = (frame.visualizationMode & (1u << 8u)) != 0u
                    ? fractalPlanetContinuousLevel(candidate)
                    : 0.0;
                uint candidateLevels = uint(clamp(ceil(candidateLevel), 0.0,
                    float(kFractalPlanetMaximumLevels)));
                FractalPlanetField candidateField = evaluateFractalPlanetField(
                    candidateDirection, candidateLevel, candidateLevels);
                float candidateSigned = candidateRadius -
                    frame.planetRadius * candidateField.surfaceRadiusScale;
                if (!candidateField.finiteValue || isnan(candidateSigned) ||
                    isinf(candidateSigned)) {
                    fractalPlanetNonfinite = 1u;
                    return vec3(0.0);
                }
                if (candidateSigned > 0.0) {
                    low = candidate;
                } else {
                    high = candidate;
                }
                hitField = candidateField;
                hitLevel = candidateLevel;
            }
            fractalPlanetRootSteps += kFractalPlanetRootIterations;
            hitDistance = 0.5 * (low + high);
            break;
        }
        if (exactSigned > 0.0) {
            lastOutsideTravel = travel;
            lastOutsideValid = true;
        } else if (!lastOutsideValid) {
            // Camera/outer entry began inside the field. The first visible
            // point is the interval entry itself; never march through solid.
            hitDistance = travel;
            hitField = exact;
            hitLevel = continuousLevel;
            break;
        }
        travel += max(abs(exactSigned) / lipschitzBound,
                      hitTolerance * 0.5);
    }
    if (!(hitDistance < kFarDistance)) {
        // Correctness fallback for grazing convergence and displaced terrain
        // above the analytic sea silhouette. Scan the complete relevant outer
        // interval front-to-back, prune samples whose coarse interval proves
        // positive, and solve the earliest exact sign bracket. This never
        // substitutes the sea or outer sphere as visible geometry.
        float bracketLow = nearDistance;
        vec3 lowPosition = cameraPosition + rayDirection * bracketLow;
        float lowRadius = length(lowPosition);
        float lowLevel = (frame.visualizationMode & (1u << 8u)) != 0u
            ? fractalPlanetContinuousLevel(bracketLow)
            : 0.0;
        uint lowLevels = uint(clamp(ceil(lowLevel), 0.0,
            float(kFractalPlanetMaximumLevels)));
        FractalPlanetField lowField = evaluateFractalPlanetField(
            lowPosition / max(lowRadius, 1e-12), lowLevel, lowLevels);
        float lowSigned = lowRadius -
            frame.planetRadius * lowField.surfaceRadiusScale;
        bool bracketFound = false;
        float recoveryFar = crossesClosedSea ? seaNearDistance : farDistance;
        uint recoverySamples = crossesClosedSea ? 64u : 192u;
        float bracketHigh = recoveryFar;
        for (uint sampleIndex = 1u; sampleIndex <= 192u; ++sampleIndex) {
            if (sampleIndex > recoverySamples) {
                break;
            }
            float candidate = mix(nearDistance, recoveryFar,
                                  float(sampleIndex) /
                                      float(recoverySamples));
            vec3 candidatePosition = cameraPosition + rayDirection * candidate;
            float candidateRadius = length(candidatePosition);
            float candidateLevel =
                (frame.visualizationMode & (1u << 8u)) != 0u
                    ? fractalPlanetContinuousLevel(candidate)
                    : 0.0;
            uint candidateLevels = uint(clamp(ceil(candidateLevel), 0.0,
                float(kFractalPlanetMaximumLevels)));
            uint candidateCoarseLevels = min(candidateLevels, 2u);
            FractalPlanetField candidateCoarse = evaluateFractalPlanetField(
                candidatePosition / max(candidateRadius, 1e-12),
                candidateLevel, candidateCoarseLevels);
            float candidateLower = candidateRadius -
                frame.planetRadius * candidateCoarse.surfaceRadiusScale -
                frame.planetRadius * candidateCoarse.unresolvedMicroBound;
            if (!candidateCoarse.finiteValue || isnan(candidateLower) ||
                isinf(candidateLower)) {
                fractalPlanetNonfinite = 1u;
                break;
            }
            if (candidateLower > hitTolerance) {
                bracketLow = candidate;
                lowSigned = candidateLower;
                continue;
            }
            FractalPlanetField candidateField = evaluateFractalPlanetField(
                candidatePosition / max(candidateRadius, 1e-12),
                candidateLevel, candidateLevels);
            float candidateSigned = candidateRadius -
                frame.planetRadius * candidateField.surfaceRadiusScale;
            if (!candidateField.finiteValue || isnan(candidateSigned) ||
                isinf(candidateSigned)) {
                fractalPlanetNonfinite = 1u;
                break;
            }
            if (lowSigned > 0.0 && candidateSigned <= hitTolerance) {
                bracketHigh = candidate;
                bracketFound = true;
                break;
            }
            bracketLow = candidate;
            lowSigned = candidateSigned;
        }
        if (bracketFound) {
            for (uint root = 0u; root < kFractalPlanetRootIterations; ++root) {
                float candidate = 0.5 * (bracketLow + bracketHigh);
                vec3 candidatePosition = cameraPosition + rayDirection * candidate;
                float candidateRadius = length(candidatePosition);
                float candidateLevel =
                    (frame.visualizationMode & (1u << 8u)) != 0u
                        ? fractalPlanetContinuousLevel(candidate)
                        : 0.0;
                uint candidateLevels = uint(clamp(ceil(candidateLevel), 0.0,
                    float(kFractalPlanetMaximumLevels)));
                FractalPlanetField candidateField = evaluateFractalPlanetField(
                    candidatePosition / max(candidateRadius, 1e-12),
                    candidateLevel, candidateLevels);
                float candidateSigned = candidateRadius -
                    frame.planetRadius * candidateField.surfaceRadiusScale;
                if (!candidateField.finiteValue || isnan(candidateSigned) ||
                    isinf(candidateSigned)) {
                    fractalPlanetNonfinite = 1u;
                    break;
                }
                if (candidateSigned > 0.0) {
                    bracketLow = candidate;
                } else {
                    bracketHigh = candidate;
                }
                hitField = candidateField;
                hitLevel = candidateLevel;
            }
            if (fractalPlanetNonfinite == 0u) {
                hitDistance = 0.5 * (bracketLow + bracketHigh);
                fractalPlanetRootSteps += kFractalPlanetRootIterations;
                fractalPlanetRecoveredHit = 1u;
            }
        }
        if (!(hitDistance < kFarDistance) && crossesClosedSea) {
            fractalPlanetClosedShellMiss = 1u;
            return vec3(0.0);
        }
    }
    if (!(hitDistance < kFarDistance)) {
        return vec3(0.0);
    }
    vec3 hitPosition = cameraPosition + rayDirection * hitDistance;
    float hitRadius = length(hitPosition);
    vec3 radial = hitPosition / max(hitRadius, 1e-12);
    uint leafLevel = uint(clamp(ceil(hitLevel), 0.0,
                                float(kFractalPlanetMaximumLevels)));
    hitField = evaluateFractalPlanetField(radial, hitLevel, leafLevel);
    uint material = hitField.water ? 3u : 5u;
    vec3 normal = radial;
    if (!hitField.water) {
        vec3 tangentGradient = hitField.directionGradient - radial *
            dot(hitField.directionGradient, radial);
        normal = normalize(radial - tangentGradient /
            max(hitField.surfaceRadiusScale, 1e-6));
    }
    float editedDistance;
    vec3 editedNormal;
    uint editedMaterial;
    if (intersectEditedFractalOwner(cameraPosition, rayDirection, radial,
                                    editedDistance, editedNormal,
                                    editedMaterial)) {
        if (!(editedDistance < kFarDistance)) {
            return vec3(0.0);
        }
        hitDistance = editedDistance;
        normal = normalize(editedNormal);
        material = editedMaterial;
        hitPosition = cameraPosition + rayDirection * hitDistance;
        hitRadius = length(hitPosition);
        radial = hitPosition / max(hitRadius, 1e-12);
        fractalPlanetDirectEdited = 1u;
    }
    fractalPlanetDirectHitDistance = hitDistance;
    fractalPlanetDirectNormal = normal;
    fractalPlanetDirectRadial = radial;
    fractalPlanetDirectSurfaceHeight = hitRadius / frame.planetRadius;
    fractalPlanetDirectMaterial = material;
    hitPlanet = true;
    fractalPlanetHit = 1u;
    fractalPlanetLeafLevel = leafLevel;
    uint debugMode = (frame.visualizationMode >> 21u) & 0x3u;
    if (debugMode == 1u) {
        float level = float(leafLevel) /
            max(float(fractalPlanetMaximumLevels()), 1.0);
        return vec3(level, 1.0 - abs(level * 2.0 - 1.0), 1.0 - level);
    }
    if (debugMode == 2u) {
        if (fractalPlanetRecoveredHit != 0u) {
            return vec3(1.0, 0.85, 0.0);
        }
        float work = clamp(float(fractalPlanetIntervalSkips) / 64.0, 0.0, 1.0);
        return vec3(work, work * work, 1.0 - work);
    }
    if (debugMode == 3u) {
        float height = clamp((hitField.terrainRadiusScale - 0.982) /
                             (kFractalPlanetOuterRadiusScale - 0.982),
                             0.0, 1.0);
        return vec3(height);
    }
    float normalizedHeight = clamp((hitRadius / frame.planetRadius - 0.995) /
                                   0.045, 0.0, 1.0);
    vec3 base = material == 3u
        ? vec3(0.08, 0.46, 0.66)
        : mix(vec3(0.26, 0.48, 0.20), vec3(0.82, 0.80, 0.70),
              smoothstep(0.48, 0.88, normalizedHeight));
    const vec3 lightDirection = normalize(vec3(-0.45, 0.75, 0.35));
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float ambient = 0.19 + 0.10 * max(normal.y, 0.0);
    float rim = pow(1.0 - max(dot(normal, -rayDirection), 0.0), 3.0);
#if VOXEL_FRACTAL_VOXEL_SDF_LAB
    return shadeReadableFractalVoxelSurface(
        normal, radial, rayDirection, hitRadius / frame.planetRadius,
        material, 1.0, 0.0);
#else
    return base * (ambient + 0.9 * diffuse) +
           rim * vec3(0.04, 0.24, 0.34);
#endif
}

#if VOXEL_FRACTAL_VOXEL_SDF_LAB
const uint kFractalVoxelCacheResolution = 664u;
const uint kFractalVoxelCacheHeader = 16u;
const uint kFractalVoxelCachePlane =
    kFractalVoxelCacheResolution * kFractalVoxelCacheResolution;

float fractalVoxelLastCavity;

float unpackFractalVoxelHeight(uint packed) {
    return 0.96 + float(packed & 0x00ffffffu) *
        (0.10 / 16777215.0);
}

float unpackFractalVoxelCavity(uint packed) {
    return float(packed >> 24u) * (1.0 / 255.0);
}

bool fractalVoxelDiscreteSurface() {
    return frame.terrainPolarStrength > 0.0;
}

float fractalVoxelCacheInterior(vec2 coordinate) {
    float maximumCoordinate = float(kFractalVoxelCacheResolution - 2u);
    float boundaryCells = min(
        min(coordinate.x - 1.0, coordinate.y - 1.0),
        min(maximumCoordinate - coordinate.x,
            maximumCoordinate - coordinate.y));
    return smoothstep(2.0, 18.0, boundaryCells);
}

float sampleFractalVoxelCacheGrid(uint grid, vec2 coordinate,
                                  out vec2 heightGradient,
                                  out float cavity) {
    vec2 clampedCoordinate = clamp(
        coordinate, vec2(0.0),
        vec2(float(kFractalVoxelCacheResolution - 1u) - 1e-4));
    uvec2 base = uvec2(floor(clampedCoordinate));
    vec2 local = fract(clampedCoordinate);
    uint offset = kFractalVoxelCacheHeader + grid * kFractalVoxelCachePlane;
    uint row0 = offset + base.x + kFractalVoxelCacheResolution * base.y;
    uint row1 = row0 + kFractalVoxelCacheResolution;
    uint p00 = cells[row0];
    uint p10 = cells[row0 + 1u];
    uint p01 = cells[row1];
    uint p11 = cells[row1 + 1u];
    if (any(equal(uvec4(p00, p10, p01, p11), uvec4(0u)))) {
        float invalidValue = uintBitsToFloat(0x7fc00000u);
        heightGradient = vec2(invalidValue);
        cavity = invalidValue;
        return invalidValue;
    }
    float h00 = unpackFractalVoxelHeight(p00);
    float h10 = unpackFractalVoxelHeight(p10);
    float h01 = unpackFractalVoxelHeight(p01);
    float h11 = unpackFractalVoxelHeight(p11);
    float bottom = mix(h00, h10, local.x);
    float top = mix(h01, h11, local.x);
    heightGradient = vec2(
        mix(h10 - h00, h11 - h01, local.y),
        mix(h01 - h00, h11 - h10, local.x));
    float cavityBottom = mix(unpackFractalVoxelCavity(p00),
                             unpackFractalVoxelCavity(p10), local.x);
    float cavityTop = mix(unpackFractalVoxelCavity(p01),
                          unpackFractalVoxelCavity(p11), local.x);
    cavity = mix(cavityBottom, cavityTop, local.y);
    float smoothHeight = mix(bottom, top, local.y);
    if (!fractalVoxelDiscreteSurface()) {
        return smoothHeight;
    }
    // A leaf owns [base,base+1) in both tangent axes. Its radial cap is a
    // constant deterministic aggregate of the same four SDF samples, making
    // the cap and the height discontinuity at its sides actual geometry rather
    // than a grid shader drawn over a smooth root. Fade only near the bounded
    // cache edge so direct-SDF fallback cannot expose a rectangular seam.
    float discreteHeight = 0.25 * (h00 + h10 + h01 + h11);
    float discreteCavity = 0.25 * (
        unpackFractalVoxelCavity(p00) + unpackFractalVoxelCavity(p10) +
        unpackFractalVoxelCavity(p01) + unpackFractalVoxelCavity(p11));
    float interior = fractalVoxelCacheInterior(clampedCoordinate);
    heightGradient *= 1.0 - interior;
    cavity = mix(cavity, discreteCavity, interior);
    return mix(smoothHeight, discreteHeight, interior);
}

bool sampleFractalVoxelCache(vec3 direction, out float surfaceHeight,
                             out vec2 tangentGradient,
                             out vec2 activeCoordinate,
                             out float activeCellSize,
                             out uint activeLevel) {
    if (cells[0] != 0x46564348u ||
        cells[15] != kFractalVoxelCacheResolution) {
        return false;
    }
    uint parentLevel = cells[1];
    float morph = uintBitsToFloat(cells[2]);
    float parentSize = uintBitsToFloat(cells[3]);
    vec3 center = normalize(vec3(
        uintBitsToFloat(cells[4]), uintBitsToFloat(cells[5]),
        uintBitsToFloat(cells[6])));
    vec3 right = normalize(vec3(
        uintBitsToFloat(cells[7]), uintBitsToFloat(cells[8]),
        uintBitsToFloat(cells[9])));
    vec3 forward = normalize(vec3(
        uintBitsToFloat(cells[10]), uintBitsToFloat(cells[11]),
        uintBitsToFloat(cells[12])));
    float denominator = dot(direction, center);
    if (!(denominator > 0.0) || isnan(denominator) || isinf(denominator)) {
        return false;
    }
    vec3 tangentPoint = direction / denominator;
    vec2 tangentOffset = frame.planetRadius * vec2(
        dot(tangentPoint, right), dot(tangentPoint, forward));
    float halfGrid = float(kFractalVoxelCacheResolution - 1u) * 0.5;
    vec2 parentCoordinate = tangentOffset / parentSize + vec2(halfGrid);
    if (any(lessThan(parentCoordinate, vec2(1.0))) ||
        any(greaterThan(parentCoordinate,
                        vec2(float(kFractalVoxelCacheResolution - 2u))))) {
        return false;
    }
    vec2 parentGradient;
    float parentCavity;
    float parentHeight = sampleFractalVoxelCacheGrid(
        0u, parentCoordinate, parentGradient, parentCavity);
    fractalVoxelLastCavity = parentCavity;
    parentGradient /= max(parentSize, 1e-12);
    surfaceHeight = parentHeight;
    tangentGradient = parentGradient;
    activeCoordinate = parentCoordinate;
    activeCellSize = parentSize;
    activeLevel = parentLevel;
    if (morph > 1e-5 && parentLevel < kFractalPlanetMaximumLevels) {
        float childSize = parentSize * 0.5;
        vec2 childCoordinate = tangentOffset / childSize + vec2(halfGrid);
        if (any(lessThan(childCoordinate, vec2(1.0))) ||
            any(greaterThan(childCoordinate,
                            vec2(float(kFractalVoxelCacheResolution - 2u))))) {
            return false;
        }
        vec2 childGradient;
        float childCavity;
        float childHeight = sampleFractalVoxelCacheGrid(
            1u, childCoordinate, childGradient, childCavity);
        fractalVoxelLastCavity = mix(parentCavity, childCavity, morph);
        childGradient /= max(childSize, 1e-12);
        surfaceHeight = mix(parentHeight, childHeight, morph);
        tangentGradient = mix(parentGradient, childGradient, morph);
        activeCoordinate = childCoordinate;
        activeCellSize = childSize;
        activeLevel = parentLevel + 1u;
    }
    return !isnan(surfaceHeight) && !isinf(surfaceHeight) &&
           !any(isnan(tangentGradient)) && !any(isinf(tangentGradient));
}

bool fractalVoxelCacheSigned(vec3 position, out float signedValue,
                             out float surfaceHeight,
                             out vec2 tangentGradient,
                             out vec2 activeCoordinate,
                             out float activeCellSize,
                             out uint activeLevel) {
    float radius = length(position);
    if (!(radius > 0.0) || isnan(radius) || isinf(radius)) {
        return false;
    }
    if (!sampleFractalVoxelCache(
            position / radius, surfaceHeight, tangentGradient,
            activeCoordinate, activeCellSize, activeLevel)) {
        return false;
    }
    signedValue = radius / frame.planetRadius - surfaceHeight;
    return !isnan(signedValue) && !isinf(signedValue);
}

float fractalVoxelLocalCavityAo(float strength) {
    if (!(strength > 0.0)) {
        return 1.0;
    }
    return clamp(1.0 - strength * clamp(fractalVoxelLastCavity, 0.0, 1.0),
                 0.55, 1.0);
}

vec3 fractalVoxelToneMap(vec3 hdr) {
    hdr = max(hdr, vec3(0.0));
    vec3 mapped = (hdr * (2.51 * hdr + 0.03)) /
        (hdr * (2.43 * hdr + 0.59) + 0.14);
    // sqrt is a close, stable gamma approximation and avoids three expensive
    // general-power evaluations in the full-screen compute path.
    return sqrt(clamp(mapped, vec3(0.0), vec3(1.0)));
}

vec3 shadeReadableFractalVoxelSurface(
    vec3 normal, vec3 radial, vec3 rayDirection, float surfaceHeight,
    uint material, float cavityAo, float cellEdge) {
    float normalSharpness = clamp(abs(frame.terrainPolarStrength) - 1.0,
                                  0.0, 1.0);
    float radialNormal = max(dot(normal, radial), 0.12);
    vec3 tangentNormal = normal - radial * dot(normal, radial);
    normal = normalize(radial * radialNormal + tangentNormal *
                       (1.0 + 1.75 * normalSharpness));
    float height01 = clamp(
        (surfaceHeight - kFractalPlanetSeaRadiusScale) / 0.034,
        0.0, 1.0);
    float radialDot = clamp(dot(normal, radial), 0.0, 1.0);
    float slope = sqrt(max(1.0 - radialDot * radialDot, 0.0));
    vec3 waterColor = vec3(0.018, 0.16, 0.27);
    vec3 sandColor = vec3(0.55, 0.39, 0.20);
    vec3 terrainColor = mix(vec3(0.16, 0.34, 0.11),
                            vec3(0.28, 0.30, 0.13), height01);
    vec3 rockColor = mix(vec3(0.27, 0.25, 0.24),
                         vec3(0.46, 0.43, 0.39), height01);
    float shoreBlend = smoothstep(0.025, 0.16, height01);
    float rockBlend = max(smoothstep(0.22, 0.62, slope),
                          smoothstep(0.67, 0.94, height01));
    vec3 landColor = mix(mix(sandColor, terrainColor, shoreBlend),
                         rockColor, rockBlend);
    float snowBlend = smoothstep(0.88, 1.0, height01) *
                      (1.0 - smoothstep(0.72, 0.92, slope));
    landColor = mix(landColor, vec3(0.78, 0.82, 0.84), snowBlend);
    vec3 base = material == 3u ? waterColor : landColor;
    vec3 lightVector = vec3(frame.terrainContinentScale,
                            frame.terrainContinentStrength,
                            frame.terrainMountainScale);
    float sunStrength = length(lightVector);
    vec3 lightDirection = sunStrength > 1e-6
        ? lightVector / sunStrength : radial;
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float ambientStrength = clamp(frame.terrainMountainStrength,
                                  0.05, 0.65);
    vec3 viewDirection = -rayDirection;
    vec3 halfDirection = normalize(lightDirection + viewDirection);
    float specularBase = max(dot(normal, halfDirection), 0.0);
    float specular2 = specularBase * specularBase;
    float specular4 = specular2 * specular2;
    float specular8 = specular4 * specular4;
    float specular16 = specular8 * specular8;
    float specular64 = specular16 * specular16;
    specular64 *= specular64;
    float specular = material == 3u
        ? specular64 * 0.72 : specular16 * 0.06;
    float fresnelBase = 1.0 - max(dot(normal, viewDirection), 0.0);
    float fresnel2 = fresnelBase * fresnelBase;
    float fresnel = fresnel2 * fresnel2 * fresnelBase;
    vec3 hdr = base * (ambientStrength * cavityAo +
                       sunStrength * diffuse * (0.92 + 0.08 * cavityAo));
    hdr += sunStrength * specular *
        (material == 3u ? mix(vec3(0.08, 0.18, 0.24), vec3(0.82), fresnel)
                        : vec3(0.20, 0.18, 0.15));
    hdr *= 1.0 - clamp(frame.terrainOceanLevel, 0.0, 0.40) * cellEdge;
    return fractalVoxelToneMap(hdr);
}

vec3 shadeMaterializedFractalVoxelPlanet(
    vec3 cameraPosition, vec3 rayDirection, out bool hitPlanet) {
    vec3 directColor = shadeTrueFractalPlanet(
        cameraPosition, rayDirection, hitPlanet);
    uint debugMode = (frame.visualizationMode >> 21u) & 0x3u;
    vec3 fallbackColor = directColor;
    if (!hitPlanet || fractalPlanetDirectEdited != 0u ||
        !(fractalPlanetDirectHitDistance < kFarDistance)) {
        return directColor;
    }
    float directDistance = fractalPlanetDirectHitDistance;
    float parentSize = cells[0] == 0x46564348u
        ? uintBitsToFloat(cells[3]) : 0.0;
    if (!(parentSize > 0.0) || isnan(parentSize) || isinf(parentSize)) {
        return fallbackColor;
    }
    float searchRadius = max(parentSize * 4.0,
                             frame.planetRadius * 8e-6);
    float searchNear = max(directDistance - searchRadius, 0.0);
    float searchFar = directDistance + searchRadius;
    float previousTravel = searchNear;
    float previousSigned;
    float ignoredHeight;
    vec2 ignoredGradient;
    vec2 ignoredCoordinate;
    float ignoredCellSize;
    uint ignoredLevel;
    if (!fractalVoxelCacheSigned(
            cameraPosition + rayDirection * previousTravel,
            previousSigned, ignoredHeight, ignoredGradient,
            ignoredCoordinate, ignoredCellSize, ignoredLevel)) {
        return fallbackColor;
    }
    bool bracketFound = false;
    float bracketLow = searchNear;
    float bracketHigh = searchFar;
    float farSigned;
    if (!fractalVoxelCacheSigned(
            cameraPosition + rayDirection * searchFar,
            farSigned, ignoredHeight, ignoredGradient,
            ignoredCoordinate, ignoredCellSize, ignoredLevel)) {
        return fallbackColor;
    }
    if (previousSigned > 0.0 && farSigned <= 0.0) {
        bracketFound = true;
    }
    for (uint probe = 1u; probe <= 24u && !bracketFound; ++probe) {
        float candidateTravel = mix(searchNear, searchFar,
                                    float(probe) / 24.0);
        float candidateSigned;
        if (!fractalVoxelCacheSigned(
                cameraPosition + rayDirection * candidateTravel,
                candidateSigned, ignoredHeight, ignoredGradient,
                ignoredCoordinate, ignoredCellSize, ignoredLevel)) {
            return fallbackColor;
        }
        if (previousSigned > 0.0 && candidateSigned <= 0.0) {
            bracketLow = previousTravel;
            bracketHigh = candidateTravel;
            bracketFound = true;
            break;
        }
        previousTravel = candidateTravel;
        previousSigned = candidateSigned;
    }
    if (!bracketFound) {
        // This pixel was within the materialized cache footprint but its leaf
        // did not reproduce the source-field crossing. Keep the source hit
        // visible, but fail the automated cache-equivalence gate.
        fractalPlanetClosedShellMiss = 1u;
        return fallbackColor;
    }
    for (uint root = 0u; root < kFractalVoxelRootIterations; ++root) {
        float candidateTravel = 0.5 * (bracketLow + bracketHigh);
        float candidateSigned;
        if (!fractalVoxelCacheSigned(
                cameraPosition + rayDirection * candidateTravel,
                candidateSigned, ignoredHeight, ignoredGradient,
                ignoredCoordinate, ignoredCellSize, ignoredLevel)) {
            fractalPlanetClosedShellMiss = 1u;
            return fallbackColor;
        }
        if (candidateSigned > 0.0) {
            bracketLow = candidateTravel;
        } else {
            bracketHigh = candidateTravel;
        }
    }
    float hitDistance = 0.5 * (bracketLow + bracketHigh);
    vec3 hitPosition = cameraPosition + rayDirection * hitDistance;
    float hitRadius = length(hitPosition);
    vec3 radial = hitPosition / max(hitRadius, 1e-12);
    float surfaceHeight;
    vec2 tangentGradient;
    vec2 activeCoordinate;
    float activeCellSize;
    uint activeLevel;
    float cachedSigned;
    if (!fractalVoxelCacheSigned(
            hitPosition, cachedSigned, surfaceHeight, tangentGradient,
            activeCoordinate, activeCellSize, activeLevel)) {
        fractalPlanetClosedShellMiss = 1u;
        return fallbackColor;
    }
    vec3 cacheRight = normalize(vec3(
        uintBitsToFloat(cells[7]), uintBitsToFloat(cells[8]),
        uintBitsToFloat(cells[9])));
    vec3 cacheForward = normalize(vec3(
        uintBitsToFloat(cells[10]), uintBitsToFloat(cells[11]),
        uintBitsToFloat(cells[12])));
    vec3 normal = normalize(radial - cacheRight * tangentGradient.x -
                            cacheForward * tangentGradient.y);
    if (fractalVoxelDiscreteSurface()) {
        // A sign bracket that crosses a half-open angular cell boundary is a
        // real radial side wall. Recover its exact gnomonic boundary plane;
        // otherwise this is a constant-height radial cap. Tied x/y crossings
        // combine both planes deterministically for corner ownership.
        float savedCavity = fractalVoxelLastCavity;
        float lowSigned;
        float lowHeight;
        vec2 lowGradient;
        vec2 lowCoordinate;
        float lowCellSize;
        uint lowLevel;
        float highSigned;
        float highHeight;
        vec2 highGradient;
        vec2 highCoordinate;
        float highCellSize;
        uint highLevel;
        bool lowValid = fractalVoxelCacheSigned(
            cameraPosition + rayDirection * bracketLow,
            lowSigned, lowHeight, lowGradient, lowCoordinate,
            lowCellSize, lowLevel);
        bool highValid = fractalVoxelCacheSigned(
            cameraPosition + rayDirection * bracketHigh,
            highSigned, highHeight, highGradient, highCoordinate,
            highCellSize, highLevel);
        fractalVoxelLastCavity = savedCavity;
        if (lowValid && highValid && lowLevel == highLevel &&
            abs(lowCellSize - highCellSize) <= max(activeCellSize, 1e-12) *
                                               1e-5) {
            ivec2 lowCell = ivec2(floor(lowCoordinate));
            ivec2 highCell = ivec2(floor(highCoordinate));
            ivec2 crossing = highCell - lowCell;
            if (any(notEqual(crossing, ivec2(0)))) {
                vec3 cacheCenter = normalize(vec3(
                    uintBitsToFloat(cells[4]), uintBitsToFloat(cells[5]),
                    uintBitsToFloat(cells[6])));
                float halfGrid =
                    float(kFractalVoxelCacheResolution - 1u) * 0.5;
                vec3 sideNormal = vec3(0.0);
                if (crossing.x != 0) {
                    float boundary = float(max(lowCell.x, highCell.x));
                    float tangent = (boundary - halfGrid) * activeCellSize;
                    vec3 planeNormal = normalize(
                        cacheRight - (tangent / frame.planetRadius) *
                                         cacheCenter);
                    sideNormal += dot(planeNormal, rayDirection) < 0.0
                        ? planeNormal : -planeNormal;
                }
                if (crossing.y != 0) {
                    float boundary = float(max(lowCell.y, highCell.y));
                    float tangent = (boundary - halfGrid) * activeCellSize;
                    vec3 planeNormal = normalize(
                        cacheForward - (tangent / frame.planetRadius) *
                                           cacheCenter);
                    sideNormal += dot(planeNormal, rayDirection) < 0.0
                        ? planeNormal : -planeNormal;
                }
                if (dot(sideNormal, sideNormal) > 1e-8) {
                    normal = normalize(sideNormal);
                }
            }
        }
    }
    uint material = surfaceHeight <= kFractalPlanetSeaRadiusScale + 2e-4
        ? 3u : 5u;
    fractalPlanetDirectHitDistance = hitDistance;
    fractalPlanetLeafLevel = activeLevel;
    fractalPlanetRootSteps += kFractalVoxelRootIterations;
    fractalPlanetRecoveredHit = 1u;
    if (debugMode == 1u) {
        float projectedPixels = activeCellSize *
            (float(frame.resolution.y) * 0.5) /
            max(hitDistance, frame.hitEpsilon * 0.25);
        float inBand = smoothstep(0.65, 0.8, projectedPixels) *
                       (1.0 - smoothstep(1.6, 1.85, projectedPixels));
        return mix(vec3(0.9, 0.05, 0.02),
                   vec3(0.05, 0.95, 0.35), inBand);
    }
    if (debugMode == 2u) {
        float level = float(activeLevel) /
            float(kFractalPlanetMaximumLevels + 1u);
        return vec3(level, uintBitsToFloat(cells[2]),
                    1.0 - uintBitsToFloat(cells[2]));
    }
    if (debugMode == 3u) {
        vec2 edgeDistance = min(fract(activeCoordinate),
                                vec2(1.0) - fract(activeCoordinate));
        float edge = 1.0 - smoothstep(0.0, 0.08,
                                     min(edgeDistance.x, edgeDistance.y));
        vec3 levelColor = vec3(
            float((activeLevel * 37u) & 255u) / 255.0,
            float((activeLevel * 73u + 51u) & 255u) / 255.0,
            float((activeLevel * 19u + 137u) & 255u) / 255.0);
        return mix(levelColor * 0.42, vec3(1.0), edge);
    }
    float projectedPixels = activeCellSize *
        (float(frame.resolution.y) * 0.5) /
        max(hitDistance, frame.hitEpsilon * 0.25);
    vec2 edgeDistance = min(fract(activeCoordinate),
                            vec2(1.0) - fract(activeCoordinate));
    float edgeWidth = clamp(0.70 / max(projectedPixels, 1.0),
                            0.04, 0.30);
    float cellEdge = 1.0 - smoothstep(
        0.0, edgeWidth, min(edgeDistance.x, edgeDistance.y));
    cellEdge *= fractalVoxelDiscreteSurface()
        ? smoothstep(0.72, 1.45, projectedPixels)
        : smoothstep(1.45, 2.50, projectedPixels);
    float cacheInterior = fractalVoxelCacheInterior(activeCoordinate);
    // The direct field and sampled cache use the same readable shading. Blend
    // only normal/detail metadata near the bounded cache edge, so crossing the
    // footprint cannot reveal a square or change a valid direct fallback.
    normal = normalize(mix(fractalPlanetDirectNormal, normal, cacheInterior));
    radial = normalize(mix(fractalPlanetDirectRadial, radial, cacheInterior));
    surfaceHeight = mix(fractalPlanetDirectSurfaceHeight,
                        surfaceHeight, cacheInterior);
    material = cacheInterior > 0.5
        ? material : fractalPlanetDirectMaterial;
    float cavityAo = material == 3u ? 1.0 :
        mix(1.0, fractalVoxelLocalCavityAo(
            clamp(frame.terrainRoughness, 0.0, 0.45)), cacheInterior);
    if ((frame.visualizationMode & (1u << 31u)) != 0u) {
        return vec3(cavityAo);
    }
    return shadeReadableFractalVoxelSurface(
        normal, radial, rayDirection, surfaceHeight, material,
        cavityAo, cellEdge * cacheInterior);
}
#endif
#endif

#if VOXEL_SCALE_LAB
uint farFieldLevelOffset(uint level) {
    uint offset = 0u;
    uint width = kTileLookupWidth;
    uint height = kTileLookupHeight;
    for (uint current = 0u; current < level; ++current) {
        offset += width * height;
        width = max(width >> 1u, 1u);
        height = max(height >> 1u, 1u);
    }
    return offset;
}

uint farFieldNode(vec3 direction, uint level) {
    uint width = max(kTileLookupWidth >> level, 1u);
    uint height = max(kTileLookupHeight >> level, 1u);
    float longitude = atan(direction.z, direction.x);
    float latitude = asin(clamp(direction.y, -1.0, 1.0));
    uint x = min(uint((longitude / (2.0 * kPi) + 0.5) * float(width)), width - 1u);
    uint y = min(uint((0.5 - latitude / kPi) * float(height)), height - 1u);
    return geodesicFarField[1u + farFieldLevelOffset(level) + x + width * y];
}

float hierarchyCellAngularMargin(vec3 direction, uint level) {
    uint width = max(kTileLookupWidth >> level, 1u);
    uint height = max(kTileLookupHeight >> level, 1u);
    float longitude = atan(direction.z, direction.x);
    float latitude = asin(clamp(direction.y, -1.0, 1.0));
    uint x = min(uint((longitude / (2.0 * kPi) + 0.5) * float(width)),
                 width - 1u);
    uint y = min(uint((0.5 - latitude / kPi) * float(height)),
                 height - 1u);
    float west = -kPi + 2.0 * kPi * float(x) / float(width);
    float east = -kPi + 2.0 * kPi * float(x + 1u) / float(width);
    vec3 westPlane = vec3(-sin(west), 0.0, cos(west));
    vec3 eastPlane = vec3(-sin(east), 0.0, cos(east));
    float longitudeMargin = min(
        asin(clamp(abs(dot(direction, westPlane)), 0.0, 1.0)),
        asin(clamp(abs(dot(direction, eastPlane)), 0.0, 1.0)));
    float north = (0.5 - float(y) / float(height)) * kPi;
    float south = (0.5 - float(y + 1u) / float(height)) * kPi;
    float latitudeMargin = min(abs(north - latitude), abs(latitude - south));
    return max(min(longitudeMargin, latitudeMargin), 0.0);
}

float conservativeHierarchyAdvance(vec3 rayOrigin, vec3 rayDirection,
                                   float nearDistance, float farDistance) {
    // Edited columns invalidate their precomputed parent envelopes. Exact DDA
    // remains active, and the global occupied-radius bound is still valid.
    if (geodesicFarField[0] != 0u) {
        return nearDistance;
    }
    float travel = nearDistance;
    const float angularSpeedRadius = frame.planetRadius * 0.75;
    const uint levels[3] = uint[3](1u, 3u, 5u);
    for (uint iteration = 0u; iteration < 32u; ++iteration) {
        vec3 position = rayOrigin + rayDirection * travel;
        float radius = length(position);
        if (isnan(radius) || isinf(radius) || radius <= 0.0) {
            if (frame.geodesicTraversalMode == 8u) {
                ++scaleBoundNonfinite;
            }
            break;
        }
        vec3 direction = position / radius;
        float longitudeUnit = fract(atan(direction.z, direction.x) /
                                    (2.0 * kPi) + 0.5);
        float latitudeUnit = clamp(0.5 -
            asin(clamp(direction.y, -1.0, 1.0)) / kPi, 0.0, 1.0);
        float latitudeCosine = sqrt(max(1.0 - direction.y * direction.y, 0.0));
        float bestBound = 0.0;
        for (uint candidate = 0u; candidate < 3u; ++candidate) {
            uint level = levels[candidate];
            uint width = max(kTileLookupWidth >> level, 1u);
            uint height = max(kTileLookupHeight >> level, 1u);
            float xCoordinate = longitudeUnit * float(width);
            float yCoordinate = min(latitudeUnit * float(height),
                                    uintBitsToFloat(floatBitsToUint(float(height)) - 1u));
            uint x = min(uint(xCoordinate), width - 1u);
            uint y = min(uint(yCoordinate), height - 1u);
            uint radiusBits = geodesicFarField[
                1u + farFieldLevelOffset(level) + x + width * y];
            if (radiusBits == 0u) {
                continue;
            }
            float occupiedRadius = uintBitsToFloat(radiusBits) *
                                   frame.planetRadius;
            if (isnan(occupiedRadius) || isinf(occupiedRadius) ||
                occupiedRadius <= 0.0 ||
                occupiedRadius > frame.planetRadius * frame.planetOuterScale) {
                if (frame.geodesicTraversalMode == 8u) {
                    ++scaleBoundNonfinite;
                }
                return travel;
            }
            float radialBound = radius - occupiedRadius;
            if (radialBound <= 0.0) {
                continue;
            }
            float longitudeFraction = fract(xCoordinate);
            float latitudeFraction = fract(yCoordinate);
            // For these levels the nearest longitude boundary is at most
            // 0.0982 rad away. sin(x) >= 0.99*x over that interval, providing
            // a cheap strict lower bound on great-circle distance.
            float longitudeMargin = min(longitudeFraction,
                                        1.0 - longitudeFraction) *
                (2.0 * kPi / float(width)) * latitudeCosine * 0.99;
            float latitudeMargin = min(latitudeFraction,
                                       1.0 - latitudeFraction) *
                (kPi / float(height));
            float angularBound = min(longitudeMargin, latitudeMargin) *
                                 angularSpeedRadius;
            bestBound = max(bestBound, min(radialBound, angularBound));
        }
        if (!(bestBound > 0.0) || isnan(bestBound) || isinf(bestBound)) {
            if (isnan(bestBound) || isinf(bestBound)) {
                if (frame.geodesicTraversalMode == 8u) {
                    ++scaleBoundNonfinite;
                }
            }
            break;
        }
        // Stay strictly inside both the radial and angular proof intervals.
        // This factor protects their floating-point composition; it is a
        // dimensionless fraction of a derived lower bound, not a loose
        // world-space traversal epsilon.
        // Stay well inside both proof intervals; this also avoids increasing
        // leaf-DDA work at the handoff on grazing rays.
        float safeBound = bestBound * 0.5;
        float next = travel + safeBound;
        float oneUlp = uintBitsToFloat(floatBitsToUint(travel) + 1u);
        if (!(next >= oneUlp) || next >= farDistance || isnan(next) || isinf(next)) {
            if (isnan(next) || isinf(next)) {
                if (frame.geodesicTraversalMode == 8u) {
                    ++scaleBoundNonfinite;
                }
            }
            break;
        }
        travel = next;
        if (frame.geodesicTraversalMode == 8u) {
            ++scaleBoundSkips;
        }
    }
    return travel;
}

bool tileOrTwoRingContains(uint centerTile, uint candidate) {
    if (centerTile == candidate) {
        return true;
    }
    GeodesicTile center = geodesicTiles[centerTile];
    for (uint firstSlot = 0u;
         firstSlot < geodesicTileNeighborCount(center); ++firstSlot) {
        uint first = tileNeighbor(center, firstSlot);
        if (first == candidate) {
            return true;
        }
        GeodesicTile firstTile = geodesicTiles[first];
        for (uint secondSlot = 0u;
             secondSlot < geodesicTileNeighborCount(firstTile); ++secondSlot) {
            if (tileNeighbor(firstTile, secondSlot) == candidate) {
                return true;
            }
        }
    }
    return false;
}

bool dirtyTwoRing(uint tileIndex) {
    if (geodesicColumnStates[tileIndex].w != 0u) {
        return true;
    }
    GeodesicTile tile = geodesicTiles[tileIndex];
    for (uint firstSlot = 0u;
         firstSlot < geodesicTileNeighborCount(tile); ++firstSlot) {
        uint first = tileNeighbor(tile, firstSlot);
        if (geodesicColumnStates[first].w != 0u) {
            return true;
        }
        GeodesicTile firstTile = geodesicTiles[first];
        for (uint secondSlot = 0u;
             secondSlot < geodesicTileNeighborCount(firstTile); ++secondSlot) {
            if (geodesicColumnStates[tileNeighbor(firstTile, secondSlot)].w != 0u) {
                return true;
            }
        }
    }
    return false;
}

bool traceFarFieldAggregate(vec3 cameraPosition, vec3 rayDirection,
                            out float hitDistance, out vec3 hitNormal,
                            out uint material, out uint height,
                            out uint seedTile, out float surfaceRadius,
                            out bool conservativeOverlap) {
    conservativeOverlap = false;
    float outerNear = 0.0;
    float outerFar = 0.0;
    if (!raySphereInterval(cameraPosition, rayDirection,
                           frame.planetRadius * frame.planetOuterScale,
                           outerNear, outerFar)) {
        return false;
    }
    vec3 direction = normalize(cameraPosition + rayDirection * outerNear);
    float projectedBasePixels = (2.0 * kPi / float(kTileLookupWidth)) *
        frame.planetRadius * (float(frame.resolution.y) * 0.5) /
        max(outerNear, frame.planetRadius * 0.02);
    uint level = projectedBasePixels < 0.35 ? 2u
               : projectedBasePixels < 0.70 ? 1u : 0u;
    uint packed = farFieldNode(direction, level);
    height = (packed >> 6u) & 0x3fu;
    material = (packed >> 12u) & 0xffu;
    surfaceRadius = frame.planetRadius *
        (1.0 - kScaleLabRadialDepth +
         float(height) * (kScaleLabRadialDepth / 32.0));
    float ignoredFar = 0.0;
    if (!raySphereInterval(cameraPosition, rayDirection, surfaceRadius,
                           hitDistance, ignoredFar)) {
        // The fine aggregate can lie below a grazing ray even when a nearby
        // leaf peak is visible. Fall back to the hierarchy root envelope,
        // whose max cap is the legal outer radial layer. This is conservative
        // (never a sky leak); the narrow outer silhouette band still refines
        // through exact event-DDA in the caller.
        height = 32u;
        surfaceRadius = frame.planetRadius;
        float conservativeNear = 0.0;
        float conservativeFar = 0.0;
        conservativeOverlap = raySphereInterval(
            cameraPosition, rayDirection, frame.planetRadius,
            conservativeNear, conservativeFar);
        if (!conservativeOverlap) {
            return false;
        }
        hitDistance = conservativeNear;
    }
    hitNormal = normalize(cameraPosition + rayDirection * hitDistance);
    seedTile = lookupSurfaceTileSeed(hitNormal);
    return true;
}
#endif

bool clipConvexPlane(vec3 planeNormal, float planeDistance,
                     vec3 rayOrigin, vec3 rayDirection,
                     inout float nearDistance, inout float farDistance,
                     uint planeNeighbor,
                     inout vec3 nearNormal, inout uint nearNeighbor) {
    float originDistance = dot(planeNormal, rayOrigin) - planeDistance;
    float denominator = dot(planeNormal, rayDirection);
    if (denominator == 0.0) {
        return originDistance <= 0.0;
    }
    float nearSide = fma(denominator, nearDistance, originDistance);
    float farSide = fma(denominator, farDistance, originDistance);
    if (nearSide <= 0.0 && farSide <= 0.0) {
        return true;
    }
    if (nearSide > 0.0 && farSide > 0.0) {
        return false;
    }
    float distance = -originDistance / denominator;
    if (isnan(distance) || isinf(distance)) {
        return false;
    }
    distance = clamp(distance, nearDistance, farDistance);
    if (nearSide > 0.0) {
        if (distance > nearDistance) {
            nearDistance = distance;
            nearNormal = planeNormal;
            nearNeighbor = planeNeighbor;
        }
    } else {
        farDistance = distance;
    }
    return nearDistance <= uintBitsToFloat(floatBitsToUint(farDistance) + 1u);
}

bool intersectGeodesicVoxel(uint tileIndex, float innerHeight, float outerHeight,
                            float tangentGap, vec3 rayOrigin, vec3 rayDirection,
                            out float hitDistance, out vec3 hitNormal,
                            out uint hitNeighbor) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    float nearDistance = 0.0;
    float farDistance = kFarDistance;
    vec3 nearNormal = vec3(0.0);
    uint nearNeighbor = 0xffffffffu;
    if (!clipConvexPlane(tile.center.xyz, outerHeight, rayOrigin, rayDirection,
                         nearDistance, farDistance, 0xffffffffu,
                         nearNormal, nearNeighbor) ||
        !clipConvexPlane(-tile.center.xyz, -innerHeight, rayOrigin, rayDirection,
                         nearDistance, farDistance, 0xffffffffu,
                         nearNormal, nearNeighbor)) {
        return false;
    }
    for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
        uint neighbor = tileNeighbor(tile, slot);
        vec3 neighborCenter = geodesicTiles[neighbor].center.xyz;
        vec3 inwardPlane = tile.center.xyz - neighborCenter;
        float planeLength = length(inwardPlane);
        if (!clipConvexPlane(-inwardPlane, -tangentGap * planeLength,
                             rayOrigin, rayDirection,
                             nearDistance, farDistance, neighbor,
                             nearNormal, nearNeighbor)) {
            return false;
        }
    }
    hitDistance = nearDistance;
    hitNormal = nearNormal;
    hitNeighbor = nearNeighbor;
    return hitDistance >= 0.0 && hitDistance < kFarDistance;
}

#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
void productionTerrainShadowControls(out bool enabled, out uint steps,
                                     out float maximumDistance,
                                     out float strength) {
    uint controls = (floatBitsToUint(frame.brushNdc.y) >> 24u) & 0xffu;
    uint quality = (controls >> 1u) & 0x3u;
    enabled = (controls & 0x1u) != 0u && quality != 0u;
    steps = quality == 1u ? 4u : quality == 2u ? 8u : 16u;
    float distanceControl = float((controls >> 3u) & 0x7u) / 7.0;
    maximumDistance = frame.planetRadius * mix(0.01, 0.12,
                                               distanceControl);
    strength = float((controls >> 6u) & 0x3u) / 3.0;
}

bool productionTerrainColumnBlocksSun(uint tileIndex, vec3 rayOrigin,
                                      vec3 sunDirection,
                                      float maximumDistance) {
    uvec4 state = geodesicColumnStates[tileIndex];
    if (state.y == 0u) {
        return false;
    }
    GeodesicTile tile = geodesicTiles[tileIndex];
    float totalDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerThickness = totalDepth / float(geodesicTileLayerCount(tile));
    float columnBase = frame.planetRadius - totalDepth;
    float tangentGap = -frame.planetRadius * 2e-6;
    float radialGap = -layerThickness * 2e-5;
    float innerHeight = columnBase + radialGap;
    float outerHeight = columnBase + float(state.y) * layerThickness - radialGap;
    // Cheap radial-line broad phase before the exact convex-prism clip.
    vec3 radial = normalize(tile.center.xyz);
    float alignment = dot(sunDirection, radial);
    float denominator = max(1.0 - alignment * alignment, 1e-6);
    float rayProjection = dot(rayOrigin, sunDirection);
    float radialProjection = dot(rayOrigin, radial);
    float candidateTravel = (alignment * radialProjection - rayProjection) /
                            denominator;
    if (!(candidateTravel > frame.hitEpsilon) ||
        candidateTravel > maximumDistance) {
        return false;
    }
    float candidateRadius = radialProjection + alignment * candidateTravel;
    vec3 separation = rayOrigin + sunDirection * candidateTravel -
                      radial * candidateRadius;
    float conservativeWidth = geodesicTileSurfaceWidth(tile) *
        frame.planetRadius * 0.82;
    if (dot(separation, separation) >
            conservativeWidth * conservativeWidth ||
        outerHeight + layerThickness < candidateRadius) {
        return false;
    }
    float hitDistance = 0.0;
    vec3 hitNormal = vec3(0.0);
    uint hitNeighbor = 0xffffffffu;
    return intersectGeodesicVoxel(
               tileIndex, innerHeight, outerHeight, tangentGap,
               rayOrigin, sunDirection, hitDistance, hitNormal, hitNeighbor) &&
           hitDistance > frame.hitEpsilon && hitDistance <= maximumDistance;
}

float productionTerrainSunVisibility(vec3 position, vec3 sunDirection,
                                     uint startTile) {
    bool enabled;
    uint maximumSteps;
    float maximumDistance;
    float strength;
    productionTerrainShadowControls(enabled, maximumSteps,
                                    maximumDistance, strength);
    if (!enabled || !(maximumDistance > 0.0)) {
        return 1.0;
    }
    // Quantize the origin direction to the authoritative geodesic column.
    // Visibility is therefore identical for every camera ray hitting the same
    // column/radius and cannot crawl as a screen-space shadow speckle.
    vec3 stableOrigin = normalize(geodesicTiles[startTile].center.xyz) *
                        length(position);
    vec3 rayOrigin = stableOrigin + sunDirection *
        max(frame.hitEpsilon * 4.0, frame.planetRadius * 2e-5);
    uint current = startTile;
    uint previous = 0xffffffffu;
    for (uint stepIndex = 0u; stepIndex < 16u; ++stepIndex) {
        if (stepIndex >= maximumSteps) {
            break;
        }
        float probeDistance = maximumDistance *
            float(stepIndex + 1u) / float(maximumSteps);
        vec3 targetDirection = normalize(rayOrigin +
                                         sunDirection * probeDistance);
        GeodesicTile currentTile = geodesicTiles[current];
        uint count = clamp(geodesicTileNeighborCount(currentTile), 5u, 6u);
        uint best = current;
        uint second = 0xffffffffu;
        float bestScore = dot(normalize(currentTile.center.xyz),
                              targetDirection);
        float secondScore = -2.0;
        for (uint slot = 0u; slot < count; ++slot) {
            uint neighbor = tileNeighbor(currentTile, slot);
            if (neighbor == previous) {
                continue;
            }
            float score = dot(normalize(geodesicTiles[neighbor].center.xyz),
                              targetDirection);
            if (score > bestScore) {
                second = best == current ? second : best;
                secondScore = best == current ? secondScore : bestScore;
                best = neighbor;
                bestScore = score;
            } else if (score > secondScore) {
                second = neighbor;
                secondScore = score;
            }
        }
        if (best == current) {
            break;
        }
        if (productionTerrainColumnBlocksSun(
                best, rayOrigin, sunDirection, maximumDistance) ||
            (second != 0xffffffffu && second != current &&
             productionTerrainColumnBlocksSun(
                 second, rayOrigin, sunDirection, maximumDistance))) {
            return 0.0;
        }
        previous = current;
        current = best;
    }
    return 1.0;
}

struct ProductionCloudSettings {
    bool enabled;
    bool authoredSource;
    uint viewSteps;
    uint shadowSteps;
    uint debugMode;
    float coverage;
    float density;
    float baseAltitude;
    float topAltitude;
    float shapeScale;
    float detailStrength;
    float windSpeed;
    float windDirection;
    float shadowStrength;
};

ProductionCloudSettings productionCloudSettings() {
    ProductionCloudSettings settings;
    uint word0 = frame.surfaceTileCount;
    uint word1 = frame.residentPageCount;
    uint controls = (word1 >> 24u) & 0xffu;
    uint viewQuality = (controls >> 2u) & 0x3u;
    uint shadowQuality = (controls >> 4u) & 0x3u;
    settings.enabled = (controls & 0x1u) != 0u && viewQuality != 0u;
    settings.authoredSource = (controls & 0x2u) != 0u;
    settings.viewSteps = viewQuality == 1u ? 3u
                       : viewQuality == 2u ? 6u : 10u;
    settings.shadowSteps = shadowQuality == 0u ? 0u
                         : shadowQuality == 1u ? 2u
                         : shadowQuality == 2u ? 4u : 6u;
    settings.debugMode = (controls >> 6u) & 0x3u;
    settings.coverage = float(word0 & 0xffu) / 255.0;
    settings.density = float((word0 >> 8u) & 0xffu) * (3.0 / 255.0);
    settings.baseAltitude = float((word0 >> 16u) & 0xffu) *
                            (0.25 / 255.0);
    settings.topAltitude = float((word0 >> 24u) & 0xffu) *
                           (0.30 / 255.0);
    settings.shapeScale = 1.0 + float(word1 & 0xffu) * (15.0 / 255.0);
    settings.detailStrength = float((word1 >> 8u) & 0xffu) / 255.0;
    settings.windSpeed = float((word1 >> 16u) & 0xffu) * (0.10 / 255.0);
    settings.windDirection = float((frame.streamSamplePhase >> 8u) & 0xffu) *
                             (2.0 * kPi / 255.0);
    settings.shadowStrength =
        float((frame.streamSamplePhase >> 16u) & 0xffu) / 255.0;
    return settings;
}

float productionCloudProceduralDensity(vec3 position,
                                       ProductionCloudSettings settings) {
    float terrainRadius = frame.planetRadius * frame.planetOuterScale;
    float radius = length(position);
    float baseRadius = terrainRadius + frame.planetRadius * settings.baseAltitude;
    float topRadius = terrainRadius + frame.planetRadius *
        max(settings.topAltitude, settings.baseAltitude + 0.005);
    if (radius < baseRadius || radius > topRadius) {
        return 0.0;
    }
    float height = clamp((radius - baseRadius) /
                         max(topRadius - baseRadius, 1e-6), 0.0, 1.0);
    float vertical = smoothstep(0.0, 0.16, height) *
                     (1.0 - smoothstep(0.72, 1.0, height));
    vec3 p = position / frame.planetRadius;
    vec2 wind = vec2(cos(settings.windDirection),
                     sin(settings.windDirection)) *
                (settings.windSpeed * frame.time);
    p.xz += wind;
    float scale = settings.shapeScale;
    float shape = 0.5 +
        0.25 * sin(scale * dot(p, vec3(1.17, 0.73, -0.91))) +
        0.16 * sin(scale * dot(p, vec3(0.43, -1.31, 0.67)) + 1.7) +
        0.09 * sin(scale * 2.13 * dot(p, vec3(1.0)) - 0.8);
    float detail = 0.5 + 0.5 * sin(
        scale * 4.7 * dot(p, vec3(0.81, -0.57, 1.11)));
    float threshold = 1.0 - settings.coverage;
    return clamp((shape - threshold) * 2.4 +
                 (detail - 0.5) * settings.detailStrength,
                 0.0, 1.0) * vertical;
}

float productionCloudDensity(vec3 position,
                             ProductionCloudSettings settings) {
    // The source switch is deliberately centralized. Until a descriptor for
    // an authored 3D texture is bound, that mode falls back to the identical
    // procedural field instead of sampling invalid memory or fake geometry.
    return productionCloudProceduralDensity(position, settings);
}

bool productionCloudShellSegments(
    vec3 origin, vec3 direction, float maximumDistance,
    ProductionCloudSettings settings,
    out vec2 firstSegment, out vec2 secondSegment) {
    firstSegment = vec2(0.0);
    secondSegment = vec2(0.0);
    float terrainRadius = frame.planetRadius * frame.planetOuterScale;
    float innerRadius = terrainRadius + frame.planetRadius * settings.baseAltitude;
    float outerRadius = terrainRadius + frame.planetRadius *
        max(settings.topAltitude, settings.baseAltitude + 0.005);
    float outerNear = 0.0;
    float outerFar = 0.0;
    if (!raySphereInterval(origin, direction, outerRadius,
                           outerNear, outerFar)) {
        return false;
    }
    outerNear = max(outerNear, 0.0);
    outerFar = min(outerFar, maximumDistance);
    if (!(outerFar > outerNear)) {
        return false;
    }
    float innerNear = 0.0;
    float innerFar = 0.0;
    if (!raySphereInterval(origin, direction, innerRadius,
                           innerNear, innerFar)) {
        firstSegment = vec2(outerNear, outerFar);
        return true;
    }
    float firstFar = min(outerFar, innerNear);
    if (firstFar > outerNear) {
        firstSegment = vec2(outerNear, firstFar);
    }
    float secondNear = max(outerNear, innerFar);
    if (outerFar > secondNear) {
        if (firstSegment.y > firstSegment.x) {
            secondSegment = vec2(secondNear, outerFar);
        } else {
            firstSegment = vec2(secondNear, outerFar);
        }
    }
    return firstSegment.y > firstSegment.x ||
           secondSegment.y > secondSegment.x;
}

float productionCloudPathSample(vec2 firstSegment, vec2 secondSegment,
                                float fraction, out float totalLength) {
    float firstLength = max(firstSegment.y - firstSegment.x, 0.0);
    float secondLength = max(secondSegment.y - secondSegment.x, 0.0);
    totalLength = firstLength + secondLength;
    float pathDistance = clamp(fraction, 0.0, 1.0) * totalLength;
    return pathDistance <= firstLength || !(secondLength > 0.0)
        ? firstSegment.x + min(pathDistance, firstLength)
        : secondSegment.x + (pathDistance - firstLength);
}

float productionCloudSunTransmittance(vec3 position, vec3 sunDirection,
                                      ProductionCloudSettings settings) {
    if (!settings.enabled || settings.shadowSteps == 0u ||
        !(settings.density > 0.0)) {
        return 1.0;
    }
    vec2 firstSegment;
    vec2 secondSegment;
    if (!productionCloudShellSegments(
            position, sunDirection, kFarDistance, settings,
            firstSegment, secondSegment)) {
        return 1.0;
    }
    float totalLength = 0.0;
    productionCloudPathSample(firstSegment, secondSegment, 0.5, totalLength);
    float shellThickness = frame.planetRadius *
        max(settings.topAltitude - settings.baseAltitude, 0.005);
    float opticalDepth = 0.0;
    for (uint sampleIndex = 0u; sampleIndex < 8u; ++sampleIndex) {
        if (sampleIndex >= settings.shadowSteps) {
            break;
        }
        float distance = productionCloudPathSample(
            firstSegment, secondSegment,
            (float(sampleIndex) + 0.5) / float(settings.shadowSteps),
            totalLength);
        opticalDepth += productionCloudDensity(
            position + sunDirection * distance, settings);
    }
    opticalDepth *= settings.density * totalLength /
                    (shellThickness * float(settings.shadowSteps));
    return exp(-clamp(opticalDepth, 0.0, 32.0));
}
#endif

void considerTileVoxels(uint tileIndex, vec3 rayOrigin, vec3 rayDirection,
                        inout float closestDistance, inout vec3 closestNormal,
                        inout uint closestTile, inout uint closestLayer,
                        inout uint closestMaterial) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    float totalDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerThickness = totalDepth / float(geodesicTileLayerCount(tile));
    float columnBase = frame.planetRadius - totalDepth;
    // Adjacent columns use opposite half-spaces of the same bisector plane,
    // and radial layers reuse the same cap plane. Zero inset makes the voxel
    // complex watertight instead of drawing intentionally separated blocks.
    const float tangentGap = -frame.planetRadius * 2e-6;
    const float radialGap = -layerThickness * 2e-5;

    uvec4 columnState = geodesicColumnStates[tileIndex];
    if (columnState.y == 0u) {
        return;
    }
    int highestFilledLayer = int(columnState.y - 1u);

    // The initialization and falling-material columns are bottom-contiguous.
    // Their union is one convex prism/frustum, so intersect it once and recover
    // the radial layer from the actual hit position.
    float innerHeight = columnBase + radialGap;
    float outerHeight = columnBase + float(highestFilledLayer + 1) * layerThickness - radialGap;
    float candidateDistance = 0.0;
    vec3 candidateNormal = vec3(0.0);
    uint candidateNeighbor = 0xffffffffu;
    bool candidateHit = intersectGeodesicVoxel(
        tileIndex, innerHeight, outerHeight, tangentGap,
        rayOrigin, rayDirection,
        candidateDistance, candidateNormal, candidateNeighbor);
#if VOXEL_GLOBAL_METRIC_LAB
    // Content rays are repaired to begin outside the conservative shell. An
    // overlap prism can nevertheless report its exit plane before the actual
    // owning entry plane. Reject that candidate here so traversal can keep
    // considering the following exact owner instead of converting the final
    // result to sky after the walk has already ended.
    candidateHit = candidateHit && !any(isnan(candidateNormal)) &&
        !any(isinf(candidateNormal)) &&
        dot(candidateNormal, rayDirection) < 0.0;
#endif
    if (candidateHit && candidateDistance < closestDistance) {
        vec3 hitPosition = rayOrigin + rayDirection * candidateDistance;
        float layerCoordinate = (dot(hitPosition, tile.center.xyz) - columnBase) /
                                layerThickness;
        uint layer = uint(clamp(floor(layerCoordinate), 0.0,
                                float(highestFilledLayer)));
        closestDistance = candidateDistance;
        closestNormal = candidateNormal;
        closestTile = tileIndex;
        // Pack the side-face neighbor with the radial layer. Intersection has
        // already identified this plane, avoiding another five/six-neighbor
        // search during shading.
        closestLayer = layer |
            (candidateNeighbor == 0xffffffffu ? 0u : (candidateNeighbor + 1u) << 6u);
        // Rendering resolves the compact column profile identically for a
        // resident or nonresident page. Detailed pages still hold the same
        // cells for editing/simulation, but cache movement cannot change a
        // visible layer from surface material to rock or back.
        closestMaterial = geodesicMaterialForLayer(
            columnState.y, columnState.z & 0xffu, layer);
    }
}

bool considerConvergedSurfaceCap(float seedDistance,
                                 vec3 cameraPosition, vec3 rayDirection,
                                 float farDistance,
                                 inout float closestDistance,
                                 inout vec3 closestNormal,
                                 inout uint closestTile,
                                 inout uint closestLayer,
                                 inout uint closestMaterial) {
    if (seedDistance < 0.0 || seedDistance > farDistance) {
        return false;
    }
    uint owner = findSurfaceTile(normalize(
        cameraPosition + rayDirection * seedDistance));
    for (uint iteration = 0u; iteration < 12u; ++iteration) {
        considerTileVoxels(owner, cameraPosition, rayDirection,
                           closestDistance, closestNormal, closestTile,
                           closestLayer, closestMaterial);
        GeodesicTile ownerTile = geodesicTiles[owner];
        uvec4 ownerState = geodesicColumnStates[owner];
        if (ownerState.y == 0u) {
            return closestDistance < kFarDistance;
        }
        float ownerDepth = geodesicTileRadialDepth(ownerTile) * frame.planetRadius;
        float ownerLayerHeight = ownerDepth /
                                 float(geodesicTileLayerCount(ownerTile));
        float ownerOuterHeight = frame.planetRadius - ownerDepth +
            float(ownerState.y) * ownerLayerHeight + ownerLayerHeight * 2e-5;
        float denominator = dot(ownerTile.center.xyz, rayDirection);
        if (denominator >= -1e-8) {
            return closestDistance < kFarDistance;
        }
        float capDistance = (ownerOuterHeight -
            dot(ownerTile.center.xyz, cameraPosition)) / denominator;
        if (capDistance < 0.0 || capDistance > farDistance) {
            return closestDistance < kFarDistance;
        }
        uint refinedOwner = findSurfaceTile(normalize(
            cameraPosition + rayDirection * capDistance));
        if (refinedOwner == owner) {
            return closestDistance < kFarDistance;
        }
        owner = refinedOwner;
    }
    return closestDistance < kFarDistance;
}

bool considerShellOwnerRings(vec3 cameraPosition, vec3 rayDirection,
                             inout float closestDistance,
                             inout vec3 closestNormal,
                             inout uint closestTile,
                             inout uint closestLayer,
                             inout uint closestMaterial) {
    for (uint radialSample = 0u; radialSample < 9u; ++radialSample) {
        float sampleRadius = frame.planetRadius *
            (0.94 + float(radialSample) * 0.01);
        float sampleNear = 0.0;
        float sampleFar = 0.0;
        if (!raySphereInterval(cameraPosition, rayDirection,
                               sampleRadius, sampleNear, sampleFar)) {
            continue;
        }
        uint sampleOwner = findSurfaceTile(normalize(
            cameraPosition + rayDirection * sampleNear));
        considerTileVoxels(sampleOwner, cameraPosition, rayDirection,
                           closestDistance, closestNormal, closestTile,
                           closestLayer, closestMaterial);
        GeodesicTile sampleTile = geodesicTiles[sampleOwner];
        for (uint slot = 0u;
             slot < geodesicTileNeighborCount(sampleTile); ++slot) {
            considerTileVoxels(tileNeighbor(sampleTile, slot),
                               cameraPosition, rayDirection,
                               closestDistance, closestNormal, closestTile,
                               closestLayer, closestMaterial);
        }
    }
    return closestDistance < kFarDistance;
}

float columnOuterHeight(uint tileIndex) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    uvec4 state = geodesicColumnStates[tileIndex];
    float depth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerHeight = depth / float(geodesicTileLayerCount(tile));
    return frame.planetRadius - depth +
        float(state.y) * layerHeight + layerHeight * 2e-5;
}

bool considerTerrainGatedShellOwners(
    vec3 cameraPosition, vec3 rayDirection,
    inout float closestDistance, inout vec3 closestNormal,
    inout uint closestTile, inout uint closestLayer,
    inout uint closestMaterial) {
    float closestParameter = max(-dot(cameraPosition, rayDirection), 0.0);
    vec3 closestPosition = cameraPosition + rayDirection * closestParameter;
    float closestRadius = length(closestPosition);
    if (closestRadius > frame.planetRadius * 1.02) {
        return false;
    }
    vec3 closestDirection = normalize(closestPosition);
    uint seed = lookupSurfaceTileSeed(closestDirection);
    GeodesicTile seedTile = geodesicTiles[seed];
    float maximumOuterHeight = columnOuterHeight(seed);
    float maximumLayerHeight = geodesicTileRadialDepth(seedTile) *
        frame.planetRadius / float(geodesicTileLayerCount(seedTile));
    for (uint slot = 0u;
         slot < geodesicTileNeighborCount(seedTile); ++slot) {
        uint neighbor = tileNeighbor(seedTile, slot);
        GeodesicTile neighborTile = geodesicTiles[neighbor];
        maximumOuterHeight = max(maximumOuterHeight,
                                 columnOuterHeight(neighbor));
        maximumLayerHeight = max(maximumLayerHeight,
            geodesicTileRadialDepth(neighborTile) * frame.planetRadius /
                float(geodesicTileLayerCount(neighborTile)));
    }
    if (closestRadius > maximumOuterHeight + maximumLayerHeight * 16.0) {
        return false;
    }
    return considerShellOwnerRings(
        cameraPosition, rayDirection,
        closestDistance, closestNormal, closestTile,
        closestLayer, closestMaterial);
}

#if VOXEL_ENABLE_REFERENCE_TRAVERSAL
float bvhNodeNearDistance(GeodesicBvhNode node, vec3 rayOrigin,
                          vec3 rayDirection, float maximumDistance) {
    vec3 magnitude = 1.0 / max(abs(rayDirection), vec3(1e-8));
    vec3 inverseDirection = mix(-magnitude, magnitude,
                                greaterThanEqual(rayDirection, vec3(0.0)));
    vec3 nodeMinimum = node.minimum.xyz * frame.planetRadius;
    vec3 nodeMaximum = node.maximum.xyz * frame.planetRadius;
    vec3 first = (nodeMinimum - rayOrigin) * inverseDirection;
    vec3 second = (nodeMaximum - rayOrigin) * inverseDirection;
    vec3 nearVector = min(first, second);
    vec3 farVector = max(first, second);
    float nearDistance = max(nearVector.x, max(nearVector.y, nearVector.z));
    float farDistance = min(farVector.x, min(farVector.y, farVector.z));
    if (farDistance < max(nearDistance, 0.0) || nearDistance > maximumDistance) {
        return kFarDistance;
    }
    return max(nearDistance, 0.0);
}

float wideNodeNearDistance(GeodesicWideNode node, vec3 rayOrigin,
                           vec3 rayDirection, float maximumDistance) {
    vec3 magnitude = 1.0 / max(abs(rayDirection), vec3(1e-8));
    vec3 inverseDirection = mix(-magnitude, magnitude,
                                greaterThanEqual(rayDirection, vec3(0.0)));
    vec3 nodeMinimum = node.minimum.xyz * frame.planetRadius;
    vec3 nodeMaximum = node.maximum.xyz * frame.planetRadius;
    vec3 first = (nodeMinimum - rayOrigin) * inverseDirection;
    vec3 second = (nodeMaximum - rayOrigin) * inverseDirection;
    vec3 nearVector = min(first, second);
    vec3 farVector = max(first, second);
    float nearDistance = max(nearVector.x, max(nearVector.y, nearVector.z));
    float farDistance = min(farVector.x, min(farVector.y, farVector.z));
    if (farDistance < max(nearDistance, 0.0) || nearDistance > maximumDistance) {
        return kFarDistance;
    }
    return max(nearDistance, 0.0);
}

void traceWideGeodesic(vec3 cameraPosition, vec3 rayDirection,
                       inout float closestDistance, inout vec3 closestNormal,
                       inout uint closestTile, inout uint closestLayer,
                       inout uint closestMaterial) {
    uint nodeIndex = 0u;
    uint hierarchyEnd = geodesicWideNodes[0].data.z;
    while (nodeIndex < hierarchyEnd) {
        GeodesicWideNode node = geodesicWideNodes[nodeIndex];
        if (wideNodeNearDistance(node, cameraPosition, rayDirection,
                                 closestDistance) >= kFarDistance) {
            nodeIndex = node.data.z;
            continue;
        }
        if (node.data.w != 0u) {
            uint activeLow = node.mask.x;
            uint activeHigh = node.mask.y;
            for (uint slot = 0u; slot < node.data.y; ++slot) {
                bool itemActive = slot < 32u
                                      ? (activeLow & (1u << slot)) != 0u
                                      : (activeHigh & (1u << (slot - 32u))) != 0u;
                if (itemActive) {
                    considerTileVoxels(geodesicWideItems[node.data.x + slot],
                                       cameraPosition, rayDirection,
                                       closestDistance, closestNormal, closestTile,
                                       closestLayer, closestMaterial);
                }
            }
            ++nodeIndex;
        } else {
            nodeIndex = node.data.x;
        }
    }
}
#endif

void traceGeodesicDda(vec3 cameraPosition, vec3 rayDirection,
                      inout float closestDistance, inout vec3 closestNormal,
                      inout uint closestTile, inout uint closestLayer,
                      inout uint closestMaterial) {
    float travel = 0.0;
    float farDistance = 0.0;
    float outerRadius = frame.planetRadius * frame.planetOuterScale;
    if (!raySphereInterval(cameraPosition, rayDirection, outerRadius,
                           travel, farDistance)) {
        traversalTermination = 1u;
        return;
    }
#if VOXEL_SCALE_LAB
    travel = conservativeHierarchyAdvance(cameraPosition, rayDirection,
                                          travel, farDistance);
#endif
    traversalIntervalNear = travel;
    traversalIntervalFar = farDistance;
    float advanceEpsilon = max(frame.planetRadius * 2e-6, 1e-7);
    vec3 entryPosition = cameraPosition + rayDirection * (travel + advanceEpsilon);
    uint tileIndex = findSurfaceTile(normalize(entryPosition));
    uint previousTile = 0xffffffffu;

    // Grazing surface-player rays can cross hundreds of frequency-512 cells
    // before reaching a deep basin. Most rays still terminate in a few steps.
    for (uint step = 0u; step < kMaximumGeodesicDdaSteps && travel <= farDistance; ++step) {
        considerTileVoxels(tileIndex, cameraPosition, rayDirection,
                           closestDistance, closestNormal, closestTile,
                           closestLayer, closestMaterial);

        GeodesicTile tile = geodesicTiles[tileIndex];
        // The ordered owner graph is authoritative even when a grazing
        // multi-plane entry falls just behind the epsilon-advanced ray used by
        // the convex clip. If that advanced point is already inside a filled
        // radial interval but the exact prism test reported no hit, the lost
        // entry boundary is the current ordered travel distance. Recover it
        // immediately rather than letting the ray escape as a distant sky dot.
        if (closestDistance >= kFarDistance) {
            uvec4 orderedState = geodesicColumnStates[tileIndex];
            if (orderedState.y != 0u) {
                float orderedDepth = geodesicTileRadialDepth(tile) *
                                     frame.planetRadius;
                float orderedLayerHeight = orderedDepth /
                    float(geodesicTileLayerCount(tile));
                float orderedBase = frame.planetRadius - orderedDepth;
                float orderedProbeDistance = min(
                    travel + advanceEpsilon, farDistance);
                vec3 orderedPosition = cameraPosition +
                    rayDirection * orderedProbeDistance;
                float orderedLayerCoordinate =
                    (dot(orderedPosition, tile.center.xyz) - orderedBase) /
                    orderedLayerHeight;
                if (orderedLayerCoordinate >= -2e-4 &&
                    orderedLayerCoordinate < float(orderedState.y) + 2e-4) {
                    uint orderedLayer = uint(clamp(
                        floor(orderedLayerCoordinate), 0.0,
                        float(orderedState.y - 1u)));
                    closestDistance = max(travel, 0.0);
                    closestNormal = tile.center.xyz;
                    closestTile = tileIndex;
                    closestLayer = orderedLayer;
                    closestMaterial = geodesicMaterialForLayer(
                        orderedState.y, orderedState.z & 0xffu,
                        orderedLayer);
                    traversalTermination = 2u;
                    return;
                }
            }
        }
        // Side-plane traversal is valid only inside the conservative radial
        // interval. Never select or advance to a chart crossing beyond it.
        float exitDistance = farDistance;
        uint exitTile = 0xffffffffu;
        uint boundaryTile0 = 0xffffffffu;
        uint boundaryTile1 = 0xffffffffu;
        float overlapTolerance = max(frame.planetRadius * 2e-5, advanceEpsilon);
        for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
            uint adjacent = tileNeighbor(tile, slot);
            vec3 inward = tile.center.xyz - geodesicTiles[adjacent].center.xyz;
            float planeLengthSquared = dot(inward, inward);
            float denominator = dot(inward, rayDirection);
            float originPlaneDistance = dot(inward, cameraPosition);
            float stepPlaneDistance = originPlaneDistance +
                denominator * (travel + advanceEpsilon);
            float boundaryTolerance = frame.planetRadius * 1e-5;
            bool inBoundaryBand = stepPlaneDistance * stepPlaneDistance <
                boundaryTolerance * boundaryTolerance * planeLengthSquared;
            bool nearlyParallel = denominator * denominator <
                1e-8 * planeLengthSquared;
            if (inBoundaryBand &&
                (adjacent != previousTile || nearlyParallel)) {
                if (boundaryTile0 == 0xffffffffu) {
                    boundaryTile0 = adjacent;
                } else if (adjacent != boundaryTile0) {
                    boundaryTile1 = adjacent;
                }
            }
            if (denominator >= 0.0) {
                continue;
            }
            float crossing = -originPlaneDistance / denominator;
            if (crossing > travel + advanceEpsilon && crossing < exitDistance) {
                exitDistance = crossing;
                exitTile = adjacent;
            }
        }
        // At shallow horizons the angular owner can change between the DDA
        // interval seed and the radial cap crossing inside that interval. The
        // seeded prism then rejects a real cap even though its ordered distance
        // is valid. Resolve ownership at that exact cap point and test only the
        // owner ring that can participate in an edge/vertex event.
        if (closestDistance >= kFarDistance) {
            uvec4 intervalState = geodesicColumnStates[tileIndex];
            if (intervalState.y != 0u) {
                float intervalDepth = geodesicTileRadialDepth(tile) *
                                      frame.planetRadius;
                float intervalLayerHeight = intervalDepth /
                    float(geodesicTileLayerCount(tile));
                float intervalOuterHeight = frame.planetRadius - intervalDepth +
                    float(intervalState.y) * intervalLayerHeight +
                    intervalLayerHeight * 2e-5;
                float intervalCapDenominator = dot(tile.center.xyz, rayDirection);
                if (intervalCapDenominator < -1e-8) {
                    float intervalCapDistance = (intervalOuterHeight -
                        dot(tile.center.xyz, cameraPosition)) /
                        intervalCapDenominator;
                    if (intervalCapDistance >= travel - overlapTolerance &&
                        intervalCapDistance <= exitDistance + overlapTolerance) {
                        considerConvergedSurfaceCap(
                            intervalCapDistance,
                            cameraPosition, rayDirection, farDistance,
                            closestDistance, closestNormal, closestTile,
                            closestLayer, closestMaterial);
                        uint intervalCapOwner = findSurfaceTile(normalize(
                            cameraPosition + rayDirection * intervalCapDistance));
                        considerTileVoxels(intervalCapOwner,
                                           cameraPosition, rayDirection,
                                           closestDistance, closestNormal, closestTile,
                                           closestLayer, closestMaterial);
                        GeodesicTile intervalOwnerTile =
                            geodesicTiles[intervalCapOwner];
                        for (uint ownerSlot = 0u;
                             ownerSlot < geodesicTileNeighborCount(intervalOwnerTile);
                             ++ownerSlot) {
                            considerTileVoxels(
                                tileNeighbor(intervalOwnerTile, ownerSlot),
                                cameraPosition, rayDirection,
                                closestDistance, closestNormal, closestTile,
                                closestLayer, closestMaterial);
                        }
                    }
                }
            }
        }
        // Only a taller exit neighbor can enter through its outer cap before
        // the expanded shared side reaches the exact bisector. A cheap cap
        // distance guard avoids a second convex intersection on ordinary DDA
        // steps while preserving nearest hits at tall cliff boundaries.
        if (exitTile != 0xffffffffu &&
            geodesicColumnStates[exitTile].y > geodesicColumnStates[tileIndex].y) {
            GeodesicTile exitGeodesicTile = geodesicTiles[exitTile];
            float exitTotalDepth = geodesicTileRadialDepth(exitGeodesicTile) *
                                   frame.planetRadius;
            float exitLayerThickness = exitTotalDepth /
                float(geodesicTileLayerCount(exitGeodesicTile));
            float exitOuterHeight = frame.planetRadius - exitTotalDepth +
                float(geodesicColumnStates[exitTile].y) * exitLayerThickness;
            float capDenominator = dot(exitGeodesicTile.center.xyz, rayDirection);
            if (capDenominator < -1e-8) {
                float capDistance = (exitOuterHeight -
                    dot(exitGeodesicTile.center.xyz, cameraPosition)) / capDenominator;
                if (capDistance >= travel - overlapTolerance &&
                    capDistance <= exitDistance + overlapTolerance) {
                    considerTileVoxels(exitTile, cameraPosition, rayDirection,
                                       closestDistance, closestNormal, closestTile,
                                       closestLayer, closestMaterial);
                }
            }
        }
        if (closestDistance > exitDistance + overlapTolerance) {
            if (boundaryTile0 != 0xffffffffu && boundaryTile0 != exitTile) {
                considerTileVoxels(boundaryTile0,
                                   cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
            }
            if (boundaryTile1 != 0xffffffffu &&
                boundaryTile1 != exitTile && boundaryTile1 != boundaryTile0) {
                considerTileVoxels(boundaryTile1,
                                   cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
            }
        }
        if (closestDistance <= exitDistance + overlapTolerance) {
            traversalTermination = 2u;
            return;
        }
        if (exitTile == 0xffffffffu) {
            // All side-plane derivatives are non-negative, so this ray stays
            // inside the current angular cone for the rest of the conservative
            // interval. Intersect its solid column cap directly. This covers a
            // grazing case where the general convex clip can reject a valid
            // cap after its radial near/far tolerances collapse, even though no
            // neighboring owner can ever take over.
            uvec4 terminalState = geodesicColumnStates[tileIndex];
            traversalTerminalCapDenominator = dot(tile.center.xyz, rayDirection);
            traversalTerminalCapDistance = kFarDistance;
            traversalTerminalConeMargin = kFarDistance;
            float nominalNear = 0.0;
            float nominalFar = 0.0;
            bool hasNominalInterval = raySphereInterval(
                cameraPosition, rayDirection, frame.planetRadius,
                nominalNear, nominalFar);
            if (hasNominalInterval &&
                considerConvergedSurfaceCap(
                    nominalNear, cameraPosition, rayDirection, farDistance,
                    closestDistance, closestNormal, closestTile,
                    closestLayer, closestMaterial)) {
                traversalTermination = 2u;
                return;
            }
            if (hasNominalInterval) {
                uint nominalOwner = findSurfaceTile(normalize(
                    cameraPosition + rayDirection * nominalNear));
                considerTileVoxels(nominalOwner, cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
                GeodesicTile nominalTile = geodesicTiles[nominalOwner];
                for (uint slot = 0u;
                     slot < geodesicTileNeighborCount(nominalTile); ++slot) {
                    considerTileVoxels(tileNeighbor(nominalTile, slot),
                                       cameraPosition, rayDirection,
                                       closestDistance, closestNormal, closestTile,
                                       closestLayer, closestMaterial);
                }
                if (closestDistance < kFarDistance) {
                    traversalTermination = 2u;
                    return;
                }
            }
            if (considerTerrainGatedShellOwners(
                    cameraPosition, rayDirection,
                    closestDistance, closestNormal, closestTile,
                    closestLayer, closestMaterial)) {
                traversalTermination = 2u;
                return;
            }
            float closedNear = 0.0;
            float closedFar = 0.0;
            if (raySphereInterval(cameraPosition, rayDirection,
                                  frame.planetRadius * 0.75,
                                  closedNear, closedFar)) {
                if (considerShellOwnerRings(
                        cameraPosition, rayDirection,
                        closestDistance, closestNormal, closestTile,
                        closestLayer, closestMaterial)) {
                    traversalTermination = 2u;
                    return;
                }
            }
            if (terminalState.y != 0u) {
                float totalDepth = geodesicTileRadialDepth(tile) *
                                   frame.planetRadius;
                float layerThickness = totalDepth /
                    float(geodesicTileLayerCount(tile));
                float radialGap = -layerThickness * 2e-5;
                float columnBase = frame.planetRadius - totalDepth;
                float outerHeight = frame.planetRadius - totalDepth +
                    float(terminalState.y) * layerThickness - radialGap;
                // Refinement at a multi-plane event may move into the correct
                // owner just beyond its entry plane. If that owner contains a
                // filled layer at the advanced point, reconstruct the exact
                // shared boundary crossing and accept it only when the prior
                // owner is empty at that radial layer (an exposed wall).
                vec3 terminalPosition = cameraPosition + rayDirection * travel;
                float terminalLayerCoordinate =
                    (dot(terminalPosition, tile.center.xyz) - columnBase) /
                    layerThickness;
                if (previousTile != 0xffffffffu &&
                    terminalLayerCoordinate >= -2e-4 &&
                    terminalLayerCoordinate < float(terminalState.y) + 2e-4) {
                    uint terminalLayer = uint(clamp(floor(terminalLayerCoordinate),
                                                     0.0,
                                                     float(terminalState.y - 1u)));
                    float minimumMargin = kFarDistance;
                    uint entryNeighbor = 0xffffffffu;
                    vec3 entryOutwardNormal = vec3(0.0);
                    for (uint slot = 0u;
                         slot < geodesicTileNeighborCount(tile); ++slot) {
                        uint adjacent = tileNeighbor(tile, slot);
                        vec3 inwardNormal = normalize(
                            tile.center.xyz - geodesicTiles[adjacent].center.xyz);
                        float margin = dot(inwardNormal, terminalPosition) -
                                       (-frame.planetRadius * 2e-6);
                        if (margin < minimumMargin) {
                            minimumMargin = margin;
                            entryNeighbor = adjacent;
                            entryOutwardNormal = -inwardNormal;
                        }
                    }
                    if (entryNeighbor != 0xffffffffu &&
                        minimumMargin >= -overlapTolerance &&
                        geodesicColumnStates[entryNeighbor].y <= terminalLayer) {
                        vec3 exactPlane = tile.center.xyz -
                                          geodesicTiles[entryNeighbor].center.xyz;
                        float exactDenominator = dot(exactPlane, rayDirection);
                        float entryDistance = abs(exactDenominator) > 1e-12
                            ? -dot(exactPlane, cameraPosition) / exactDenominator
                            : travel - advanceEpsilon;
                        if (entryDistance >= 0.0 &&
                            entryDistance <= travel + overlapTolerance) {
                            closestDistance = entryDistance;
                            closestNormal = entryOutwardNormal;
                            closestTile = tileIndex;
                            closestLayer = terminalLayer |
                                ((entryNeighbor + 1u) << 6u);
                            closestMaterial = geodesicMaterialForLayer(
                                terminalState.y, terminalState.z & 0xffu,
                                terminalLayer);
                            traversalTermination = 2u;
                            return;
                        }
                    }
                }
                float capDenominator = dot(tile.center.xyz, rayDirection);
                if (capDenominator < -1e-8) {
                    float capDistance = (outerHeight -
                        dot(tile.center.xyz, cameraPosition)) / capDenominator;
                    traversalTerminalCapDistance = capDistance;
                    if (capDistance >= 0.0 &&
                        capDistance <= farDistance + overlapTolerance) {
                        vec3 capProbe = cameraPosition + rayDirection * capDistance;
                        uint capOwner = findSurfaceTile(normalize(capProbe));
                        for (uint ownerIteration = 0u; ownerIteration < 8u;
                             ++ownerIteration) {
                            GeodesicTile ownerTile = geodesicTiles[capOwner];
                            uvec4 ownerState = geodesicColumnStates[capOwner];
                            if (ownerState.y == 0u) {
                                break;
                            }
                            float ownerDepth = geodesicTileRadialDepth(ownerTile) *
                                               frame.planetRadius;
                            float ownerLayerHeight = ownerDepth /
                                float(geodesicTileLayerCount(ownerTile));
                            float ownerOuterHeight = frame.planetRadius - ownerDepth +
                                float(ownerState.y) * ownerLayerHeight +
                                ownerLayerHeight * 2e-5;
                            float ownerDenominator = dot(ownerTile.center.xyz,
                                                         rayDirection);
                            if (ownerDenominator >= -1e-8) {
                                break;
                            }
                            float ownerCapDistance = (ownerOuterHeight -
                                dot(ownerTile.center.xyz, cameraPosition)) /
                                ownerDenominator;
                            if (ownerCapDistance < 0.0 ||
                                ownerCapDistance > farDistance + overlapTolerance) {
                                break;
                            }
                            uint refinedOwner = findSurfaceTile(normalize(
                                cameraPosition + rayDirection * ownerCapDistance));
                            if (refinedOwner == capOwner) {
                                break;
                            }
                            capOwner = refinedOwner;
                        }
                        considerTileVoxels(capOwner, cameraPosition, rayDirection,
                                           closestDistance, closestNormal, closestTile,
                                           closestLayer, closestMaterial);
                        if (closestDistance < kFarDistance) {
                            traversalTermination = 2u;
                            return;
                        }
                    }
                    if (capDistance >= travel - overlapTolerance &&
                        capDistance <= farDistance + overlapTolerance) {
                        vec3 capPosition = cameraPosition + rayDirection * capDistance;
                        bool insideCone = true;
                        const float tangentGap = -frame.planetRadius * 2e-6;
                        for (uint slot = 0u;
                             slot < geodesicTileNeighborCount(tile); ++slot) {
                            uint adjacent = tileNeighbor(tile, slot);
                            vec3 inwardNormal = normalize(
                                tile.center.xyz - geodesicTiles[adjacent].center.xyz);
                            insideCone = insideCone &&
                                dot(inwardNormal, capPosition) >=
                                    tangentGap - overlapTolerance;
                            traversalTerminalConeMargin = min(
                                traversalTerminalConeMargin,
                                dot(inwardNormal, capPosition) - tangentGap);
                        }
                        if (insideCone) {
                            closestDistance = capDistance;
                            closestNormal = tile.center.xyz;
                            closestTile = tileIndex;
                            closestLayer = terminalState.y - 1u;
                            closestMaterial = geodesicMaterialForLayer(
                                terminalState.y, terminalState.z & 0xffu,
                                closestLayer);
                            traversalTermination = 2u;
                            return;
                        }
                    }
                }
            }
            traversalTermination = 3u;
            traversalTerminalTile = tileIndex;
            traversalTerminalTravel = travel;
            traversalTerminalFar = farDistance;
            return;
        }
        travel = exitDistance + advanceEpsilon;
        vec3 nextPosition = cameraPosition + rayDirection * travel;
        if (dot(nextPosition, nextPosition) < advanceEpsilon * advanceEpsilon) {
            travel += advanceEpsilon * 16.0;
            nextPosition = cameraPosition + rayDirection * travel;
        }
        // Preserve the ordered graph transition instead of re-seeding from the
        // coarse spherical atlas. Local refinement handles vertex crossings
        // where the epsilon advance enters a second neighboring half-space.
        previousTile = tileIndex;
        tileIndex = refineSurfaceTile(exitTile, normalize(nextPosition));
    }
    if (considerTerrainGatedShellOwners(
            cameraPosition, rayDirection,
            closestDistance, closestNormal, closestTile,
            closestLayer, closestMaterial)) {
        traversalTermination = 2u;
        return;
    }
    traversalTermination = travel > farDistance ? 4u : 5u;
    traversalTerminalTile = tileIndex;
    traversalTerminalTravel = travel;
    traversalTerminalFar = farDistance;
}

float nextTravelUlp(float travel) {
    // Traversal distances are finite and non-negative. Incrementing their
    // IEEE-754 encoding is exactly nextafter(travel, +infinity).
    return uintBitsToFloat(floatBitsToUint(travel) + 1u);
}

bool eventDistanceTied(float first, float second) {
    if (first == second) {
        return true;
    }
    uint firstBits = floatBitsToUint(first);
    uint secondBits = floatBitsToUint(second);
    return max(firstBits, secondBits) - min(firstBits, secondBits) <= 4u;
}

bool tileOwnsAtTravel(uint tileIndex, vec3 rayOrigin,
                      vec3 rayDirection, float travel) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
        uint adjacent = tileNeighbor(tile, slot);
        vec3 plane = tile.center.xyz - geodesicTiles[adjacent].center.xyz;
        float signedDistance = dot(plane, rayOrigin) +
            dot(plane, rayDirection) * travel;
        // Shared faces are half-open: their lowest topology index owns the
        // exact plane. Edges/vertices inherit the same total ordering.
        if (signedDistance < 0.0 ||
            (signedDistance == 0.0 && tileIndex > adjacent)) {
            return false;
        }
    }
    return true;
}

bool tileOwnsAfterEvent(uint tileIndex, vec3 rayOrigin,
                        vec3 rayDirection, float eventDistance) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    float probeDistance = eventDistance;
    for (uint ulp = 0u; ulp < 4u; ++ulp) {
        probeDistance = nextTravelUlp(probeDistance);
    }
    for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
        uint adjacent = tileNeighbor(tile, slot);
        vec3 plane = tile.center.xyz - geodesicTiles[adjacent].center.xyz;
        float originDistance = dot(plane, rayOrigin);
        float derivative = dot(plane, rayDirection);
        // Classify the half-open interval a few representable distances
        // after the grouped event. This is division-free, handles parallel
        // planes explicitly, and expresses tolerance only in traversal ULPs.
        float signedDistance = fma(derivative, probeDistance, originDistance);
        if (signedDistance < 0.0 ||
            (signedDistance == 0.0 &&
             (derivative < 0.0 ||
              (derivative == 0.0 && tileIndex > adjacent)))) {
            return false;
        }
    }
    return true;
}

uint canonicalSeedOwner(uint seedTile, vec3 rayOrigin,
                        vec3 rayDirection, float travel) {
    uint canonical = tileOwnsAtTravel(
        seedTile, rayOrigin, rayDirection, travel)
        ? seedTile : 0xffffffffu;
    GeodesicTile seed = geodesicTiles[seedTile];
    for (uint slot = 0u; slot < geodesicTileNeighborCount(seed); ++slot) {
        uint candidate = tileNeighbor(seed, slot);
        if (tileOwnsAtTravel(candidate, rayOrigin, rayDirection, travel) &&
            (canonical == 0xffffffffu || candidate < canonical)) {
            canonical = candidate;
        }
    }
    return canonical == 0xffffffffu ? seedTile : canonical;
}

bool occupiedCapMayOverlapInterval(uint tileIndex, vec3 rayOrigin,
                                   vec3 rayDirection, float intervalNear,
                                   float intervalFar) {
    GeodesicTile tile = geodesicTiles[tileIndex];
    uvec4 state = geodesicColumnStates[tileIndex];
    if (state.y == 0u) {
        return false;
    }
    float totalDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
    float layerThickness = totalDepth / float(geodesicTileLayerCount(tile));
    float outerHeight = frame.planetRadius - totalDepth +
        float(state.y) * layerThickness + layerThickness * 2e-5;
    float originProjection = dot(tile.center.xyz, rayOrigin);
    float directionProjection = dot(tile.center.xyz, rayDirection);
    float nearProjection = fma(directionProjection, intervalNear,
                               originProjection);
    float farProjection = fma(directionProjection, intervalFar,
                              originProjection);
    if (isnan(nearProjection) || isinf(nearProjection) ||
        isnan(farProjection) || isinf(farProjection)) {
        // A bad bound must refine, never skip potentially occupied geometry.
        if (frame.geodesicTraversalMode == 8u) {
            ++scaleBoundNonfinite;
        }
        return true;
    }
    if (min(nearProjection, farProjection) <= outerHeight) {
        return true;
    }
    return false;
}

void traceGeodesicEventDda(vec3 cameraPosition, vec3 rayDirection,
                           inout float closestDistance,
                           inout vec3 closestNormal,
                           inout uint closestTile,
                           inout uint closestLayer,
                           inout uint closestMaterial,
                           bool enableConservativeBound) {
    float travel = 0.0;
    float farDistance = 0.0;
    float outerRadius = frame.planetRadius * frame.planetOuterScale;
    if (!raySphereInterval(cameraPosition, rayDirection, outerRadius,
                           travel, farDistance)) {
        traversalTermination = 1u;
        return;
    }
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricTerrainInterval = 1u;
#endif
#if VOXEL_SCALE_LAB
    if (enableConservativeBound) {
        // Edits invalidate the cached hierarchy. The exact event-DDA is the
        // authoritative fallback; the broad phase never supplies a hit.
        if (geodesicFarField[0] == 0u) {
            travel = conservativeHierarchyAdvance(
                cameraPosition, rayDirection, travel, farDistance);
        }
    }
#endif
    traversalIntervalNear = travel;
    traversalIntervalFar = farDistance;

    // The spherical atlas is used exactly once. Every later owner transition
    // follows explicit topology adjacency.
    float seededTravel = nextTravelUlp(travel);
    vec3 seedPosition = cameraPosition + rayDirection * seededTravel;
    uint tileIndex = canonicalSeedOwner(
        findSurfaceTile(normalize(seedPosition)),
        cameraPosition, rayDirection, seededTravel);
    float previousEventDistance = travel;
    bool hasPreviousEvent = false;

    for (uint step = 0u;
         step < kMaximumGeodesicDdaSteps && travel <= farDistance; ++step) {
        scaleTraversalEvents = step + 1u;
#if !VOXEL_SCALE_LAB
        considerTileVoxels(tileIndex, cameraPosition, rayDirection,
                           closestDistance, closestNormal, closestTile,
                           closestLayer, closestMaterial);
#endif

        GeodesicTile tile = geodesicTiles[tileIndex];
        float eventDistance = farDistance;
        bool hasSideEvent = false;
        uint tiedOwners[6];
        uint tiedCount = 0u;
        uint overlapOwners[6];
        uint overlapCount = 0u;
        for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
            uint adjacent = tileNeighbor(tile, slot);
            vec3 plane = tile.center.xyz - geodesicTiles[adjacent].center.xyz;
            float denominator = dot(plane, rayDirection);
            float originDistance = dot(plane, cameraPosition);
            float geometricOverlap = frame.planetRadius * 2e-6;
            float intervalDistance = originDistance + denominator * travel;
            if (intervalDistance * intervalDistance <=
                geometricOverlap * geometricOverlap * dot(plane, plane)) {
                // Exact expanded-prism ownership, not a traversal tolerance.
#if VOXEL_SCALE_LAB
                overlapOwners[overlapCount++] = adjacent;
#else
                considerTileVoxels(adjacent, cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
#endif
            }
            if (denominator == 0.0) {
                continue;
            }
            if (denominator > 0.0) {
                continue;
            }
            float crossing = -originDistance / denominator;
            if (isnan(crossing) || isinf(crossing) ||
                crossing <= travel || crossing > farDistance) {
                continue;
            }
            if (!hasSideEvent ||
                (crossing < eventDistance &&
                 !eventDistanceTied(crossing, eventDistance))) {
                eventDistance = crossing;
                hasSideEvent = true;
                tiedOwners[0] = adjacent;
                tiedCount = 1u;
            } else if (eventDistanceTied(crossing, eventDistance)) {
                eventDistance = min(eventDistance, crossing);
                tiedOwners[tiedCount++] = adjacent;
            }
        }

#if VOXEL_SCALE_LAB
        if (occupiedCapMayOverlapInterval(tileIndex, cameraPosition,
                                          rayDirection, travel,
                                          eventDistance)) {
            considerTileVoxels(tileIndex, cameraPosition, rayDirection,
                               closestDistance, closestNormal, closestTile,
                               closestLayer, closestMaterial);
        }
        for (uint index = 0u; index < overlapCount; ++index) {
            uint adjacent = overlapOwners[index];
            if (occupiedCapMayOverlapInterval(adjacent, cameraPosition,
                                              rayDirection, travel,
                                              eventDistance)) {
                considerTileVoxels(adjacent, cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
            }
        }
#endif

        if (!hasSideEvent) {
            // A normal one-face event transitions directly. If finite
            // precision later strands that owner, resolve the preceding
            // event exactly here instead of paying six-plane ownership
            // validation at every ordinary step.
            if (closestDistance >= kFarDistance && hasPreviousEvent) {
                uint corrected = tileOwnsAfterEvent(
                    tileIndex, cameraPosition, rayDirection,
                    previousEventDistance) ? tileIndex : 0xffffffffu;
                for (uint slot = 0u; slot < geodesicTileNeighborCount(tile); ++slot) {
                    uint candidate = tileNeighbor(tile, slot);
                    if (tileOwnsAfterEvent(candidate, cameraPosition,
                                           rayDirection,
                                           previousEventDistance) &&
                        (corrected == 0xffffffffu || candidate < corrected)) {
                        corrected = candidate;
                    }
                }
                hasPreviousEvent = false;
                if (corrected != 0xffffffffu && corrected != tileIndex) {
                    tileIndex = corrected;
                    continue;
                }
            }
            if (closestDistance < kFarDistance) {
                traversalTermination = 2u;
                return;
            }
            traversalTermination = 3u;
            traversalTerminalTile = tileIndex;
            traversalTerminalTravel = travel;
            traversalTerminalFar = farDistance;
            return;
        }

        if (tiedCount > 1u) {
            for (uint index = 0u; index < tiedCount; ++index) {
                uint adjacent = tiedOwners[index];
#if VOXEL_SCALE_LAB
                if (occupiedCapMayOverlapInterval(adjacent, cameraPosition,
                                                  rayDirection, travel,
                                                  eventDistance)) {
                    considerTileVoxels(adjacent, cameraPosition, rayDirection,
                                       closestDistance, closestNormal, closestTile,
                                       closestLayer, closestMaterial);
                }
#else
                considerTileVoxels(adjacent, cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
#endif
            }
        }
        if (closestDistance < eventDistance ||
            eventDistanceTied(closestDistance, eventDistance)) {
            traversalTermination = 2u;
            return;
        }
        if (tiedCount == 0u) {
            traversalTermination = 3u;
            traversalTerminalTile = tileIndex;
            traversalTerminalTravel = travel;
            traversalTerminalFar = farDistance;
            return;
        }

        float nextTravel = nextTravelUlp(eventDistance);
        uint nextTile = 0xffffffffu;
        for (uint index = 0u; index < tiedCount; ++index) {
            uint candidate = tiedOwners[index];
            if (tileOwnsAfterEvent(candidate, cameraPosition,
                                   rayDirection, eventDistance) &&
                (nextTile == 0xffffffffu || candidate < nextTile)) {
                nextTile = candidate;
            }
        }
        if (nextTile == 0xffffffffu) {
            // A rejected entered owner is itself an ambiguous event signal.
            // Expand only this event's exact local topology ring.
            for (uint index = 0u; index < tiedCount; ++index) {
                GeodesicTile eventTile = geodesicTiles[tiedOwners[index]];
                for (uint slot = 0u;
                     slot < geodesicTileNeighborCount(eventTile); ++slot) {
                    uint candidate = tileNeighbor(eventTile, slot);
                    if (tileOwnsAfterEvent(candidate, cameraPosition,
                                           rayDirection, eventDistance) &&
                        (nextTile == 0xffffffffu || candidate < nextTile)) {
                        nextTile = candidate;
                    }
                }
            }
        }
        if (nextTile == 0xffffffffu) {
            nextTile = tiedOwners[0];
            for (uint index = 1u; index < tiedCount; ++index) {
                nextTile = min(nextTile, tiedOwners[index]);
            }
        }
        travel = nextTravel;
        previousEventDistance = eventDistance;
        hasPreviousEvent = true;
        tileIndex = nextTile;
    }

    traversalTermination = travel > farDistance ? 4u : 5u;
    traversalTerminalTile = tileIndex;
    traversalTerminalTravel = travel;
    traversalTerminalFar = farDistance;
}

void traceReliableGeodesicDda(vec3 cameraPosition, vec3 rayDirection,
                              inout float closestDistance, inout vec3 closestNormal,
                              inout uint closestTile, inout uint closestLayer,
                              inout uint closestMaterial) {
    traceGeodesicEventDda(cameraPosition, rayDirection,
                          closestDistance, closestNormal, closestTile,
                          closestLayer, closestMaterial, true);
}

vec3 shadeGeodesicPlanet(vec3 cameraPosition, vec3 rayDirection,
                         out bool hitPlanet, out uint hitClass,
                         out GeodesicHitDebug debugHit) {
    float closestDistance = kFarDistance;
    vec3 closestNormal = vec3(0.0);
    uint closestTile = 0u;
    uint closestLayer = 0u;
    uint closestMaterial = 0u;
    hitClass = 0u;
    debugHit.tile = 0xffffffffu;
    debugHit.layer = 0u;
    debugHit.neighbor = 0xffffffffu;
    debugHit.columnHeight = 0u;
    debugHit.neighborHeight = 0u;
    debugHit.material = 0u;
    debugHit.distance = kFarDistance;
    debugHit.geometryDetail = 0.0;
    debugHit.sideIncidence = 0.0;
    debugHit.projectedWidth = 0.0;
    debugHit.projectedHeight = 0.0;
    debugHit.sideMask = 0.0;
    debugHit.localInteriorPixels = 0.0;
    debugHit.normal = vec3(0.0);

#if VOXEL_ENABLE_REFERENCE_TRAVERSAL
    if (frame.geodesicTraversalMode == 2u) {
        traceReliableGeodesicDda(cameraPosition, rayDirection,
                                 closestDistance, closestNormal, closestTile,
                                 closestLayer, closestMaterial);
    } else if (frame.geodesicTraversalMode == 1u) {
        traceWideGeodesic(cameraPosition, rayDirection,
                          closestDistance, closestNormal, closestTile,
                          closestLayer, closestMaterial);
    } else {
        uint nodeStack[64];
        float distanceStack[64];
        uint stackSize = 0u;
        float rootDistance = bvhNodeNearDistance(
            geodesicBvhNodes[0], cameraPosition, rayDirection, closestDistance);
        if (rootDistance < kFarDistance) {
            nodeStack[stackSize] = 0u;
            distanceStack[stackSize++] = rootDistance;
        }
        while (stackSize > 0u) {
            --stackSize;
            uint nodeIndex = nodeStack[stackSize];
            float nodeDistance = distanceStack[stackSize];
            if (nodeDistance > closestDistance) {
                continue;
            }
            GeodesicBvhNode node = geodesicBvhNodes[nodeIndex];
            if (node.data.z != 0u) {
                considerTileVoxels(node.data.x, cameraPosition, rayDirection,
                                   closestDistance, closestNormal, closestTile,
                                   closestLayer, closestMaterial);
            } else {
                float leftDistance = bvhNodeNearDistance(
                    geodesicBvhNodes[node.data.x], cameraPosition, rayDirection, closestDistance);
                float rightDistance = bvhNodeNearDistance(
                    geodesicBvhNodes[node.data.y], cameraPosition, rayDirection, closestDistance);
                uint nearIndex = leftDistance <= rightDistance ? node.data.x : node.data.y;
                uint farIndex = leftDistance <= rightDistance ? node.data.y : node.data.x;
                float nearChildDistance = min(leftDistance, rightDistance);
                float farChildDistance = max(leftDistance, rightDistance);
                if (farChildDistance < kFarDistance) {
                    nodeStack[stackSize] = farIndex;
                    distanceStack[stackSize++] = farChildDistance;
                }
                if (nearChildDistance < kFarDistance) {
                    nodeStack[stackSize] = nearIndex;
                    distanceStack[stackSize++] = nearChildDistance;
                }
            }
        }
    }
#else
    traceReliableGeodesicDda(cameraPosition, rayDirection,
                             closestDistance, closestNormal, closestTile,
                             closestLayer, closestMaterial);
#endif
#if VOXEL_SCALE_LAB
    if (frame.geodesicTraversalMode == 8u &&
        (gl_GlobalInvocationID.x & 7u) == 0u &&
        (gl_GlobalInvocationID.y & 7u) == 0u) {
        uint savedTermination = traversalTermination;
        uint savedTerminalTile = traversalTerminalTile;
        float savedTerminalTravel = traversalTerminalTravel;
        float savedTerminalFar = traversalTerminalFar;
        float savedCapDenominator = traversalTerminalCapDenominator;
        float savedCapDistance = traversalTerminalCapDistance;
        float savedConeMargin = traversalTerminalConeMargin;
        float savedIntervalNear = traversalIntervalNear;
        float savedIntervalFar = traversalIntervalFar;
        uint savedEvents = scaleTraversalEvents;
        uint savedRefinements = scaleAtlasRefinements;
        uint savedBoundSkips = scaleBoundSkips;
        uint savedBoundNonfinite = scaleBoundNonfinite;

        float pureDistance = kFarDistance;
        vec3 pureNormal = vec3(0.0);
        uint pureTile = 0u;
        uint pureLayer = 0u;
        uint pureMaterial = 0u;
        traceGeodesicEventDda(cameraPosition, rayDirection,
                              pureDistance, pureNormal, pureTile,
                              pureLayer, pureMaterial, false);
        bool hybridHit = closestDistance < kFarDistance;
        bool pureHit = pureDistance < kFarDistance;
        atomicAdd(scaleTelemetryPadding[2], 1u);
        if (hybridHit != pureHit ||
            (hybridHit && (closestTile != pureTile ||
                           closestLayer != pureLayer ||
                           closestMaterial != pureMaterial))) {
            atomicAdd(scaleTelemetryPadding[3], 1u);
        }
        if (hybridHit && pureHit) {
            uint hybridBits = floatBitsToUint(closestDistance);
            uint pureBits = floatBitsToUint(pureDistance);
            uint distanceUlps = max(hybridBits, pureBits) -
                                min(hybridBits, pureBits);
            atomicMax(scaleTelemetryPadding[5], distanceUlps);
            if (distanceUlps > 8u) {
                atomicAdd(scaleTelemetryPadding[4], 1u);
            }
        }

        traversalTermination = savedTermination;
        traversalTerminalTile = savedTerminalTile;
        traversalTerminalTravel = savedTerminalTravel;
        traversalTerminalFar = savedTerminalFar;
        traversalTerminalCapDenominator = savedCapDenominator;
        traversalTerminalCapDistance = savedCapDistance;
        traversalTerminalConeMargin = savedConeMargin;
        traversalIntervalNear = savedIntervalNear;
        traversalIntervalFar = savedIntervalFar;
        scaleTraversalEvents = savedEvents;
        scaleAtlasRefinements = savedRefinements;
        scaleBoundSkips = savedBoundSkips;
        scaleBoundNonfinite = savedBoundNonfinite;
    }
#endif
    hitPlanet = closestDistance < kFarDistance;
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricDdaCandidate = hitPlanet ? 1u : 0u;
    if (hitPlanet) {
        float hitFacing = dot(closestNormal, rayDirection);
        bool frontFacing = !any(isnan(closestNormal)) &&
                           !any(isinf(closestNormal)) &&
                           hitFacing < 0.0;
        if (!frontFacing) {
            globalMetricFrontFaceRejected = 1u;
            // This path is rare because ordinary overlap exits are filtered
            // while candidates are collected. If an ordered terminal branch
            // still supplies a back plane, enumerate the bounded owner rings
            // and select the next outward-facing exact prism rather than
            // turning a recoverable terrain ray directly into background.
            closestDistance = kFarDistance;
            closestNormal = vec3(0.0);
            closestTile = 0u;
            closestLayer = 0u;
            closestMaterial = 0u;
            bool recovered = considerShellOwnerRings(
                cameraPosition, rayDirection,
                closestDistance, closestNormal, closestTile,
                closestLayer, closestMaterial);
            recovered = recovered && closestDistance < kFarDistance &&
                !any(isnan(closestNormal)) && !any(isinf(closestNormal)) &&
                dot(closestNormal, rayDirection) < 0.0;
            hitPlanet = recovered;
            globalMetricFrontFaceRecovered = recovered ? 1u : 0u;
        }
    }
#endif
    if (!hitPlanet) {
        if (traversalTerminalTile != 0xffffffffu) {
            debugHit.tile = traversalTerminalTile;
            debugHit.columnHeight =
                geodesicColumnStates[traversalTerminalTile].y;
            debugHit.distance = traversalTerminalTravel;
            debugHit.projectedHeight = traversalTerminalFar;
            debugHit.geometryDetail = traversalTerminalCapDenominator;
            debugHit.sideIncidence = traversalTerminalCapDistance;
            debugHit.projectedWidth = traversalTerminalConeMargin;
        }
        return vec3(0.0);
    }

    GeodesicTile tile = geodesicTiles[closestTile];
    uint sideNeighborTag = closestLayer >> 6u;
    closestLayer &= 0x3fu;
    uvec4 columnState = geodesicColumnStates[closestTile];
    vec3 geometricNormal = normalize(closestNormal);
    float sideMask = 1.0 - smoothstep(
        0.20, 0.70, abs(dot(geometricNormal, tile.center.xyz)));
    float projectedExposedSidePixels = 1e30;
    float projectedSideWidthPixels = 1e30;
    float sideIncidence = 1.0;
    float localSideInteriorPixels = 1e30;
    uint sideNeighbor = 0xffffffffu;
    uint sideNeighborHeight = 0u;
    if (sideMask > 0.0 && sideNeighborTag != 0u) {
        sideNeighbor = sideNeighborTag - 1u;
        uvec4 neighborState = geodesicColumnStates[sideNeighbor];
        sideNeighborHeight = neighborState.y;
        float tileDepth = geodesicTileRadialDepth(tile) * frame.planetRadius;
        float tileLayerHeight = tileDepth / float(geodesicTileLayerCount(tile));
        // Logical layer difference is the visible cliff height. Equal-layer
        // columns may have microscopic geometric strips from local-width
        // variation, but those are not a resolved voxel step and receive zero
        // contrast rather than shimmering as stipple.
        bool hitLayerIsExposed = columnState.y > neighborState.y &&
            closestLayer >= neighborState.y;
        float exposedSideHeight = hitLayerIsExposed
            ? float(columnState.y - neighborState.y) * tileLayerHeight
            : 0.0;

        vec3 hitRadial = normalize(
            cameraPosition + rayDirection * closestDistance);
        float radialScreenProjection = sqrt(max(
            1.0 - pow(dot(hitRadial, -rayDirection), 2.0), 0.0));
        float pixelScale = (float(frame.resolution.y) * 0.5) /
            max(closestDistance, frame.hitEpsilon);
        projectedExposedSidePixels = exposedSideHeight *
            radialScreenProjection * pixelScale;
        // Height alone is insufficient: the problematic radial walls remain
        // tall but collapse to subpixel width when viewed edge-on. The
        // side-normal incidence estimates that second projected dimension.
        sideIncidence = abs(dot(geometricNormal, -rayDirection));
        projectedSideWidthPixels = geodesicTileSurfaceWidth(tile) *
            frame.planetRadius *
            sideIncidence * pixelScale;

        // Whole-face dimensions cannot identify a one-pixel corner sample of
        // an otherwise large wall. Measure this hit's local screen-space
        // interior instead: distance to the exposed radial interval and to
        // every other side plane bounding this particular wall. A genuine
        // cliff has a stable interior; isolated edge/corner hits do not.
        float columnBase = frame.planetRadius - tileDepth;
        float radialCoordinate = dot(
            cameraPosition + rayDirection * closestDistance, tile.center.xyz);
        float exposedBottom = columnBase + float(neighborState.y) * tileLayerHeight;
        float exposedTop = columnBase + float(columnState.y) * tileLayerHeight;
        float radialInteriorPixels = max(min(radialCoordinate - exposedBottom,
                                              exposedTop - radialCoordinate), 0.0) *
            radialScreenProjection * pixelScale;
        // The whole-face width already bounds tangential stability. Avoid a
        // five/six-neighbor plane loop per side-hit pixel; the reported chains
        // are radial cap-edge fragments, so only their local radial inset needs
        // per-hit evaluation.
        float tangentialInteriorPixels = projectedSideWidthPixels * 0.5;
        localSideInteriorPixels = min(radialInteriorPixels,
                                      tangentialInteriorPixels);
    }
    float resolvedSideCoverage = smoothstep(
        2.0, 8.0, min(projectedExposedSidePixels,
                      projectedSideWidthPixels)) *
        smoothstep(0.08, 0.25, sideIncidence) *
        smoothstep(1.0, 2.5, localSideInteriorPixels);
    // A fractional point-sampled wall normal is still a moving dark dot. Use
    // wall shading only for a fully resolved local interior; the exact DDA hit
    // and depth remain untouched for filtered edge/corner samples.
    float resolvedSideDetail = step(0.999, resolvedSideCoverage);
    float geometryDetail = 1.0 - sideMask * (1.0 - resolvedSideDetail);
    if (sideMask > 0.5) {
        hitClass = sideNeighborTag == 0u ? 5u
                 : projectedExposedSidePixels <= 0.0 ? 1u
                 : geometryDetail < 0.01 ? 2u
                 : geometryDetail < 0.999 ? 3u
                                          : 4u;
    }
    debugHit.tile = closestTile;
    debugHit.layer = closestLayer;
    debugHit.neighbor = sideNeighbor;
    debugHit.columnHeight = columnState.y;
    debugHit.neighborHeight = sideNeighborHeight;
    debugHit.material = closestMaterial;
    debugHit.distance = closestDistance;
    debugHit.geometryDetail = geometryDetail;
    debugHit.sideIncidence = sideIncidence;
    debugHit.projectedWidth = projectedSideWidthPixels;
    debugHit.projectedHeight = projectedExposedSidePixels;
    debugHit.sideMask = sideMask;
    debugHit.localInteriorPixels = localSideInteriorPixels;
    debugHit.normal = geometricNormal;

    // A subpixel exposed strip has no stable point-sampled coverage. Blend only
    // its shading representation toward the adjacent cap aggregate. The DDA
    // hit, depth, silhouette, and resolved nearby cliff faces stay exact.
    uint surfaceMaterial = columnState.z & 0xffu;
    vec3 base = mix(materialColor(surfaceMaterial),
                    materialColor(closestMaterial), geometryDetail);
    float identity = fract(float(closestTile) * 0.61803398875);
    base *= mix(0.92, 1.08, identity);
    float layerTone = mix(0.78, 1.08,
                          float(closestLayer + 1u) /
                              float(geodesicTileLayerCount(tile)));
    float surfaceTone = mix(0.78, 1.08,
                            float(columnState.y) /
                                float(geodesicTileLayerCount(tile)));
    base *= mix(surfaceTone, layerTone, geometryDetail);

#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
    vec3 lightDirection = productionSunDirection();
#else
    const vec3 lightDirection = normalize(vec3(-0.45, 0.75, 0.35));
#endif
    vec3 normal = normalize(mix(tile.center.xyz, geometricNormal, geometryDetail));
#if VOXEL_ADAPTIVE_SDF_LAB
    bool adaptiveEnabled = (frame.visualizationMode & (1u << 8u)) != 0u;
    uint adaptiveDebugMode = (frame.visualizationMode >> 21u) & 0x3u;
    bool adaptiveComparisonView =
        (frame.visualizationMode & (1u << 31u)) != 0u &&
        adaptiveDebugMode == 0u;
    bool adaptiveComparisonHalf =
        gl_GlobalInvocationID.x >= frame.resolution.x / 2u;
    vec3 exactParentNormal = normal;
    vec3 exactParentBase = base;
    float adaptiveDepthFraction = 0.0;
    float adaptiveActivation = 0.0;
    float adaptiveContinuousLevel = 0.0;
    float adaptiveRefinedDistance = closestDistance;
    vec3 adaptiveNormal = tile.center.xyz;
    bool adaptiveActive = false;
    if ((adaptiveEnabled || adaptiveDebugMode != 0u) &&
        sideNeighborTag == 0u && sideMask < 0.20) {
        adaptiveActive = refineAdaptivePlanetSdf(
            closestTile, tile, columnState, closestLayer, closestMaterial,
            cameraPosition, rayDirection, closestDistance,
            adaptiveNormal, adaptiveDepthFraction, adaptiveActivation,
            adaptiveContinuousLevel, adaptiveRefinedDistance);
        if (adaptiveActive) {
            adaptiveSdfActive = 1u;
            normal = adaptiveNormal;
            // A small camera-invariant value cue makes subpixel-filtered
            // concavity legible without turning a virtual hierarchy cell into
            // a rendered surface or affecting hit ordering.
            float normalizedDepth = adaptiveDepthFraction /
                max(adaptiveSdfLayerFraction(), 1e-6);
            if (adaptiveComparisonView && adaptiveComparisonHalf) {
                // The comparison half deliberately gives the actual bounded
                // root/gradient a stronger deterministic relief cue. It does
                // not invent geometry: depth and normal both come from the
                // same local implicit solve used by the normal shaded path.
                base *= mix(1.0, mix(1.18, 0.58, normalizedDepth),
                            adaptiveActivation * 0.72);
            } else {
                base *= mix(1.0, mix(1.035, 0.93, normalizedDepth),
                            adaptiveActivation * 0.28);
            }
        }
    }
    if (adaptiveComparisonView && !adaptiveComparisonHalf) {
        normal = exactParentNormal;
        base = exactParentBase;
    }
    if (adaptiveDebugMode != 0u) {
        if (!adaptiveActive) {
            return vec3(0.0);
        }
        if (adaptiveDebugMode == 1u) {
            float applied = clamp(adaptiveDepthFraction /
                                  max(adaptiveSdfLayerFraction(), 1e-6),
                                  0.0, 1.0);
            return mix(vec3(0.03, 0.18, 1.0),
                       vec3(1.0, 0.18, 0.02), applied);
        }
        if (adaptiveDebugMode == 2u) {
            float level = adaptiveContinuousLevel /
                max(float(adaptiveSdfMaximumLevels()), 1.0);
            return vec3(level, 1.0 - abs(level * 2.0 - 1.0), 1.0 - level);
        }
        return vec3(adaptiveActivation);
    }
#else
    bool microSdfEnabled = (frame.maxMarchSteps & (1u << 27u)) != 0u;
    bool microSdfDebug = (frame.maxMarchSteps & (1u << 28u)) != 0u;
    float microDepth01 = 0.0;
    float microActivation = 0.0;
    vec3 microNormal = tile.center.xyz;
    bool microActive = false;
    if ((microSdfEnabled || microSdfDebug) && sideNeighborTag == 0u &&
        sideMask < 0.20) {
        microActive = refineTerrainMicroSdf(
            tile, columnState, closestLayer, closestMaterial,
            cameraPosition, rayDirection, closestDistance,
            microNormal, microDepth01, microActivation);
        if (microActive) {
            microSdfActive = 1u;
            normal = microNormal;
        }
    }
    if (microSdfDebug) {
        // R/B show the bounded field depth; green shows deterministic support.
        // Black means water, edited terrain, a cell edge, side, or small footprint.
        return microActive
            ? vec3(microDepth01, microActivation, 1.0 - microDepth01)
            : vec3(0.0);
    }
#endif
    bool localAoEnabled = (frame.maxMarchSteps & (1u << 24u)) != 0u;
    bool localAoDebug = (frame.maxMarchSteps & (1u << 25u)) != 0u;
#if VOXEL_SCALE_LAB
    bool ddaWorkHeatmap = (frame.maxMarchSteps & (1u << 26u)) != 0u;
    if (ddaWorkHeatmap) {
        return vec3(ddaWorkHeatmapCue(scaleTraversalEvents));
    }
#endif
    float localOcclusion = 0.0;
    if (localAoEnabled || localAoDebug) {
        // AO is evaluated only after the exact hit and only from compact
        // one-ring column heights. It has no ray, distance, hierarchy,
        // residency, material-page, or stochastic inputs.
        localOcclusion = localGeodesicAoCue(
            closestTile, closestLayer, sideNeighborTag);
    }
    if (localAoDebug) {
        // Intuitive AO convention: open surfaces are white, enclosed bowls
        // and corners are dark. Misses still use the untouched sky.
        return vec3(1.0 - localOcclusion);
    }

#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
    vec3 sunColor = unpackProductionLightingRgb(frame.terrainSeed);
    vec3 skyZenith = unpackProductionLightingRgb(frame.brushMaterial);
    vec3 skyHorizon = unpackProductionLightingRgb(frame.editMode);
    float sunIntensity = clamp(frame.terrainMountainScale, 0.0, 3.0);
    float skyIntensity = clamp(frame.terrainMountainStrength, 0.0, 1.25);
    float exposure = clamp(frame.terrainOceanLevel, 0.25, 2.5);
    float contactStrength = clamp(frame.terrainPolarStrength, 0.0, 0.65);
    float specularStrength = float(frame.simulationTick & 0xffu) / 255.0;
    float rimStrength = float((frame.simulationTick >> 8u) & 0xffu) *
                        (0.25 / 255.0);
    uint lightingDebug = (frame.terrainSeed >> 24u) & 0x3u;
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float aoFactor = 1.0 - localGeodesicAoStrength() * localOcclusion;
    float contactOcclusion = 0.0;
    // Side lighting stays analytic and stable. Only cap interiors receive the
    // optional one-ring directional contact horizon, preventing dark radial
    // wall stripes and subpixel edge flicker.
    if (contactStrength > 0.0 && sideNeighborTag == 0u && sideMask < 0.20) {
        contactOcclusion = localGeodesicSunOcclusion(
            closestTile, closestLayer, lightDirection);
    }
    float sunVisibility = 1.0 - contactStrength * contactOcclusion;
    bool terrainShadowsEnabled;
    uint terrainShadowSteps;
    float terrainShadowDistance;
    float terrainShadowStrength;
    productionTerrainShadowControls(
        terrainShadowsEnabled, terrainShadowSteps, terrainShadowDistance,
        terrainShadowStrength);
    float terrainSunVisibility = 1.0;
    if (terrainShadowsEnabled && diffuse > 0.0) {
        vec3 exactHitPosition = cameraPosition +
                                rayDirection * closestDistance;
        terrainSunVisibility = productionTerrainSunVisibility(
            exactHitPosition, lightDirection, closestTile);
        productionTerrainHitSunVisibility = mix(
            1.0, terrainSunVisibility, terrainShadowStrength);
        sunVisibility *= productionTerrainHitSunVisibility;
    }
    ProductionCloudSettings cloudSettings = productionCloudSettings();
    if (cloudSettings.enabled && diffuse > 0.0 &&
        cloudSettings.shadowSteps != 0u) {
        vec3 exactHitPosition = cameraPosition +
                                rayDirection * closestDistance;
        float rawCloudVisibility = productionCloudSunTransmittance(
            exactHitPosition, lightDirection, cloudSettings);
        productionCloudHitSunVisibility = mix(
            1.0, rawCloudVisibility, cloudSettings.shadowStrength);
        sunVisibility *= productionCloudHitSunVisibility;
    }
    float hemisphere = smoothstep(
        0.0, 1.0, clamp(dot(normal, normalize(tile.center.xyz)) * 0.5 + 0.5,
                        0.0, 1.0));
    vec3 skyColor = mix(skyHorizon * 0.52, skyZenith, hemisphere);
    vec3 viewDirection = -rayDirection;
    vec3 halfDirection = normalize(lightDirection + viewDirection);
    float materialRoughness = productionMaterialRoughness(
        geometryDetail > 0.5 ? closestMaterial : surfaceMaterial,
        frame.terrainRoughness);
    float specularPower = mix(72.0, 5.0,
                              materialRoughness * materialRoughness);
    float normalHalf = max(dot(normal, halfDirection), 0.0);
    float specularLobe = pow(normalHalf, specularPower);
    float viewNormal = max(dot(normal, viewDirection), 0.0);
    float fresnelBase = 1.0 - viewNormal;
    float fresnel2 = fresnelBase * fresnelBase;
    float fresnel = 0.04 + 0.96 * fresnel2 * fresnel2 * fresnelBase;
    uint lightingMaterial = geometryDetail > 0.5
        ? closestMaterial : surfaceMaterial;
    float materialSpecular = lightingMaterial == 3u ? 1.0
                           : lightingMaterial == 4u ? 0.34
                           : lightingMaterial == 5u ? 0.16 : 0.22;
    vec3 hdr = base * skyColor * (skyIntensity * aoFactor);
    hdr += base * sunColor *
        (sunIntensity * diffuse * sunVisibility * (0.96 - 0.08 * fresnel));
    hdr += sunColor * (sunIntensity * specularStrength * materialSpecular *
                       specularLobe * mix(0.35, 1.0, fresnel) * sunVisibility);
    float rimBase = 1.0 - viewNormal;
    float rim2 = rimBase * rimBase;
    hdr += skyHorizon * (rimStrength * rim2 * rim2 * rimBase * aoFactor);
    if (lightingDebug == 1u) {
        return vec3(diffuse * sunVisibility);
    }
    if (lightingDebug == 2u) {
        return clamp(skyColor * (aoFactor * skyIntensity) +
                     vec3(contactOcclusion * 0.35), 0.0, 1.0);
    }
    if (lightingDebug == 3u) {
        return normal * 0.5 + 0.5;
    }
    return productionToneMap(hdr, exposure);
#else
    float diffuse = max(dot(normal, lightDirection), 0.0);
    float ambient = 0.17 + 0.12 * max(normal.y, 0.0);
    float rim = pow(1.0 - max(dot(normal, -rayDirection), 0.0), 3.0);
    vec3 litColor = base * (ambient + diffuse * 0.9) +
                    rim * vec3(0.04, 0.30, 0.44);
    litColor *= 1.0 - localGeodesicAoStrength() * localOcclusion;
    return litColor;
#endif
}

#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
uint backgroundHash(uvec2 cell, uint seed) {
    uint value = cell.x * 0x9e3779b9u ^ cell.y * 0x85ebca6bu ^ seed;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float backgroundHash01(uint value) {
    return float(value & 0x00ffffffu) * (1.0 / 16777216.0);
}

#if VOXEL_GLOBAL_METRIC_LAB
uint backgroundHash3(ivec3 cell, uint seed) {
    uvec3 bits = uvec3(cell);
    uint value = bits.x * 0x9e3779b9u ^
                 bits.y * 0x85ebca6bu ^
                 bits.z * 0xc2b2ae35u ^ seed;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

vec3 backgroundUnitVectorStarLayer(
    vec3 direction, int shellResolution, uint seed, float density,
    float pixelAngular, float size, float densityScale) {
    // Direction-native sparse cells in a thin Cartesian shell avoid every
    // longitude seam and polar singularity. Projecting deterministic 3-D
    // candidates back to the unit sphere yields approximately equal solid-
    // angle density without a latitude-dependent correction.
    vec3 shellPosition = normalize(direction) * float(shellResolution);
    ivec3 base = ivec3(floor(shellPosition));
    vec3 result = vec3(0.0);
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec3 cell = base + ivec3(x, y, z);
                vec3 cellCenter = vec3(cell) + vec3(0.5);
                if (abs(length(cellCenter) - float(shellResolution)) > 1.35) {
                    continue;
                }
                uint hash = backgroundHash3(cell, seed);
                float existence = backgroundHash01(hash);
                if (existence < 1.0 - density * densityScale) {
                    continue;
                }
                vec3 jitter = vec3(
                    backgroundHash01(backgroundHash3(cell, seed + 17u)),
                    backgroundHash01(backgroundHash3(cell, seed + 43u)),
                    backgroundHash01(backgroundHash3(cell, seed + 71u)));
                vec3 candidatePosition = vec3(cell) +
                    mix(vec3(0.16), vec3(0.84), jitter);
                if (abs(length(candidatePosition) -
                        float(shellResolution)) > 1.0) {
                    continue;
                }
                vec3 candidateDirection = normalize(candidatePosition);
                float angularDistance = sqrt(max(
                    2.0 * (1.0 - dot(normalize(direction),
                                     candidateDirection)), 0.0));
                float radiusVariation = 0.38 + 0.42 *
                    backgroundHash01(backgroundHash3(cell, seed + 97u));
                float radius = pixelAngular * size * radiusVariation;
                float footprint = 1.0 - smoothstep(
                    radius, radius + pixelAngular * (0.72 + 0.22 * size),
                    angularDistance);
                if (!(footprint > 0.0)) {
                    continue;
                }
                float temperature = backgroundHash01(
                    backgroundHash3(cell, seed + 113u));
                vec3 starColor = mix(vec3(1.0, 0.72, 0.48),
                                     vec3(0.58, 0.76, 1.0), temperature);
                float intensityHash = backgroundHash01(
                    backgroundHash3(cell, seed + 149u));
                float intensity = mix(0.38, 1.55,
                                      intensityHash * intensityHash);
                result += starColor * (footprint * intensity);
            }
        }
    }
    return result;
}
#endif

vec3 backgroundStarLayer(vec2 sphericalUv, ivec2 grid, uint seed,
                         float density, float pixelAngular,
                         float size, float densityScale) {
    vec2 gridPosition = sphericalUv * vec2(grid);
    ivec2 base = ivec2(floor(gridPosition));
    float cosineLatitude = max(
        cos((sphericalUv.y - 0.5) * kPi), 0.025);
    int cellX = (base.x % grid.x + grid.x) % grid.x;
    int cellY = clamp(base.y, 0, grid.y - 1);
    uvec2 cell = uvec2(cellX, cellY);
    uint hash = backgroundHash(cell, seed);
    float existence = backgroundHash01(hash);
    if (existence < 1.0 - density * densityScale) {
        return vec3(0.0);
    }
    // Keep the randomized center inside the middle 46% of its atlas cell.
    // Since the filtered footprint is smaller than that margin, it never
    // crosses a cell boundary and requires no neighbor search or seam branch.
    float jitterX = mix(0.27, 0.73,
        backgroundHash01(backgroundHash(cell, seed + 17u)));
    float jitterY = mix(0.27, 0.73,
        backgroundHash01(backgroundHash(cell, seed + 43u)));
    vec2 candidateUv = (vec2(cell) + vec2(jitterX, jitterY)) / vec2(grid);
    float deltaLongitude = candidateUv.x - sphericalUv.x;
    deltaLongitude -= round(deltaLongitude);
    vec2 angularDelta = vec2(
        deltaLongitude * (2.0 * kPi) * cosineLatitude,
        (candidateUv.y - sphericalUv.y) * kPi);
    float distanceToStar = length(angularDelta);
    float radiusVariation = 0.38 + 0.42 *
        backgroundHash01(backgroundHash(cell, seed + 79u));
    float radius = pixelAngular * size * radiusVariation;
    float footprint = 1.0 - smoothstep(
        radius, radius + pixelAngular * (0.72 + 0.22 * size),
        distanceToStar);
    if (!(footprint > 0.0)) {
        return vec3(0.0);
    }
    float temperature = backgroundHash01(
        backgroundHash(cell, seed + 101u));
    vec3 starColor = mix(vec3(1.0, 0.72, 0.48),
                         vec3(0.58, 0.76, 1.0), temperature);
    float intensityHash = backgroundHash01(
        backgroundHash(cell, seed + 137u));
    float intensity = mix(0.38, 1.55, intensityHash * intensityHash);
    return starColor * (footprint * intensity);
}

vec3 backgroundStarColor(vec3 rayDirection) {
    if ((frame.simulationTick & (1u << 24u)) == 0u) {
        return vec3(0.0);
    }
    bool cameraAligned = (frame.simulationTick & (1u << 25u)) != 0u;
    vec3 direction = normalize(cameraAligned
        ? backgroundEnvironmentDirection : rayDirection);
    float density = float((frame.simulationTick >> 16u) & 0xffu) /
                    255.0;
    uint renderWord0 = floatBitsToUint(frame.brushNdc.x);
    float brightness = float(renderWord0 & 0xffu) * (2.5 / 255.0);
    float size = 0.5 + float((renderWord0 >> 8u) & 0xffu) *
                 (2.0 / 255.0);
    float pixelAngular = 2.0 / max(float(frame.resolution.y), 1.0);
#if VOXEL_GLOBAL_METRIC_LAB
    pixelAngular = max(pixelAngular, globalStarAngularFootprint);
    vec3 fine = backgroundUnitVectorStarLayer(
        direction, 256, 0x243f6a88u,
        density, pixelAngular, size, 0.0040);
    vec3 bright = backgroundUnitVectorStarLayer(
        direction, 72, 0xb7e15162u,
        density, pixelAngular, size * 1.32, 0.0070);
#else
    vec2 sphericalUv = vec2(
        atan(direction.z, direction.x) / (2.0 * kPi) + 0.5,
        asin(clamp(direction.y, -1.0, 1.0)) / kPi + 0.5);
    vec3 fine = backgroundStarLayer(
        sphericalUv, ivec2(768, 384), 0x243f6a88u,
        density, pixelAngular, size, 0.025);
    vec3 bright = backgroundStarLayer(
        sphericalUv, ivec2(192, 96), 0xb7e15162u,
        density, pixelAngular, size * 1.32, 0.012);
#endif
    return (fine * 0.72 + bright * 1.25) * brightness;
}

float backgroundStarVisibility(vec3 cameraPosition, vec3 rayDirection) {
    float tClosest = -dot(cameraPosition, rayDirection);
    if (!(tClosest > 0.0)) {
        return 1.0;
    }
    vec3 closestPoint = cameraPosition + rayDirection * tClosest;
    float angularClearance = length(closestPoint) -
        frame.planetRadius * frame.planetOuterScale;
    return smoothstep(frame.planetRadius * 0.08,
                      frame.planetRadius * 0.15,
                      angularClearance);
}

float visibleBackgroundStar(vec3 cameraPosition, vec3 rayDirection) {
    vec3 star = backgroundStarColor(rayDirection) *
                backgroundStarVisibility(cameraPosition, rayDirection);
    return max(star.x, max(star.y, star.z));
}

struct ProductionAtmosphereSample {
    vec3 inScattering;
    vec3 rayleighScattering;
    vec3 mieScattering;
    vec3 absorptionLoss;
    vec3 transmittance;
    vec3 opticalDepth;
    float terrainSunVisibility;
    float segmentLength;
};

void productionAtmosphereMedium(
    float radius, float groundRadius, float innerRadius, float outerRadius,
    float startHeight, bool artisticNearFade, float scaleHeight,
    float rayleighStrength, float mieStrength, float absorptionStrength,
    out vec3 rayleigh, out vec3 mie, out vec3 absorption) {
    rayleigh = vec3(0.0);
    mie = vec3(0.0);
    absorption = vec3(0.0);
    float thickness = outerRadius - groundRadius;
    if (!(thickness > 0.0) || radius < innerRadius || radius > outerRadius) {
        return;
    }
    float height = clamp((radius - groundRadius) / thickness, 0.0, 1.0);
    float fade = 1.0;
    if (artisticNearFade && startHeight > 0.0) {
        fade = smoothstep(0.0, startHeight,
                          max(radius - groundRadius, 0.0));
    }
    float topFade = 1.0 - height;
    float rayleighDensity = exp(-height / max(scaleHeight, 0.01)) *
                              topFade * fade;
    float mieDensity = exp(-height / max(scaleHeight * 0.36, 0.025)) *
                        topFade * fade;
    float ozone = max(1.0 - abs(height - 0.55) / 0.34, 0.0);
    float absorptionDensity = ozone * ozone * topFade * fade;
    rayleigh = vec3(0.18, 0.42, 1.0) *
               (rayleighStrength * rayleighDensity);
    mie = vec3(0.72) * (mieStrength * mieDensity);
    absorption = vec3(0.18, 0.62, 0.10) *
                 (absorptionStrength * absorptionDensity);
}

void productionAtmosphereViewQuadrature(uint sampleCount, uint sampleIndex,
                                        out float fraction,
                                        out float weight) {
    if (sampleCount == 2u) {
        const float offset = 0.2886751345948129;
        fraction = sampleIndex == 0u ? 0.5 - offset : 0.5 + offset;
        weight = 0.5;
        return;
    }
    if (sampleCount == 3u) {
        fraction = sampleIndex == 0u ? 0.1127016653792583
                 : sampleIndex == 1u ? 0.5 : 0.8872983346207417;
        weight = sampleIndex == 1u ? 0.4444444444444444
                                   : 0.2777777777777778;
        return;
    }
    if (sampleCount >= 5u) {
        fraction = sampleIndex == 0u ? 0.0469100770306680
                 : sampleIndex == 1u ? 0.2307653449471585
                 : sampleIndex == 2u ? 0.5
                 : sampleIndex == 3u ? 0.7692346550528415
                                     : 0.9530899229693320;
        weight = sampleIndex == 0u || sampleIndex == 4u
            ? 0.1184634425280945
            : sampleIndex == 1u || sampleIndex == 3u
                ? 0.2393143352496832 : 0.2844444444444444;
        return;
    }
    fraction = 0.5;
    weight = 1.0;
}

void productionAtmosphereSunQuadrature(uint sampleCount, uint sampleIndex,
                                       out float fraction,
                                       out float weight) {
    if (sampleCount >= 4u) {
        fraction = sampleIndex == 0u ? 0.0694318442029737
                 : sampleIndex == 1u ? 0.3300094782075719
                 : sampleIndex == 2u ? 0.6699905217924281
                                     : 0.9305681557970262;
        weight = sampleIndex == 0u || sampleIndex == 3u
            ? 0.1739274225687269 : 0.3260725774312731;
        return;
    }
    const float offset = 0.2886751345948129;
    fraction = sampleIndex == 0u ? 0.5 - offset : 0.5 + offset;
    weight = 0.5;
}

bool productionAtmospherePlanetShadow(vec3 position, vec3 sunDirection,
                                      float planetRadius) {
    vec3 origin = position + sunDirection *
        max(frame.hitEpsilon, planetRadius * 1e-5);
    float projection = dot(origin, sunDirection);
    float discriminant = projection * projection - dot(origin, origin) +
                         planetRadius * planetRadius;
    return projection < 0.0 && discriminant >= 0.0;
}

vec3 productionAtmosphereSunTransmittance(
    vec3 position, vec3 sunDirection, float groundRadius, float innerRadius,
    float outerRadius, float startHeight, bool artisticNearFade,
    float densityScale, float scaleHeight, float rayleighStrength,
    float mieStrength, float absorptionStrength, uint sampleCount) {
    float thickness = max(outerRadius - groundRadius, 1e-6);
    float radius = length(position);
    if (sampleCount > 0u) {
        float shellNear = 0.0;
        float shellFar = 0.0;
        if (!raySphereInterval(position, sunDirection, outerRadius,
                               shellNear, shellFar) || !(shellFar > 0.0)) {
            return vec3(1.0);
        }
        float pathLength = max(shellFar, 0.0);
        vec3 opticalDepth = vec3(0.0);
        for (uint sampleIndex = 0u; sampleIndex < 4u; ++sampleIndex) {
            if (sampleIndex >= sampleCount) {
                break;
            }
            float fraction;
            float weight;
            productionAtmosphereSunQuadrature(
                sampleCount, sampleIndex, fraction, weight);
            vec3 rayleighSample;
            vec3 mieSample;
            vec3 absorptionSample;
            productionAtmosphereMedium(
                length(position + sunDirection * (pathLength * fraction)),
                groundRadius, innerRadius, outerRadius, startHeight,
                artisticNearFade, scaleHeight, rayleighStrength, mieStrength,
                absorptionStrength, rayleighSample, mieSample,
                absorptionSample);
            mieSample *= vec3(0.95, 0.91, 0.84) / 0.72;
            absorptionSample *= vec3(0.08, 0.16, 0.34) /
                                vec3(0.18, 0.62, 0.10);
            opticalDepth += (rayleighSample + mieSample + absorptionSample) *
                (densityScale * pathLength / thickness * weight);
        }
        return exp(-clamp(opticalDepth, vec3(0.0), vec3(32.0)));
    }
    vec3 rayleigh;
    vec3 mie;
    vec3 absorption;
    productionAtmosphereMedium(
        radius, groundRadius, innerRadius, outerRadius, startHeight,
        artisticNearFade, scaleHeight, rayleighStrength, mieStrength,
        absorptionStrength, rayleigh, mie, absorption);
    float radialCosine = dot(position / max(radius, 1e-6), sunDirection);
    // Curvature-aware Chapman/air-mass approximation. It is analytic,
    // bounded at the horizon, and approaches one scale height for a vertical
    // sun path. Exact core occultation is evaluated separately.
    float curvature = max(2.0 * thickness / max(innerRadius, 1e-6), 1e-5);
    float airMass = 2.0 / max(radialCosine +
        sqrt(radialCosine * radialCosine + curvature), 0.08);
    vec3 opticalDepth = (rayleigh + mie + absorption) *
        (densityScale * min(airMass, 12.0) * 0.42);
    return exp(-clamp(opticalDepth, vec3(0.0), vec3(32.0)));
}

ProductionAtmosphereSample sampleProductionAtmosphere(
    vec3 cameraPosition, vec3 rayDirection, float sceneDistance) {
    ProductionAtmosphereSample result;
    result.inScattering = vec3(0.0);
    result.rayleighScattering = vec3(0.0);
    result.mieScattering = vec3(0.0);
    result.absorptionLoss = vec3(0.0);
    result.transmittance = vec3(1.0);
    result.opticalDepth = vec3(0.0);
    result.terrainSunVisibility = 1.0;
    result.segmentLength = 0.0;

    float startHeightNormalized = float((frame.terrainSeed >> 29u) & 0x7u) *
                                  (0.04 / 7.0);
    float endHeight = float((frame.brushMaterial >> 24u) & 0xffu) *
                      (0.30 / 255.0);
    float densityScale = float((frame.editMode >> 24u) & 0xffu) *
                         (3.0 / 255.0);
    uint renderWord0 = floatBitsToUint(frame.brushNdc.x);
    uint renderWord1 = floatBitsToUint(frame.brushNdc.y);
    float rayleighStrength = float((renderWord0 >> 16u) & 0xffu) *
                              (3.0 / 255.0);
    float mieStrength = float((renderWord0 >> 24u) & 0xffu) *
                        (3.0 / 255.0);
    float absorptionStrength = float(renderWord1 & 0xffu) *
                               (3.0 / 255.0);
    float scaleHeight = 0.08 + float((renderWord1 >> 8u) & 0xffu) *
                        ((0.65 - 0.08) / 255.0);
    float mieG = -0.20 + float((renderWord1 >> 16u) & 0xffu) *
                 ((0.90 + 0.20) / 255.0);
    uint integrationControls = (frame.streamSamplePhase >> 24u) & 0xffu;
    uint integrationQuality = (integrationControls >> 1u) & 0x3u;
    bool depthIntegrated = (integrationControls & 0x1u) != 0u &&
                           integrationQuality != 0u;
    uint viewSampleCount = !depthIntegrated ? 1u
        : integrationQuality == 1u ? 2u
        : integrationQuality == 2u ? 3u : 5u;
    uint sunSampleCount = !depthIntegrated ? 0u
        : integrationQuality >= 3u ? 4u : 2u;
    float nightScatteringStrength =
        float((integrationControls >> 3u) & 0x1fu) * (0.25 / 31.0);
    bool physicalSurface = (frame.simulationTick & (1u << 28u)) != 0u;
    bool artisticNearFade = (frame.simulationTick & (1u << 29u)) != 0u;
    float terrainOuterRadius = frame.planetRadius * frame.planetOuterScale;
    // The occupied f512 terrain extends inward from its maximum outer cap.
    // Put the physical atmosphere base conservatively below that entire
    // radial band so valleys and low caps receive the same camera-to-hit
    // extinction instead of falling below an artificial sea-level cutoff.
    float groundRadius = frame.planetRadius *
        max(frame.planetOuterScale - 0.065, 0.75);
    float startHeight = frame.planetRadius * startHeightNormalized;
    float innerRadius = physicalSurface
        ? groundRadius : groundRadius + startHeight;
    float outerRadius = terrainOuterRadius + frame.planetRadius *
        max(endHeight,
            physicalSurface ? 0.005 : startHeightNormalized + 0.005);
    float shellNear = 0.0;
    float shellFar = 0.0;
    if (!(densityScale > 0.0) ||
        !raySphereInterval(cameraPosition, rayDirection, outerRadius,
                           shellNear, shellFar)) {
        return result;
    }
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricAtmosphereInterval = 1u;
#endif
    float segmentNear = max(shellNear, 0.0);
    float segmentFar = min(shellFar, max(sceneDistance, 0.0));
    if (!(segmentFar > segmentNear)) {
        return result;
    }

    float segmentLength = segmentFar - segmentNear;
    float thickness = max(outerRadius - groundRadius, 1e-6);
    vec3 sunDirection = productionSunDirection();
    vec3 skyZenith = unpackProductionLightingRgb(frame.brushMaterial);
    vec3 skyHorizon = unpackProductionLightingRgb(frame.editMode);
    vec3 sunColor = unpackProductionLightingRgb(frame.terrainSeed);
    vec3 turquoiseZenith = mix(skyZenith, vec3(0.10, 0.52, 0.70), 0.58);
    vec3 turquoiseHorizon = mix(skyHorizon, vec3(0.25, 0.72, 0.67), 0.50);
    float mu = clamp(dot(rayDirection, sunDirection), -1.0, 1.0);
    float rayleighPhase = 0.75 * (1.0 + mu * mu);
    float mieDenominator = max(1.0 + mieG * mieG - 2.0 * mieG * mu,
                               1e-4);
    float miePhase = clamp((1.0 - mieG * mieG) /
                           pow(mieDenominator, 1.5), 0.0, 12.0);
    // The representative point drives bounded terrain/cloud sun visibility.
    // The reference depth-integrated path then performs ordered fixed
    // quadrature over the full camera segment without re-running those
    // expensive topology/cloud queries for every optical sample.
    float closestDistance = clamp(-dot(cameraPosition, rayDirection),
                                  segmentNear, segmentFar);
    float sampleDistance = mix(0.5 * (segmentNear + segmentFar),
                               closestDistance, 0.72);
    vec3 position = cameraPosition + rayDirection * sampleDistance;
    float radius = length(position);
    bool planetShadow = productionAtmospherePlanetShadow(
        position, sunDirection, groundRadius);
    vec3 sunTransmittance = planetShadow ? vec3(0.0) :
        productionAtmosphereSunTransmittance(
            position, sunDirection, groundRadius, innerRadius, outerRadius,
            startHeight, artisticNearFade, densityScale, scaleHeight,
            rayleighStrength, mieStrength, absorptionStrength,
            sunSampleCount);
    if (planetShadow) {
        result.terrainSunVisibility = 0.0;
    } else {
        bool terrainShadowsEnabled;
        uint terrainShadowSteps;
        float terrainShadowDistance;
        float terrainShadowStrength;
        productionTerrainShadowControls(
            terrainShadowsEnabled, terrainShadowSteps,
            terrainShadowDistance, terrainShadowStrength);
        if (terrainShadowsEnabled) {
            if (sceneDistance < kFarDistance - 1e-3) {
                // Reuse the exact hit-column horizon result for the bounded
                // camera-to-terrain segment. This is both temporally stable
                // and avoids a second adjacency/prism walk on every hit ray.
                result.terrainSunVisibility =
                    productionTerrainHitSunVisibility;
            } else {
                uint atmosphereTile = findSurfaceTile(normalize(position));
                float rawTerrainVisibility = productionTerrainSunVisibility(
                    position, sunDirection, atmosphereTile);
                result.terrainSunVisibility = mix(
                    1.0, rawTerrainVisibility, terrainShadowStrength);
            }
            sunTransmittance *= result.terrainSunVisibility;
        }
    }
    ProductionCloudSettings cloudSettings = productionCloudSettings();
    if (!planetShadow && cloudSettings.enabled &&
        cloudSettings.shadowSteps != 0u) {
        float cloudSunVisibility = sceneDistance < kFarDistance - 1e-3
            ? productionCloudHitSunVisibility
            : mix(1.0, productionCloudSunTransmittance(
                    position, sunDirection, cloudSettings),
                  cloudSettings.shadowStrength);
        // Cache the bounded sun-path result for the later cloud compositing
        // pass. Terrain hits already populated this value during exact
        // shading, avoiding a duplicate medium march per pixel.
        productionCloudHitSunVisibility = cloudSunVisibility;
        sunTransmittance *= cloudSunVisibility;
    }
    vec3 accumulatedTransmittance = vec3(1.0);
    vec3 accumulatedRayleigh = vec3(0.0);
    vec3 accumulatedMie = vec3(0.0);
    vec3 opticalDepth = vec3(0.0);
    vec3 absorptionOptical = vec3(0.0);
    float representativeFraction = (sampleDistance - segmentNear) /
        max(segmentLength, 1e-6);
    for (uint sampleIndex = 0u; sampleIndex < 5u; ++sampleIndex) {
        if (sampleIndex >= viewSampleCount) {
            break;
        }
        float sampleFraction;
        float sampleWeight;
        productionAtmosphereViewQuadrature(
            viewSampleCount, sampleIndex, sampleFraction, sampleWeight);
        if (!depthIntegrated) {
            sampleFraction = representativeFraction;
            sampleWeight = 1.0;
        }
        vec3 samplePosition = cameraPosition + rayDirection *
            mix(segmentNear, segmentFar, sampleFraction);
        float sampleRadius = length(samplePosition);
        vec3 rayleigh;
        vec3 mie;
        vec3 absorption;
        productionAtmosphereMedium(
            sampleRadius, groundRadius, innerRadius, outerRadius, startHeight,
            artisticNearFade, scaleHeight, rayleighStrength, mieStrength,
            absorptionStrength, rayleigh, mie, absorption);
        if (depthIntegrated) {
            // Spectrum used by the user's depth-aware SpaceBattle shader.
            // Density profiles remain native to this planet's surface shell.
            mie *= vec3(0.95, 0.91, 0.84) / 0.72;
            absorption *= vec3(0.08, 0.16, 0.34) /
                          vec3(0.18, 0.62, 0.10);
        }
        float samplePathScale = densityScale * segmentLength / thickness *
                                sampleWeight;
        vec3 sampleRayleighOptical = rayleigh * samplePathScale;
        vec3 sampleMieOptical = mie * samplePathScale;
        vec3 sampleAbsorptionOptical = absorption * samplePathScale;
        vec3 sampleOptical = sampleRayleighOptical + sampleMieOptical +
                             sampleAbsorptionOptical;
        vec3 attenuation = exp(-clamp(sampleOptical,
                                      vec3(0.0), vec3(32.0)));
        vec3 scatteredFraction = vec3(1.0) - attenuation;
        vec3 extinction = max(rayleigh + mie + absorption, vec3(1e-5));
        float height = clamp((sampleRadius - groundRadius) / thickness,
                             0.0, 1.0);
        vec3 radial = samplePosition / max(sampleRadius, 1e-6);
        float tangentAlignment = clamp(
            1.0 - abs(dot(radial, -rayDirection)), 0.0, 1.0);
        float lowAltitudeBand = smoothstep(0.0, 0.055, height) *
            (1.0 - smoothstep(0.42, 0.86, height));
        float viewTangent = pow(tangentAlignment, 3.25);
        float outerRim = pow(tangentAlignment, 2.8) * lowAltitudeBand;
        float shapeGain = depthIntegrated
            ? mix(0.38, 1.0, viewTangent) * (1.0 + outerRim * 0.55)
            : 1.0;
        vec3 scatterColor = mix(turquoiseHorizon, turquoiseZenith,
                                smoothstep(0.0, 0.72, height));
        vec3 rayleighSource = rayleigh / extinction * scatterColor *
            (rayleighPhase * (vec3(0.13) + 0.87 * sunTransmittance));
        vec3 mieSource = mie / extinction * sunColor *
            (miePhase * sunTransmittance * 0.32);
        if (depthIntegrated) {
            float sunRadial = dot(radial, sunDirection);
            float directVisibility = productionAtmospherePlanetShadow(
                samplePosition, sunDirection, groundRadius) ? 0.0 : 1.0;
            float terminator = (1.0 - smoothstep(0.025, 0.22,
                abs(sunRadial))) * outerRim * directVisibility;
            rayleighSource += rayleigh / extinction * sunColor *
                vec3(1.0, 0.36, 0.12) * terminator * 0.24;
            vec3 derivedNightSpectrum =
                (vec3(0.18, 0.43, 1.0) * rayleighStrength * 0.68 +
                 vec3(0.95, 0.91, 0.84) * mieStrength * 0.16) *
                exp(-vec3(0.08, 0.16, 0.34) *
                    absorptionStrength * 0.85) *
                mix(vec3(1.0), scatterColor, 0.22) * sunColor * 0.18;
            rayleighSource += derivedNightSpectrum *
                nightScatteringStrength * (1.0 - directVisibility);
            rayleighSource *= shapeGain;
            mieSource *= shapeGain;
        }
        vec3 pathWeight = sqrt(max(attenuation, vec3(0.0))) *
                          scatteredFraction;
        accumulatedRayleigh += accumulatedTransmittance * pathWeight *
                               rayleighSource;
        accumulatedMie += accumulatedTransmittance * pathWeight * mieSource;
        accumulatedTransmittance *= attenuation;
        opticalDepth += sampleOptical;
        absorptionOptical += sampleAbsorptionOptical;
        if (max(accumulatedTransmittance.r,
                max(accumulatedTransmittance.g,
                    accumulatedTransmittance.b)) < 0.0005) {
            break;
        }
    }
    result.rayleighScattering = accumulatedRayleigh;
    result.mieScattering = accumulatedMie;
    result.inScattering = result.rayleighScattering + result.mieScattering;
    result.absorptionLoss = vec3(1.0) -
        exp(-clamp(absorptionOptical, vec3(0.0), vec3(32.0)));
    result.transmittance = clamp(accumulatedTransmittance,
                                 vec3(0.0), vec3(1.0));
    result.opticalDepth = opticalDepth;
    result.segmentLength = segmentLength;
    if (any(isnan(result.inScattering)) || any(isinf(result.inScattering)) ||
        any(isnan(result.transmittance)) || any(isinf(result.transmittance))) {
        result.inScattering = vec3(0.0);
        result.rayleighScattering = vec3(0.0);
        result.mieScattering = vec3(0.0);
        result.absorptionLoss = vec3(0.0);
        result.transmittance = vec3(1.0);
        result.opticalDepth = vec3(0.0);
        result.terrainSunVisibility = 1.0;
        result.segmentLength = 0.0;
    }
    return result;
}

vec3 applyProductionAtmosphere(vec3 cameraPosition, vec3 rayDirection,
                               float sceneDistance, vec3 sceneColor) {
    bool enabled = (frame.simulationTick & (1u << 27u)) != 0u;
    uint debugMode = (frame.terrainSeed >> 26u) & 0x7u;
    if (!enabled && debugMode == 0u) {
        return sceneColor;
    }
    ProductionAtmosphereSample atmosphere = sampleProductionAtmosphere(
        cameraPosition, rayDirection, sceneDistance);
    if (debugMode == 1u) {
        return atmosphere.transmittance;
    }
    if (debugMode == 2u) {
        return atmosphere.inScattering;
    }
    if (debugMode == 3u) {
        return atmosphere.rayleighScattering;
    }
    if (debugMode == 4u) {
        return atmosphere.mieScattering;
    }
    if (debugMode == 5u) {
        return atmosphere.absorptionLoss;
    }
    if (debugMode == 6u) {
        return vec3(1.0) - exp(-max(atmosphere.opticalDepth, vec3(0.0)));
    }
    if (debugMode == 7u) {
        return vec3(atmosphere.terrainSunVisibility);
    }
    return sceneColor * atmosphere.transmittance + atmosphere.inScattering;
}

struct ProductionCloudSample {
    vec3 inScattering;
    float transmittance;
    float opticalDepth;
    float sunVisibility;
};

ProductionCloudSample sampleProductionClouds(
    vec3 cameraPosition, vec3 rayDirection, float sceneDistance,
    ProductionCloudSettings settings) {
    ProductionCloudSample result;
    result.inScattering = vec3(0.0);
    result.transmittance = 1.0;
    result.opticalDepth = 0.0;
    result.sunVisibility = 1.0;
    if (!settings.enabled || !(settings.density > 0.0)) {
        return result;
    }
    vec2 firstSegment;
    vec2 secondSegment;
    if (!productionCloudShellSegments(
            cameraPosition, rayDirection, sceneDistance, settings,
            firstSegment, secondSegment)) {
        return result;
    }
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricCloudInterval = 1u;
#endif
    float totalLength = 0.0;
    float representativeDistance = productionCloudPathSample(
        firstSegment, secondSegment, 0.5, totalLength);
    if (!(totalLength > 0.0)) {
        return result;
    }
    vec3 sunDirection = productionSunDirection();
    vec3 representativePosition = cameraPosition +
                                  rayDirection * representativeDistance;
    if (settings.shadowSteps != 0u) {
        bool atmosphereEnabled =
            (frame.simulationTick & (1u << 27u)) != 0u;
        bool sharedVisibilityAvailable =
            sceneDistance < kFarDistance - 1e-3 || atmosphereEnabled;
        result.sunVisibility = sharedVisibilityAvailable
            ? productionCloudHitSunVisibility
            : mix(1.0, productionCloudSunTransmittance(
                    representativePosition, sunDirection, settings),
                  settings.shadowStrength);
    }
    uint atmosphereWord = floatBitsToUint(frame.brushNdc.y);
    float mieG = -0.20 + float((atmosphereWord >> 16u) & 0xffu) *
                 ((0.90 + 0.20) / 255.0);
    float mu = clamp(dot(rayDirection, sunDirection), -1.0, 1.0);
    float phaseDenominator = max(
        1.0 + mieG * mieG - 2.0 * mieG * mu, 1e-4);
    float miePhase = clamp((1.0 - mieG * mieG) /
        pow(phaseDenominator, 1.5), 0.0, 12.0) * 0.18;
    vec3 sunColor = unpackProductionLightingRgb(frame.terrainSeed);
    vec3 skyZenith = unpackProductionLightingRgb(frame.brushMaterial);
    vec3 skyHorizon = unpackProductionLightingRgb(frame.editMode);
    float shellThickness = frame.planetRadius *
        max(settings.topAltitude - settings.baseAltitude, 0.005);
    float stepLength = totalLength / float(settings.viewSteps);
    float viewTransmittance = 1.0;
    for (uint sampleIndex = 0u; sampleIndex < 16u; ++sampleIndex) {
        if (sampleIndex >= settings.viewSteps) {
            break;
        }
        float distance = productionCloudPathSample(
            firstSegment, secondSegment,
            (float(sampleIndex) + 0.5) / float(settings.viewSteps),
            totalLength);
        vec3 position = cameraPosition + rayDirection * distance;
        float localDensity = productionCloudDensity(position, settings);
        if (!(localDensity > 0.0)) {
            continue;
        }
        float deltaOptical = localDensity * settings.density *
                             stepLength / shellThickness;
        float attenuation = exp(-clamp(deltaOptical, 0.0, 32.0));
        float scattered = 1.0 - attenuation;
        float height = clamp((length(position) / frame.planetRadius -
            frame.planetOuterScale - settings.baseAltitude) /
            max(settings.topAltitude - settings.baseAltitude, 0.005),
            0.0, 1.0);
        vec3 ambientColor = mix(skyHorizon, skyZenith,
                                smoothstep(0.0, 1.0, height));
        float powder = 1.0 - exp(-localDensity * 2.2);
        vec3 source = ambientColor * (0.20 + 0.22 * powder) +
            sunColor * (miePhase * result.sunVisibility *
                        mix(0.34, 0.72, powder));
        result.inScattering += viewTransmittance * scattered * source;
        viewTransmittance *= attenuation;
        result.opticalDepth += deltaOptical;
    }
    result.transmittance = clamp(viewTransmittance, 0.0, 1.0);
    if (any(isnan(result.inScattering)) || any(isinf(result.inScattering)) ||
        isnan(result.transmittance) || isinf(result.transmittance)) {
        result.inScattering = vec3(0.0);
        result.transmittance = 1.0;
        result.opticalDepth = 0.0;
        result.sunVisibility = 1.0;
    }
    return result;
}

vec3 applyProductionClouds(vec3 cameraPosition, vec3 rayDirection,
                           float sceneDistance, vec3 sceneColor) {
    ProductionCloudSettings settings = productionCloudSettings();
    if (!settings.enabled && settings.debugMode == 0u) {
        return sceneColor;
    }
    ProductionCloudSample clouds = sampleProductionClouds(
        cameraPosition, rayDirection, sceneDistance, settings);
    if (settings.debugMode == 1u) {
        return vec3(1.0 - exp(-max(clouds.opticalDepth, 0.0)));
    }
    if (settings.debugMode == 2u) {
        return vec3(clouds.transmittance);
    }
    if (settings.debugMode == 3u) {
        return vec3(clouds.sunVisibility);
    }
    return sceneColor * clouds.transmittance + clouds.inScattering;
}

vec3 spaceBackground(vec3 cameraPosition, vec3 rayDirection) {
    vec3 blackEnvironment = vec3(0.00018, 0.00024, 0.00038);
    vec3 stars = backgroundStarColor(rayDirection);
    float visibility = backgroundStarVisibility(cameraPosition, rayDirection);
    if ((frame.simulationTick & (1u << 26u)) != 0u) {
        return vec3(max(stars.x, max(stars.y, stars.z)), visibility, 0.0);
    }
    return blackEnvironment + stars * visibility;
}
#else
float backgroundStarMask(vec3 rayDirection) {
    vec3 direction = normalize(rayDirection);
    vec3 cell = floor((direction * 0.5 + 0.5) * 768.0);
    float hash = fract(sin(dot(cell, vec3(12.9898, 78.233, 37.719))) *
                       43758.5453);
    return step(0.9985, hash);
}

float backgroundStarVisibility(vec3 cameraPosition, vec3 rayDirection) {
    float tClosest = -dot(cameraPosition, rayDirection);
    if (!(tClosest > 0.0)) {
        return 1.0;
    }
    vec3 closestPoint = cameraPosition + rayDirection * tClosest;
    float angularClearance = length(closestPoint) -
        frame.planetRadius * frame.planetOuterScale;
    return smoothstep(frame.planetRadius * 0.06,
                      frame.planetRadius * 0.12,
                      angularClearance);
}

float visibleBackgroundStar(vec3 cameraPosition, vec3 rayDirection) {
    return backgroundStarMask(rayDirection) *
        backgroundStarVisibility(cameraPosition, rayDirection);
}

vec3 spaceBackground(vec3 cameraPosition, vec3 rayDirection) {
    float horizon = max(rayDirection.y * 0.5 + 0.5, 0.0);
    vec3 color = mix(vec3(0.003, 0.005, 0.012),
                     vec3(0.012, 0.028, 0.055), horizon);
    float stars = visibleBackgroundStar(cameraPosition, rayDirection);
    return color + stars * vec3(0.45, 0.60, 0.82);
}
#endif

void buildCameraFrame(out vec3 cameraPosition, out vec3 forward,
                      out vec3 right, out vec3 up) {
#if VOXEL_PORTAL_LAB
    if (frame.cameraMode == 2u) {
#if VOXEL_INTRINSIC_PORTAL_LAB
#if VOXEL_GLOBAL_METRIC_LAB
        bool nativeEllis = intrinsicControl.x < -0.5;
        // Native signed-l mode has no Euclidean mouth surface.  The packed
        // forward/up vectors are components of the observer tetrad and every
        // screen ray is integrated from the same intrinsic event.
        cameraPosition = nativeEllis ? vec3(0.0)
                                     : intrinsicCamera.xyz * frame.planetRadius;
        forward = normalize(nativeEllis ? intrinsicForward.xyz
                                        : intrinsicAngular.xyz);
        vec3 requestedUp = normalize(nativeEllis ? intrinsicUp.xyz
                                                 : intrinsicForward.xyz);
        right = normalize(cross(forward, requestedUp));
        up = normalize(cross(right, forward));
#else
        // These are components in the observer's intrinsic orthonormal tetrad,
        // not a Euclidean pose. main() sends the resulting local ray through
        // the Ellis manifold before any world-space content query.
        cameraPosition = vec3(0.0);
        forward = normalize(intrinsicForward.xyz);
        vec3 requestedUp = normalize(intrinsicUp.xyz);
        right = normalize(cross(forward, requestedUp));
        up = normalize(cross(right, forward));
#endif
#else
        cameraPosition = portalFreeFlyPosition.xyz * frame.planetRadius;
        forward = normalize(portalFreeFlyForward.xyz);
        vec3 requestedUp = normalize(portalFreeFlyUp.xyz);
        right = normalize(cross(forward, requestedUp));
        up = normalize(cross(right, forward));
#endif
        return;
    }
#endif
    float yaw = frame.cameraYaw + (frame.cameraMode == 0u ? frame.time : 0.0);
    float cosinePitch = cos(frame.cameraPitch);
    vec3 radial = normalize(vec3(sin(yaw) * cosinePitch,
                                 sin(frame.cameraPitch),
                                 cos(yaw) * cosinePitch));
    cameraPosition = radial * frame.cameraDistance;
    if (frame.cameraMode == 0u) {
        forward = -radial;
        right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
        up = cross(right, forward);
        return;
    }
    vec3 reference = abs(radial.y) < 0.95
                         ? vec3(0.0, 1.0, 0.0)
                         : vec3(0.0, 0.0, 1.0);
    vec3 tangentRight = normalize(cross(reference, radial));
    vec3 tangentForward = normalize(cross(radial, tangentRight));
    vec3 horizontalForward = normalize(
        tangentForward * cos(frame.surfaceHeading) +
        tangentRight * sin(frame.surfaceHeading));
    forward = normalize(horizontalForward * cos(frame.surfaceLookPitch) +
                        radial * sin(frame.surfaceLookPitch));
    right = normalize(cross(forward, radial));
    up = normalize(cross(right, forward));
}

#if VOXEL_PORTAL_LAB && !VOXEL_INTRINSIC_PORTAL_LAB
struct PortalRayState {
    vec3 origin;
    vec3 direction;
    uint steps;
    uint traversals;
    bool affected;
    bool finiteState;
};

bool portalSphereInterval(vec3 origin, vec3 direction, vec3 center,
                          float radius, out float nearDistance,
                          out float farDistance) {
    vec3 relative = origin - center;
    float halfB = dot(relative, direction);
    float c = dot(relative, relative) - radius * radius;
    float discriminant = halfB * halfB - c;
    if (!(discriminant >= 0.0) || isnan(discriminant) || isinf(discriminant)) {
        nearDistance = 0.0;
        farDistance = 0.0;
        return false;
    }
    float root = sqrt(discriminant);
    nearDistance = -halfB - root;
    farDistance = -halfB + root;
    return farDistance >= 0.0 && !isnan(nearDistance) && !isinf(nearDistance) &&
           !isnan(farDistance) && !isinf(farDistance);
}

mat3 portalFrame(vec3 center) {
    vec3 z = normalize(center);
    vec3 reference = abs(z.y) < 0.92 ? vec3(0.0, 1.0, 0.0)
                                     : vec3(1.0, 0.0, 0.0);
    vec3 x = normalize(cross(reference, z));
    vec3 y = normalize(cross(z, x));
    return mat3(x, y, z);
}

vec3 rotatePortalLink(vec3 value) {
    float cy = cos(portalLink.x);
    float sy = sin(portalLink.x);
    float cp = cos(portalLink.y);
    float sp = sin(portalLink.y);
    float cr = cos(portalLink.z);
    float sr = sin(portalLink.z);
    vec3 yawed = vec3(cy * value.x + sy * value.z, value.y,
                      -sy * value.x + cy * value.z);
    vec3 pitched = vec3(yawed.x, cp * yawed.y - sp * yawed.z,
                        sp * yawed.y + cp * yawed.z);
    return vec3(cr * pitched.x - sr * pitched.y,
                sr * pitched.x + cr * pitched.y, pitched.z);
}

mat3 portalFullLink(uint sourceEndpoint, vec3 centers[2]) {
    mat3 sourceFrame = portalFrame(centers[0]);
    mat3 destinationFrame = portalFrame(centers[1]);
    mat3 userRotation = mat3(
        rotatePortalLink(vec3(1.0, 0.0, 0.0)),
        rotatePortalLink(vec3(0.0, 1.0, 0.0)),
        rotatePortalLink(vec3(0.0, 0.0, 1.0)));
    mat3 forwardLink = destinationFrame * userRotation *
                       transpose(sourceFrame);
    return sourceEndpoint == 0u ? forwardLink : transpose(forwardLink);
}

vec4 portalQuaternionFromMatrix(mat3 matrixValue) {
    float traceValue = matrixValue[0][0] + matrixValue[1][1] +
                       matrixValue[2][2];
    vec4 result;
    if (traceValue > 0.0) {
        float scale = sqrt(traceValue + 1.0) * 2.0;
        result = vec4((matrixValue[1][2] - matrixValue[2][1]) / scale,
                      (matrixValue[2][0] - matrixValue[0][2]) / scale,
                      (matrixValue[0][1] - matrixValue[1][0]) / scale,
                      0.25 * scale);
    } else if (matrixValue[0][0] > matrixValue[1][1] &&
               matrixValue[0][0] > matrixValue[2][2]) {
        float scale = sqrt(1.0 + matrixValue[0][0] - matrixValue[1][1] -
                           matrixValue[2][2]) * 2.0;
        result = vec4(0.25 * scale,
                      (matrixValue[0][1] + matrixValue[1][0]) / scale,
                      (matrixValue[0][2] + matrixValue[2][0]) / scale,
                      (matrixValue[1][2] - matrixValue[2][1]) / scale);
    } else if (matrixValue[1][1] > matrixValue[2][2]) {
        float scale = sqrt(1.0 + matrixValue[1][1] - matrixValue[0][0] -
                           matrixValue[2][2]) * 2.0;
        result = vec4((matrixValue[0][1] + matrixValue[1][0]) / scale,
                      0.25 * scale,
                      (matrixValue[1][2] + matrixValue[2][1]) / scale,
                      (matrixValue[2][0] - matrixValue[0][2]) / scale);
    } else {
        float scale = sqrt(1.0 + matrixValue[2][2] - matrixValue[0][0] -
                           matrixValue[1][1]) * 2.0;
        result = vec4((matrixValue[0][2] + matrixValue[2][0]) / scale,
                      (matrixValue[1][2] + matrixValue[2][1]) / scale,
                      0.25 * scale,
                      (matrixValue[0][1] - matrixValue[1][0]) / scale);
    }
    result = normalize(result);
    return result.w < 0.0 ? -result : result;
}

vec4 portalQuaternionConjugate(vec4 value) {
    return vec4(-value.xyz, value.w);
}

vec4 portalQuaternionMultiply(vec4 a, vec4 b) {
    return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz),
                a.w * b.w - dot(a.xyz, b.xyz));
}

vec3 portalQuaternionRotate(vec4 rotation, vec3 value) {
    vec3 twiceCross = 2.0 * cross(rotation.xyz, value);
    return value + rotation.w * twiceCross + cross(rotation.xyz, twiceCross);
}

float portalQuintic(float value) {
    float t = clamp(value, 0.0, 1.0);
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

vec4 portalTransportRotation(uint endpoint, float progress, vec3 centers[2]) {
    vec4 target = portalQuaternionFromMatrix(portalFullLink(endpoint, centers));
    float t = portalQuintic(progress);
    float cosine = clamp(target.w, -1.0, 1.0);
    if (cosine > 0.9995) {
        return normalize(vec4(target.xyz * t, mix(1.0, target.w, t)));
    }
    float angle = acos(cosine);
    float sine = sin(angle);
    if (!(sine > 1e-6)) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    float targetWeight = sin(t * angle) / sine;
    float identityWeight = sin((1.0 - t) * angle) / sine;
    return normalize(vec4(target.xyz * targetWeight,
                          identityWeight + target.w * targetWeight));
}

float portalTransportProgress(float radius, float influenceRadius,
                              float throatRadius) {
    return clamp((influenceRadius - radius) /
                 max(influenceRadius - throatRadius, 1e-6), 0.0, 1.0);
}

vec3 portalCurvature(vec3 position, vec3 direction, vec3 center,
                     float influenceRadius, float throatRadius) {
    vec3 relative = position - center;
    float radius = length(relative);
    if (!(radius > throatRadius) || radius >= influenceRadius) {
        return vec3(0.0);
    }
    vec3 inward = -relative / max(radius, 1e-7);
    vec3 perpendicular = inward - direction * dot(inward, direction);
    float normalizedBoundary = clamp(
        (influenceRadius - radius) /
            max(influenceRadius - throatRadius, 1e-6),
        0.0, 1.0);
    float window = normalizedBoundary * normalizedBoundary *
                   (3.0 - 2.0 * normalizedBoundary);
    float q2 = throatRadius * throatRadius;
    float ellis = portalOptical.x * q2 /
        max(pow(radius * radius + q2, 1.5), 1e-8);
    float mass = portalOptical.y * throatRadius /
        max(radius * radius + q2, 1e-7);
    return perpendicular * ((ellis + mass) * window * window);
}

void portalRk4Step(vec3 position, vec3 direction, vec3 center,
                   float influenceRadius, float throatRadius,
                   float stepLength, out vec3 nextPosition,
                   out vec3 nextDirection) {
    vec3 k1Position = direction;
    vec3 k1Direction = portalCurvature(
        position, direction, center, influenceRadius, throatRadius);
    vec3 direction2 = normalize(direction + k1Direction * (0.5 * stepLength));
    vec3 position2 = position + k1Position * (0.5 * stepLength);
    vec3 k2Position = direction2;
    vec3 k2Direction = portalCurvature(
        position2, direction2, center, influenceRadius, throatRadius);
    vec3 direction3 = normalize(direction + k2Direction * (0.5 * stepLength));
    vec3 position3 = position + k2Position * (0.5 * stepLength);
    vec3 k3Position = direction3;
    vec3 k3Direction = portalCurvature(
        position3, direction3, center, influenceRadius, throatRadius);
    vec3 direction4 = normalize(direction + k3Direction * stepLength);
    vec3 position4 = position + k3Position * stepLength;
    vec3 k4Position = direction4;
    vec3 k4Direction = portalCurvature(
        position4, direction4, center, influenceRadius, throatRadius);
    float sixthStep = stepLength / 6.0;
    nextPosition = position +
        (k1Position + 2.0 * k2Position + 2.0 * k3Position + k4Position) *
            sixthStep;
    nextDirection = normalize(direction +
        (k1Direction + 2.0 * k2Direction + 2.0 * k3Direction + k4Direction) *
            sixthStep);
}

bool portalSegmentSphereFraction(vec3 start, vec3 end, vec3 center,
                                 float radius, bool exiting,
                                 out float fraction) {
    vec3 segment = end - start;
    vec3 relative = start - center;
    float a = dot(segment, segment);
    float b = 2.0 * dot(relative, segment);
    float c = dot(relative, relative) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;
    if (!(a > 1e-12) || !(discriminant >= 0.0) ||
        isnan(discriminant) || isinf(discriminant)) {
        fraction = 0.0;
        return false;
    }
    float root = sqrt(discriminant);
    float inverse = 0.5 / a;
    float first = (-b - root) * inverse;
    float second = (-b + root) * inverse;
    fraction = exiting ? second : first;
    return fraction >= 0.0 && fraction <= 1.0 &&
           !isnan(fraction) && !isinf(fraction);
}

PortalRayState tracePortalRay(vec3 origin, vec3 direction) {
    PortalRayState result = PortalRayState(
        origin, normalize(direction), 0u, 0u, false, true);
    float influenceRadius = portalEndpointA.w * frame.planetRadius;
    float throatRadius = portalEndpointB.w * frame.planetRadius;
    uint maximumTraversals = uint(clamp(portalOptical.w, 0.0, 4.0));
    if (portalControl.x < 0.5 || !(influenceRadius > throatRadius) ||
        maximumTraversals == 0u) {
        return result;
    }
    vec3 centers[2] = vec3[2](portalEndpointA.xyz * frame.planetRadius,
                              portalEndpointB.xyz * frame.planetRadius);
    uint quality = uint(clamp(portalOptical.z, 0.0, 2.0));
    uint stepsPerInfluence = quality == 0u ? 32u : quality == 1u ? 64u : 96u;
    // The budget covers a complete diameter. The rejected implementation used
    // radius/N with only N iterations, leaving many non-throat rays inside the
    // volume on integer shells and producing visible concentric bands.
    float stepLength = (2.0 * influenceRadius) / float(stepsPerInfluence);
    float epsilon = max(throatRadius * 0.002, frame.hitEpsilon * 0.02);

    for (uint region = 0u; region < 4u; ++region) {
        float bestNear = kFarDistance;
        float bestFar = 0.0;
        uint endpoint = 2u;
        for (uint candidate = 0u; candidate < 2u; ++candidate) {
            float nearDistance = 0.0;
            float farDistance = 0.0;
            if (portalSphereInterval(result.origin, result.direction,
                                     centers[candidate], influenceRadius,
                                     nearDistance, farDistance)) {
                nearDistance = max(nearDistance, 0.0);
                if (nearDistance < bestNear && farDistance > epsilon) {
                    bestNear = nearDistance;
                    bestFar = farDistance;
                    endpoint = candidate;
                }
            }
        }
        if (endpoint >= 2u) {
            break;
        }
        // An opaque exact terrain shell in front of a portal always wins.
        float planetNear = 0.0;
        float planetFar = 0.0;
        if (portalSphereInterval(result.origin, result.direction, vec3(0.0),
                                 frame.planetRadius * frame.planetOuterScale,
                                 planetNear, planetFar) &&
            max(planetNear, 0.0) + epsilon < bestNear) {
            break;
        }
        result.origin += result.direction * (bestNear + epsilon);
        result.affected = true;
        bool transferred = false;
        bool exited = false;
        for (uint step = 0u; step < 104u; ++step) {
            if (step >= stepsPerInfluence + 8u) {
                break;
            }
            vec3 nextPosition;
            vec3 nextDirection;
            portalRk4Step(result.origin, result.direction, centers[endpoint],
                          influenceRadius, throatRadius, stepLength,
                          nextPosition, nextDirection);
            float currentProgress = portalTransportProgress(
                length(result.origin - centers[endpoint]),
                influenceRadius, throatRadius);
            float nextProgress = portalTransportProgress(
                length(nextPosition - centers[endpoint]),
                influenceRadius, throatRadius);
            vec4 currentRotation = portalTransportRotation(
                endpoint, currentProgress, centers);
            vec4 nextRotation = portalTransportRotation(
                endpoint, nextProgress, centers);
            vec4 incrementalRotation = portalQuaternionMultiply(
                nextRotation, portalQuaternionConjugate(currentRotation));
            nextPosition = centers[endpoint] + portalQuaternionRotate(
                incrementalRotation, nextPosition - centers[endpoint]);
            nextDirection = normalize(portalQuaternionRotate(
                incrementalRotation, nextDirection));
            result.steps += 1u;
            if (any(isnan(nextPosition)) || any(isinf(nextPosition)) ||
                any(isnan(nextDirection)) || any(isinf(nextDirection))) {
                result.finiteState = false;
                return result;
            }
            float throatFraction = 0.0;
            if (portalSegmentSphereFraction(
                    result.origin, nextPosition, centers[endpoint],
                    throatRadius, false, throatFraction)) {
                if (result.traversals >= maximumTraversals) {
                    result.origin = nextPosition;
                    result.direction = nextDirection;
                    return result;
                }
                uint destination = 1u - endpoint;
                vec3 crossingDirection = normalize(mix(
                    result.direction, nextDirection, throatFraction));
                vec3 crossingPosition = mix(
                    result.origin, nextPosition, throatFraction);
                vec3 outgoingRadial = normalize(
                    crossingPosition - centers[endpoint]);
                result.direction = crossingDirection;
                result.origin = centers[destination] - outgoingRadial *
                    (throatRadius + epsilon);
                float destinationNear = 0.0;
                float destinationFar = 0.0;
                if (!portalSphereInterval(
                        result.origin, result.direction, centers[destination],
                        influenceRadius, destinationNear, destinationFar)) {
                    result.finiteState = false;
                    return result;
                }
                result.origin += result.direction *
                    (destinationFar + epsilon);
                result.traversals += 1u;
                transferred = true;
                break;
            }
            float exitFraction = 0.0;
            if (portalSegmentSphereFraction(
                    result.origin, nextPosition, centers[endpoint],
                    influenceRadius, true, exitFraction)) {
                result.origin = mix(result.origin, nextPosition, exitFraction);
                result.direction = normalize(mix(
                    result.direction, nextDirection, exitFraction));
                exited = true;
                break;
            }
            result.origin = nextPosition;
            result.direction = nextDirection;
        }
        if (!transferred) {
            if (!exited) {
                result.finiteState = false;
                return result;
            }
            result.origin += result.direction * epsilon;
        }
    }
    return result;
}

vec3 portalRotateAxis(vec3 value, vec3 axis, float angle) {
    float cosine = cos(angle);
    float sine = sin(angle);
    return value * cosine + cross(axis, value) * sine +
           axis * dot(axis, value) * (1.0 - cosine);
}

vec4 portalGrTableSample(float impact, out bool requiresRefinement) {
    float coordinate = clamp(impact / max(portalGrHeader.z, 1e-6), 0.0, 1.0) *
                       (portalGrHeader.w - 1.0);
    uint low = uint(floor(coordinate));
    uint high = min(low + 1u, uint(portalGrHeader.w) - 1u);
    float fraction = coordinate - float(low);
    vec4 left = portalGrExit[low];
    vec4 right = portalGrExit[high];
    vec4 result = mix(left, right, fraction);
    requiresRefinement = abs(left.w) > 5e-4 || abs(right.w) > 5e-4 ||
                         ((left.w >= 0.0) != (right.w >= 0.0));
    return result;
}

vec4 portalEllisDerivative(vec4 state) {
    float throat = portalGrHeader.x;
    float radius2 = state.x * state.x + throat * throat;
    return vec4(state.z, state.w,
                state.x * state.w * state.w,
                -2.0 * state.x / max(radius2, 1e-8) * state.z * state.w);
}

vec4 portalRefineEllisExit(float impact, out uint usedSteps) {
    float throat = portalGrHeader.x;
    float outerL = sqrt(max(1.0 - throat * throat, 1e-8));
    float b = clamp(impact, 0.0, portalGrHeader.z);
    vec4 state = vec4(outerL, 0.0, -sqrt(max(1.0 - b * b, 0.0)), b);
    uint quality = uint(clamp(portalOptical.z, 0.0, 2.0));
    float stepLength = quality == 0u ? 0.005 : quality == 1u ? 0.0025 : 0.00125;
    uint maximumSteps = quality == 0u ? 1024u : quality == 1u ? 2048u : 4096u;
    bool turned = false;
    usedSteps = 0u;
    for (uint step = 0u; step < 4096u; ++step) {
        if (step >= maximumSteps) {
            break;
        }
        vec4 previous = state;
        vec4 k1 = portalEllisDerivative(state);
        vec4 k2 = portalEllisDerivative(state + k1 * (0.5 * stepLength));
        vec4 k3 = portalEllisDerivative(state + k2 * (0.5 * stepLength));
        vec4 k4 = portalEllisDerivative(state + k3 * stepLength);
        state += (k1 + 2.0 * k2 + 2.0 * k3 + k4) * (stepLength / 6.0);
        usedSteps += 1u;
        if (any(isnan(state)) || any(isinf(state))) {
            return vec4(0.0, 0.0, 0.0, -2.0);
        }
        turned = turned || state.z > 0.0 || state.x < 0.0;
        bool crossed = state.x <= -outerL;
        bool scattered = turned && state.z > 0.0 && state.x >= outerL;
        if (crossed || scattered) {
            float boundary = crossed ? -outerL : outerL;
            float denominator = state.x - previous.x;
            float fraction = abs(denominator) > 1e-8
                ? clamp((boundary - previous.x) / denominator, 0.0, 1.0)
                : 1.0;
            float azimuth = mix(previous.y, state.y, fraction);
            return vec4(azimuth,
                        (float(step) + fraction) * stepLength,
                        0.0, crossed ? 1.0 : -1.0);
        }
    }
    return vec4(0.0, 0.0, 0.0, -2.0);
}

PortalRayState tracePortalRayGr(vec3 origin, vec3 direction) {
    PortalRayState result = PortalRayState(
        origin, normalize(direction), 0u, 0u, false, true);
    float influenceRadius = portalEndpointA.w * frame.planetRadius;
    if (portalControl.x < 0.5 || portalGrStatus.w < 0.5 ||
        !(influenceRadius > frame.hitEpsilon)) {
        return result;
    }
    vec3 centers[2] = vec3[2](portalEndpointA.xyz * frame.planetRadius,
                              portalEndpointB.xyz * frame.planetRadius);
    float epsilon = max(influenceRadius * 2e-4, frame.hitEpsilon * 0.02);
    float bestNear = kFarDistance;
    uint endpoint = 2u;
    for (uint candidate = 0u; candidate < 2u; ++candidate) {
        float nearDistance = 0.0;
        float farDistance = 0.0;
        if (portalSphereInterval(result.origin, result.direction,
                                 centers[candidate], influenceRadius,
                                 nearDistance, farDistance)) {
            nearDistance = max(nearDistance, 0.0);
            if (nearDistance < bestNear && farDistance > epsilon) {
                bestNear = nearDistance;
                endpoint = candidate;
            }
        }
    }
    if (endpoint >= 2u) {
        return result;
    }
    float planetNear = 0.0;
    float planetFar = 0.0;
    if (portalSphereInterval(result.origin, result.direction, vec3(0.0),
                             frame.planetRadius * frame.planetOuterScale,
                             planetNear, planetFar) &&
        max(planetNear, 0.0) + epsilon < bestNear) {
        return result;
    }
    vec3 entry = result.origin + result.direction * (bestNear + epsilon);
    vec3 entryRadial = normalize(entry - centers[endpoint]);
    float radialVelocity = dot(result.direction, entryRadial);
    if (!(radialVelocity < -1e-5)) {
        return result;
    }
    vec3 tangent = result.direction - entryRadial * radialVelocity;
    float impact = clamp(length(tangent), 0.0, portalGrHeader.z);
    tangent = impact > 1e-6 ? tangent / impact : normalize(
        abs(entryRadial.y) < 0.9 ? cross(vec3(0.0, 1.0, 0.0), entryRadial)
                                 : cross(vec3(1.0, 0.0, 0.0), entryRadial));
    vec3 planeAxis = normalize(cross(entryRadial, tangent));
    bool refine = false;
    vec4 exitData = portalGrTableSample(impact, refine);
    atomicAdd(portalGrTelemetry.x, 1u);
    if (refine) {
        atomicAdd(portalGrTelemetry.y, 1u);
        uint refinementSteps = 0u;
        vec4 refined = portalRefineEllisExit(impact, refinementSteps);
        result.steps = refinementSteps;
        if (refined.w > -1.5) {
            exitData = refined;
        }
    }
    bool crossed = exitData.w >= 0.0;
    if (exitData.w <= -999.0) {
        // The exact critical orbit can exceed the bounded local budget. It is
        // conservatively classified as a same-chart scatter, never a sky gap.
        exitData.x = (isnan(exitData.x) || isinf(exitData.x)) ? 0.0 : exitData.x;
        exitData.w = -1.0;
        crossed = false;
    }
    vec3 exitRadial = normalize(portalRotateAxis(
        entryRadial, planeAxis, exitData.x));
    vec3 exitTangent = normalize(portalRotateAxis(
        tangent, planeAxis, exitData.x));
    float exitRadialSpeed = sqrt(max(1.0 - impact * impact, 0.0));
    vec3 exitDirection = normalize(
        exitRadial * exitRadialSpeed + exitTangent * impact);
    if (crossed) {
        uint destination = 1u - endpoint;
        mat3 link = portalFullLink(endpoint, centers);
        vec3 mappedRadial = normalize(link * exitRadial);
        vec3 commonCrossedDirection = normalize(
            -exitRadial * exitRadialSpeed + exitTangent * impact);
        vec3 mappedDirection = normalize(link * commonCrossedDirection);
        // Negative-l Ellis chart: the Euclidean destination embedding reverses
        // the chart radial coordinate, while the transported tangent frame
        // remains an SO(3) map.
        result.origin = centers[destination] - mappedRadial *
            (influenceRadius + epsilon);
        result.direction = mappedDirection;
        result.traversals = 1u;
    } else {
        result.origin = centers[endpoint] + exitRadial *
            (influenceRadius + epsilon);
        result.direction = exitDirection;
    }
    result.affected = true;
    result.finiteState = !any(isnan(result.origin)) && !any(isinf(result.origin)) &&
                         !any(isnan(result.direction)) && !any(isinf(result.direction));
    return result;
}

vec4 portalGrObserverSample(float signedProperL, float tangentSpeed) {
    const uint depthCount = 96u;
    const uint viewCount = 96u;
    float outerL = sqrt(max(1.0 - portalGrHeader.x * portalGrHeader.x, 1e-8));
    float depthCoordinate = clamp(
        (outerL - signedProperL) / (2.0 * outerL), 0.0, 1.0) *
        float(depthCount - 1u);
    float viewCoordinate = clamp(tangentSpeed / 0.985, 0.0, 1.0) *
        float(viewCount - 1u);
    uint d0 = uint(floor(depthCoordinate));
    uint d1 = min(d0 + 1u, depthCount - 1u);
    uint v0 = uint(floor(viewCoordinate));
    uint v1 = min(v0 + 1u, viewCount - 1u);
    float fd = depthCoordinate - float(d0);
    float fv = viewCoordinate - float(v0);
    vec4 upper = mix(portalGrObserver[d0 * viewCount + v0],
                     portalGrObserver[d0 * viewCount + v1], fv);
    vec4 lower = mix(portalGrObserver[d1 * viewCount + v0],
                     portalGrObserver[d1 * viewCount + v1], fv);
    return mix(upper, lower, fd);
}

PortalRayState tracePortalObserverGr(vec3 origin, vec3 direction,
                                     bool destinationSide) {
    PortalRayState result = PortalRayState(
        origin, normalize(direction), 0u, 0u, true, true);
    float influenceRadius = portalEndpointA.w * frame.planetRadius;
    vec3 centers[2] = vec3[2](portalEndpointA.xyz * frame.planetRadius,
                              portalEndpointB.xyz * frame.planetRadius);
    float epsilon = max(influenceRadius * 2e-4, frame.hitEpsilon * 0.02);
    uint containingEndpoint = 2u;
    float bestRadius = kFarDistance;
    for (uint endpoint = 0u; endpoint < 2u; ++endpoint) {
        float radius = length(origin - centers[endpoint]);
        if (radius <= influenceRadius + epsilon && radius < bestRadius) {
            bestRadius = radius;
            containingEndpoint = endpoint;
        }
    }
    if (containingEndpoint >= 2u) {
        result.affected = false;
        return result;
    }
    uint sourceEndpoint = destinationSide ? 1u - containingEndpoint
                                          : containingEndpoint;
    uint destinationEndpoint = 1u - sourceEndpoint;
    mat3 link = portalFullLink(sourceEndpoint, centers);
    vec3 endpointCenter = centers[containingEndpoint];
    vec3 endpointRadial = normalize(origin - endpointCenter);
    vec3 commonRadial = destinationSide
        ? normalize(transpose(link) * -endpointRadial)
        : endpointRadial;
    vec3 commonDirection = destinationSide
        ? normalize(transpose(link) * result.direction)
        : result.direction;
    float normalizedRadius = clamp(length(origin - endpointCenter) /
                                   influenceRadius,
                                   portalGrHeader.x, 1.0);
    float properL = sqrt(max(normalizedRadius * normalizedRadius -
                             portalGrHeader.x * portalGrHeader.x, 0.0));
    float signedProperL = destinationSide ? -properL : properL;
    float radialVelocity = dot(commonDirection, commonRadial);
    if (!(radialVelocity < -1e-5)) {
        // An outward source-side ray exits the current mouth without crossing.
        float nearDistance = 0.0;
        float farDistance = 0.0;
        if (portalSphereInterval(origin, result.direction, endpointCenter,
                                 influenceRadius, nearDistance, farDistance)) {
            result.origin += result.direction * (farDistance + epsilon);
        }
        return result;
    }
    vec3 commonTangentVector = commonDirection -
        commonRadial * radialVelocity;
    float tangentSpeed = clamp(length(commonTangentVector), 0.0, 0.985);
    vec3 commonTangent = tangentSpeed > 1e-6
        ? commonTangentVector / tangentSpeed
        : normalize(abs(commonRadial.y) < 0.9
            ? cross(vec3(0.0, 1.0, 0.0), commonRadial)
            : cross(vec3(1.0, 0.0, 0.0), commonRadial));
    vec3 planeAxis = normalize(cross(commonRadial, commonTangent));
    atomicAdd(portalGrTelemetry.x, 1u);
    vec4 exitData = portalGrObserverSample(signedProperL, tangentSpeed);
    if (exitData.w > 0.5 || any(isnan(exitData)) || any(isinf(exitData))) {
        atomicAdd(portalGrTelemetry.z, 1u);
        result.finiteState = false;
        return result;
    }
    vec3 exitRadial = normalize(portalRotateAxis(
        commonRadial, planeAxis, exitData.x));
    vec3 exitTangent = normalize(portalRotateAxis(
        commonTangent, planeAxis, exitData.x));
    float exitTangentSpeed = clamp(exitData.y, 0.0, 0.999999);
    float exitRadialSpeed = sqrt(max(1.0 -
        exitTangentSpeed * exitTangentSpeed, 0.0));
    if (exitData.z >= 0.0) {
        vec3 mappedRadial = normalize(link * exitRadial);
        vec3 commonExitDirection = normalize(
            -exitRadial * exitRadialSpeed +
             exitTangent * exitTangentSpeed);
        result.origin = centers[destinationEndpoint] - mappedRadial *
            (influenceRadius + epsilon);
        result.direction = normalize(link * commonExitDirection);
        result.traversals = 1u;
    } else {
        result.origin = centers[sourceEndpoint] + exitRadial *
            (influenceRadius + epsilon);
        result.direction = normalize(
            exitRadial * exitRadialSpeed +
            exitTangent * exitTangentSpeed);
    }
    result.finiteState = !any(isnan(result.origin)) && !any(isinf(result.origin)) &&
                         !any(isnan(result.direction)) && !any(isinf(result.direction));
    return result;
}
#endif

#if VOXEL_INTRINSIC_PORTAL_LAB
struct IntrinsicEllisRayState {
    vec3 origin;
    vec3 direction;
    uint endIndex;
    uint steps;
    // 0 = direct asymptotic content, 1 = RK4/table Ellis exit,
    // 2 = transformed-variable critical reference, 3 = unresolved failure.
    uint pathClass;
    bool finiteState;
};

float intrinsicPathMaxCurvature = 0.0;

void intrinsicAngularBasis(vec3 n, out vec3 e1, out vec3 e2) {
    n = normalize(n);
    vec3 absoluteN = abs(n);
    vec3 reference = absoluteN.x <= absoluteN.y && absoluteN.x <= absoluteN.z
        ? vec3(1.0, 0.0, 0.0)
        : absoluteN.y <= absoluteN.z ? vec3(0.0, 1.0, 0.0)
                                     : vec3(0.0, 0.0, 1.0);
    e1 = normalize(cross(reference, n));
    e2 = normalize(cross(n, e1));
}

vec3 intrinsicRotateAxis(vec3 value, vec3 axis, float angle) {
    float cosine = cos(angle);
    float sine = sin(angle);
    return value * cosine + cross(axis, value) * sine +
           axis * dot(axis, value) * (1.0 - cosine);
}

vec3 intrinsicRotateEndB(vec3 value) {
    float cy = cos(intrinsicEndBRotation.x);
    float sy = sin(intrinsicEndBRotation.x);
    float cp = cos(intrinsicEndBRotation.y);
    float sp = sin(intrinsicEndBRotation.y);
    float cr = cos(intrinsicEndBRotation.z);
    float sr = sin(intrinsicEndBRotation.z);
    vec3 yawed = vec3(cy * value.x + sy * value.z, value.y,
                      -sy * value.x + cy * value.z);
    vec3 pitched = vec3(yawed.x, cp * yawed.y - sp * yawed.z,
                        sp * yawed.y + cp * yawed.z);
    return vec3(cr * pitched.x - sr * pitched.y,
                sr * pitched.x + cr * pitched.y, pitched.z);
}

vec3 intrinsicRotateEndBInverse(vec3 value) {
    float cy = cos(intrinsicEndBRotation.x);
    float sy = sin(intrinsicEndBRotation.x);
    float cp = cos(intrinsicEndBRotation.y);
    float sp = sin(intrinsicEndBRotation.y);
    float cr = cos(intrinsicEndBRotation.z);
    float sr = sin(intrinsicEndBRotation.z);
    vec3 unrolled = vec3(cr * value.x + sr * value.y,
                         -sr * value.x + cr * value.y, value.z);
    vec3 unpitched = vec3(unrolled.x,
                          cp * unrolled.y + sp * unrolled.z,
                          -sp * unrolled.y + cp * unrolled.z);
    return vec3(cy * unpitched.x - sy * unpitched.z, unpitched.y,
                sy * unpitched.x + cy * unpitched.z);
}

vec4 intrinsicObserverTableSample(float signedProperL, float tangentSpeed,
                                  out bool requiresRefinement) {
    const uint depthCount = 96u;
    const uint viewCount = 96u;
    float outerL = sqrt(max(1.0 - portalGrHeader.x * portalGrHeader.x, 1e-8));
    float depthCoordinate = clamp(
        (outerL - signedProperL) / (2.0 * outerL), 0.0, 1.0) *
        float(depthCount - 1u);
    float viewCoordinate = clamp(tangentSpeed / 0.985, 0.0, 1.0) *
        float(viewCount - 1u);
    uint d0 = uint(floor(depthCoordinate));
    uint d1 = min(d0 + 1u, depthCount - 1u);
    uint v0 = uint(floor(viewCoordinate));
    uint v1 = min(v0 + 1u, viewCount - 1u);
    float fd = depthCoordinate - float(d0);
    float fv = viewCoordinate - float(v0);
    vec4 upper = mix(portalGrObserver[d0 * viewCount + v0],
                     portalGrObserver[d0 * viewCount + v1], fv);
    vec4 lower = mix(portalGrObserver[d1 * viewCount + v0],
                     portalGrObserver[d1 * viewCount + v1], fv);
    vec4 a = portalGrObserver[d0 * viewCount + v0];
    vec4 b = portalGrObserver[d0 * viewCount + v1];
    vec4 c = portalGrObserver[d1 * viewCount + v0];
    vec4 d = portalGrObserver[d1 * viewCount + v1];
    bool classification = a.z >= 0.0;
    requiresRefinement = a.w > 0.5 || b.w > 0.5 || c.w > 0.5 || d.w > 0.5 ||
        (b.z >= 0.0) != classification ||
        (c.z >= 0.0) != classification ||
        (d.z >= 0.0) != classification;
    return mix(upper, lower, fd);
}

vec3 intrinsicRadialProfile(float signedProperL, float throat) {
    float x = abs(signedProperL);
    float exactRadius = sqrt(x * x + throat * throat);
    return vec3(exactRadius,
                sign(signedProperL) * x / max(exactRadius, 1e-9),
                throat * throat / max(exactRadius * exactRadius *
                                       exactRadius, 1e-9));
}

vec4 intrinsicObserverDerivative(vec4 state, float throat) {
    float radius2 = state.x * state.x + throat * throat;
    float radialAccelerationScale = state.x;
    float expansion = state.x / max(radius2, 1e-9);
#if VOXEL_GLOBAL_METRIC_LAB
    intrinsicPathMaxCurvature = max(intrinsicPathMaxCurvature,
        throat * throat / max(radius2 * radius2, 1e-9));
#endif
    return vec4(state.z, state.w,
                radialAccelerationScale * state.w * state.w,
                -2.0 * expansion * state.z * state.w);
}

vec4 intrinsicObserverRefine(float signedProperL, float tangentSpeed,
                             float boundaryL,
                             out uint usedSteps) {
    float throat =
#if VOXEL_GLOBAL_METRIC_LAB
        intrinsicCamera.y;
#else
        portalGrHeader.x;
#endif
    float outerL = max(boundaryL, abs(signedProperL));
    float l0 = clamp(signedProperL, -outerL, outerL);
    float q = clamp(tangentSpeed, 0.0, 0.9998);
    float r0 = intrinsicRadialProfile(l0, throat).x;
    float impact = r0 * q;
    vec4 state = vec4(l0, 0.0, -sqrt(max(1.0 - q * q, 0.0)),
                      impact / max(r0 * r0, 1e-9));
    float h = uint(clamp(intrinsicForward.w, 0.0, 2.0)) == 0u ? 0.004
            : uint(clamp(intrinsicForward.w, 0.0, 2.0)) == 1u ? 0.002
            : 0.001;
    uint limit = uint(clamp(intrinsicForward.w, 0.0, 2.0)) == 0u ? 1536u
               : uint(clamp(intrinsicForward.w, 0.0, 2.0)) == 1u ? 3072u
               : 4096u;
    bool turned = false;
    usedSteps = 0u;
    for (uint step = 0u; step < 4096u; ++step) {
        if (step >= limit) break;
        vec4 previous = state;
        float localH = h;
#if VOXEL_GLOBAL_METRIC_LAB
        // Curvature-controlled RK4: shorten affine steps smoothly near the
        // throat where |Gamma| is largest, retain the base step in the flat
        // asymptotic chart. No chart-position threshold changes ray topology.
        float localRadius2 = state.x * state.x + throat * throat;
        float curvatureWeight = clamp(
            throat * throat / max(localRadius2, 1e-9), 0.0, 1.0);
        localH = h * mix(1.0, 0.40, curvatureWeight);
#endif
        vec4 k1 = intrinsicObserverDerivative(state, throat);
        vec4 k2 = intrinsicObserverDerivative(
            state + k1 * (localH * 0.5), throat);
        vec4 k3 = intrinsicObserverDerivative(
            state + k2 * (localH * 0.5), throat);
        vec4 k4 = intrinsicObserverDerivative(state + k3 * localH, throat);
        state += (k1 + 2.0 * k2 + 2.0 * k3 + k4) * (localH / 6.0);
        usedSteps += 1u;
        if (any(isnan(state)) || any(isinf(state))) {
            return vec4(0.0, impact, -1.0, 1.0);
        }
        turned = turned || state.z > 0.0;
        bool crossed = state.x <= -outerL;
        bool scattered = turned && state.z > 0.0 && state.x >= outerL;
        if (crossed || scattered) {
            float boundary = crossed ? -outerL : outerL;
            float denominator = state.x - previous.x;
            float fraction = abs(denominator) > 1e-9
                ? clamp((boundary - previous.x) / denominator, 0.0, 1.0)
                : 1.0;
            return vec4(mix(previous.y, state.y, fraction), impact,
                        crossed ? 1.0 : -1.0, 0.0);
        }
    }
    return vec4(state.y, impact, -1.0, 1.0);
}

float intrinsicEllisCrossPrimitive(float x, float impact, float throat,
                                   uint intervalCount) {
    if (x <= 0.0 || impact <= 0.0) return 0.0;
    float c = sqrt(max(throat * throat - impact * impact, 1e-14));
    float maximumU = asinh(x / c);
    float sum = 0.0;
    for (uint index = 0u; index <= 96u; ++index) {
        if (index > intervalCount) break;
        float u = maximumU * float(index) / float(intervalCount);
        float hyperbolic = sinh(u);
        float denominator = sqrt(max(throat * throat +
            c * c * hyperbolic * hyperbolic, 1e-14));
        float weight = index == 0u || index == intervalCount ? 1.0
                     : (index & 1u) != 0u ? 4.0 : 2.0;
        sum += weight * impact / denominator;
    }
    return maximumU * sum / (3.0 * float(intervalCount));
}

float intrinsicEllisScatterPrimitive(float x, float impact, float throat,
                                     uint intervalCount) {
    float d = sqrt(max(impact * impact - throat * throat, 1e-14));
    if (x <= d || impact <= 0.0) return 0.0;
    float maximumU = acosh(max(x / d, 1.0));
    float sum = 0.0;
    for (uint index = 0u; index <= 96u; ++index) {
        if (index > intervalCount) break;
        float u = maximumU * float(index) / float(intervalCount);
        float hyperbolic = cosh(u);
        float denominator = sqrt(max(throat * throat +
            d * d * hyperbolic * hyperbolic, 1e-14));
        float weight = index == 0u || index == intervalCount ? 1.0
                     : (index & 1u) != 0u ? 4.0 : 2.0;
        sum += weight * impact / denominator;
    }
    return maximumU * sum / (3.0 * float(intervalCount));
}

vec4 intrinsicObserverCriticalReference(float signedProperL,
                                        float tangentSpeed,
                                        float boundaryL,
                                        uint intervalCount) {
    float throat = intrinsicCamera.y;
    float radius = intrinsicRadialProfile(signedProperL, throat).x;
    // Exact tangency is a regular turning point away from the throat.  Do not
    // bias q below one: that creates a false radial component and a visible
    // derivative seam between inward and outward ray families.
    float originalImpact = radius * clamp(tangentSpeed, 0.0, 1.0);
    bool crossed = originalImpact <= throat;
    float impactBand = max(radius * 2.0 /
        float(max(frame.resolution.y, 1u)), throat * 2e-5);
    float side = crossed ? -1.0 : 1.0;
    float impact = originalImpact;
    if (abs(impact - throat) < impactBand * 0.5) {
        impact = max(throat + side * impactBand * 0.5, 0.0);
    }
    float azimuth = 0.0;
    if (signedProperL >= 0.0) {
        if (impact < throat) {
            azimuth = intrinsicEllisCrossPrimitive(
                signedProperL, impact, throat, intervalCount) +
                intrinsicEllisCrossPrimitive(
                    boundaryL, impact, throat, intervalCount);
        } else {
            float turning = sqrt(max(impact * impact -
                                     throat * throat, 0.0));
            float turningTolerance = max(
                abs(signedProperL) * 2e-6, 1e-7);
            if (signedProperL + turningTolerance < turning) {
                return vec4(0.0, impact, -1.0, 1.0);
            }
            // The ray starts at the observer, reaches its same-end turning
            // point, and then continues to the (generally different) content
            // boundary.  The previous 2*observer primitive was valid only
            // when both radii matched and created a hard tangent-family seam.
            azimuth = intrinsicEllisScatterPrimitive(
                signedProperL, impact, throat, intervalCount) +
                intrinsicEllisScatterPrimitive(
                    boundaryL, impact, throat, intervalCount);
        }
    } else {
        // This signed branch represents an outward ray after the GPU radial-
        // sign transform.  Evaluate boundary minus observer in the same
        // nonsingular variable as the inward branch; direct Simpson in l is
        // ill-conditioned when the observer ray is almost tangent.
        float fromL = abs(signedProperL);
        azimuth = impact < throat
            ? intrinsicEllisCrossPrimitive(
                  boundaryL, impact, throat, intervalCount) -
              intrinsicEllisCrossPrimitive(
                  fromL, impact, throat, intervalCount)
            : intrinsicEllisScatterPrimitive(
                  boundaryL, impact, throat, intervalCount) -
              intrinsicEllisScatterPrimitive(
                  fromL, impact, throat, intervalCount);
        crossed = true;
    }
    bool finite = !isnan(azimuth) && !isinf(azimuth) &&
                  !isnan(impact) && !isinf(impact);
    return vec4(azimuth, impact, crossed ? 1.0 : -1.0,
                finite ? 0.0 : 1.0);
}

float intrinsicRayQueryBoundary(float cameraL) {
#if VOXEL_GLOBAL_METRIC_LAB
    // A common smooth content-query surface for every ray removes the former
    // |l|=L content seam. It stays ahead of an unbounded free-fly observer.
    // This surface only attaches content; it never toggles the metric or ray
    // ownership, and no screen-space sphere test selects another path.
    float minimumBoundary = intrinsicCamera.z;
    float observerBoundary = abs(cameraL) + intrinsicCamera.y * 0.05;
    float blendWidth = max(intrinsicCamera.y * 0.25, 1e-5);
    float difference = observerBoundary - minimumBoundary;
    return 0.5 * (observerBoundary + minimumBoundary +
                  sqrt(difference * difference +
                       blendWidth * blendWidth));
#else
    return max(abs(cameraL), intrinsicCamera.z);
#endif
}

IntrinsicEllisRayState traceIntrinsicEllisCoreRay(
    float cameraL, vec3 cameraN, vec3 localDirection) {
    IntrinsicEllisRayState result = IntrinsicEllisRayState(
        vec3(0.0), vec3(0.0, 0.0, -1.0), 0u, 0u, 1u, true);
    vec3 n = normalize(cameraN);
    vec3 e1;
    vec3 e2;
    intrinsicAngularBasis(n, e1, e2);
    vec3 local = normalize(localDirection);
    globalMetricRadialClass = local.x > 0.0 ? 1u
        : local.x < 0.0 ? 0u : 2u;
    globalMetricTangentQ = clamp(length(local.yz), 0.0, 1.0);
    float tangentMagnitude = length(local.yz);
    // Exact tangency is a valid ray family. Clamping q below one manufactured
    // a finite radial component, while the sign branch below still changed at
    // local.x=0. The two sides then differed by roughly 0.04 rad and clipped
    // small/distant content. Preserve q=1; ownership alone is half-open.
    float tangentSpeed = clamp(tangentMagnitude, 0.0, 1.0);
    vec3 tangent = tangentMagnitude > 1e-7
        ? (e1 * local.y + e2 * local.z) / tangentMagnitude : e1;
    vec3 planeAxis = normalize(cross(n, tangent));
    // The exact zero-radial ray belongs to the non-positive side. At q=1 the
    // inward and outward formulas converge, so this deterministic ownership
    // choice does not perturb its direction or conserved impact parameter.
    bool outward = local.x > 0.0;
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricRadialClass = local.x > 0.0 ? 1u : local.x < 0.0 ? 0u : 2u;
    globalMetricTangentQ = tangentSpeed;
#endif
    float sampleL = outward ? -cameraL : cameraL;
    atomicAdd(portalGrTelemetry.x, 1u);
    vec4 exitData;
#if VOXEL_GLOBAL_METRIC_LAB
    // The all-space Ellis field is separable. Evaluate its transformed-variable
    // geodesic integral directly for every observer; this is both the regular
    // path and the critical-safe path, so no RK budget can become background.
    atomicAdd(portalGrTelemetry.y, 1u);
    float analyticBoundaryL = intrinsicRayQueryBoundary(cameraL);
    float analyticRadius = intrinsicRadialProfile(
        sampleL, intrinsicCamera.y).x;
    float analyticImpact = analyticRadius * tangentSpeed;
    float analyticBand = max(analyticRadius * 2.0 /
        float(max(frame.resolution.y, 1u)), intrinsicCamera.y * 2e-5);
    bool analyticCritical = abs(analyticImpact - intrinsicCamera.y) <
        analyticBand * 1.5;
    uint analyticIntervals = analyticCritical ? 96u : 24u;
    exitData = intrinsicObserverCriticalReference(
        sampleL, tangentSpeed, analyticBoundaryL, analyticIntervals);
    // Star-only ray-cone propagation: one neighboring conserved-impact
    // sample estimates the outgoing angular Jacobian. It changes only the
    // analytic star footprint, never terrain/media traversal or hit depth.
    float baseStarFootprint = 2.0 /
        max(float(frame.resolution.y), 1.0);
    float qOffset = tangentSpeed > 0.5
        ? -baseStarFootprint : baseStarFootprint;
    float neighborQ = clamp(tangentSpeed + qOffset, 0.0, 1.0);
    vec4 neighborExit = intrinsicObserverCriticalReference(
        sampleL, neighborQ, analyticBoundaryL, analyticIntervals);
    float qSpan = max(abs(neighborQ - tangentSpeed), 1e-6);
    float angularScale = neighborExit.w < 0.5 &&
                         !isnan(neighborExit.x) && !isinf(neighborExit.x)
        ? clamp(abs(neighborExit.x - exitData.x) / qSpan, 0.5, 8.0)
        : 1.0;
    globalStarAngularFootprint = baseStarFootprint * angularScale;
    result.pathClass = analyticCritical ? 2u : 1u;
    result.steps = analyticIntervals;
#else
    bool refine = tangentSpeed > 0.975;
    if (!refine) {
        exitData = intrinsicObserverTableSample(sampleL, tangentSpeed, refine);
        refine = refine || exitData.w > 0.5 ||
                 any(isnan(exitData)) || any(isinf(exitData));
    }
    if (refine) {
        atomicAdd(portalGrTelemetry.y, 1u);
        float boundaryL = intrinsicRayQueryBoundary(cameraL);
        exitData = intrinsicObserverRefine(
            sampleL, tangentSpeed, boundaryL, result.steps);
    }
#endif
    if (exitData.w > 0.5 || any(isnan(exitData)) || any(isinf(exitData))) {
#if VOXEL_GLOBAL_METRIC_LAB
        atomicAdd(portalGrTelemetry.z, 1u);
        result.pathClass = 3u;
        result.finiteState = false;
        return result;
#else
        result.finiteState = false;
        return result;
#endif
    }
    bool crossed = exitData.z >= 0.0;
    bool positiveEnd = outward ? crossed : !crossed;
    if (!positiveEnd) {
        atomicAdd(portalGrTelemetry.w, 1u);
    }
    vec3 exitN = normalize(intrinsicRotateAxis(n, planeAxis, exitData.x));
    vec3 exitTangent = normalize(intrinsicRotateAxis(
        tangent, planeAxis, exitData.x));
    float boundaryL = intrinsicRayQueryBoundary(cameraL);
    float boundaryRadius = intrinsicRadialProfile(
#if VOXEL_GLOBAL_METRIC_LAB
        boundaryL, intrinsicCamera.y
#else
        boundaryL, portalGrHeader.x
#endif
    ).x;
    float qExit = clamp(exitData.y / max(boundaryRadius, 1e-9),
                        0.0, 0.999999);
    float radialSpeed = sqrt(max(1.0 - qExit * qExit, 0.0));
    float intrinsicRadial = positiveEnd ? radialSpeed : -radialSpeed;
    // The radial basis of either attached content sphere points away from its
    // center. On the negative end, decreasing intrinsic l is outward.
    float contentRadial = positiveEnd ? intrinsicRadial : -intrinsicRadial;
    vec3 contentN = positiveEnd ? exitN : intrinsicRotateEndB(exitN);
    vec3 contentTangent = positiveEnd ? exitTangent
                                      : intrinsicRotateEndB(exitTangent);
    vec3 center = (positiveEnd ? intrinsicEndpointA.xyz
                               : intrinsicEndpointB.xyz) * frame.planetRadius;
    float contentRadius =
#if VOXEL_GLOBAL_METRIC_LAB
        boundaryRadius * frame.planetRadius;
#else
        intrinsicAngular.w * frame.planetRadius;
#endif
    float epsilon = max(frame.hitEpsilon * 0.05, contentRadius * 2e-5);
    result.origin = center + contentN * (contentRadius + epsilon);
    result.direction = normalize(contentN * contentRadial +
                                 contentTangent * qExit);
    bool contentOriginFinite = true;
#if VOXEL_GLOBAL_METRIC_LAB
    // A content embedding may pass through the finite terrain body even
    // though the intrinsic observer itself is perfectly valid. Begin the
    // Euclidean narrow phase just outside the conservative planet shell on
    // the same oriented ray line. This makes the first exact prism result an
    // entry surface rather than exposing a zero-distance interior/far cap.
    float terrainOuter = frame.planetRadius * frame.planetOuterScale;
    float terrainMargin = max(frame.hitEpsilon * 8.0,
                              frame.planetRadius * 5e-5);
    float safeTerrainOuter = terrainOuter + terrainMargin;
    if (dot(result.origin, result.origin) <=
            safeTerrainOuter * safeTerrainOuter) {
        float reverseNear = 0.0;
        float reverseFar = 0.0;
        if (raySphereInterval(result.origin, -result.direction,
                              safeTerrainOuter,
                              reverseNear, reverseFar)) {
            result.origin -= result.direction * (reverseFar + terrainMargin);
            globalMetricOriginRepair = 1u;
        } else {
            // This is reachable only for non-finite input; preserve failure
            // telemetry rather than manufacturing a radial projection.
            contentOriginFinite = false;
        }
    }
#endif
    result.endIndex = positiveEnd ? 0u : 1u;
    result.finiteState = contentOriginFinite &&
                         !any(isnan(result.origin)) && !any(isinf(result.origin)) &&
                         !any(isnan(result.direction)) && !any(isinf(result.direction));
#if VOXEL_GLOBAL_METRIC_LAB
    globalMetricMappedFinite = result.finiteState ? 1u : 0u;
#endif
    return result;
}

float intrinsicEllisMouthAzimuthReference(float originalImpact,
                                           out bool crossed) {
    float throat = portalGrHeader.x;
    float outerL = sqrt(max(1.0 - throat * throat, 1e-8));
    crossed = originalImpact <= throat;
    // The exact critical null ray has infinite affine/azimuthal extent and
    // zero screen measure. Band-limit that single sample to half a pixel in
    // impact space; neighboring noncritical rays retain their exact side.
    float pixelBand = max(2.0 / float(max(frame.resolution.y, 1u)), 2e-5);
    float side = crossed ? -1.0 : 1.0;
    float impact = originalImpact;
    if (abs(impact - throat) < pixelBand * 0.5) {
        impact = clamp(throat + side * pixelBand * 0.5,
                       0.0, 0.999999);
    }
    const uint intervals = 96u; // even Simpson interval count
    float maximumU;
    bool referenceCrossed = impact < throat;
    if (referenceCrossed) {
        float c = sqrt(max(throat * throat - impact * impact, 1e-12));
        maximumU = asinh(outerL / c);
    } else {
        float d = sqrt(max(impact * impact - throat * throat, 1e-12));
        maximumU = acosh(max(outerL / d, 1.0));
    }
    float sum = 0.0;
    for (uint index = 0u; index <= intervals; ++index) {
        float u = maximumU * float(index) / float(intervals);
        float denominator;
        if (referenceCrossed) {
            float c = sqrt(max(throat * throat - impact * impact, 1e-12));
            float hyperbolic = sinh(u);
            denominator = sqrt(max(throat * throat +
                c * c * hyperbolic * hyperbolic, 1e-12));
        } else {
            float d = sqrt(max(impact * impact - throat * throat, 1e-12));
            float hyperbolic = cosh(u);
            denominator = sqrt(max(throat * throat +
                d * d * hyperbolic * hyperbolic, 1e-12));
        }
        float value = impact / denominator;
        float weight = index == 0u || index == intervals ? 1.0
                     : (index & 1u) != 0u ? 4.0 : 2.0;
        sum += weight * value;
    }
    float azimuth = 2.0 * maximumU * sum / (3.0 * float(intervals));
#if VOXEL_GLOBAL_METRIC_LAB
    // The global lab uses the exact Ellis profile at every proper depth, so
    // no finite collar correction is applied.
#endif
    return azimuth;
}

IntrinsicEllisRayState traceIntrinsicEllisMouthReference(
    bool entryPositiveEnd, vec3 entryN, vec3 entryLocal) {
    IntrinsicEllisRayState result = IntrinsicEllisRayState(
        vec3(0.0), vec3(0.0, 0.0, -1.0), 0u, 96u, 2u, true);
    vec3 n = normalize(entryN);
    vec3 e1;
    vec3 e2;
    intrinsicAngularBasis(n, e1, e2);
    vec3 local = normalize(entryLocal);
    float tangentSpeed = clamp(length(local.yz), 0.0, 0.999999);
    vec3 tangent = tangentSpeed > 1e-7
        ? (e1 * local.y + e2 * local.z) / tangentSpeed : e1;
    vec3 planeAxis = normalize(cross(n, tangent));
    bool crossed;
    float azimuth = intrinsicEllisMouthAzimuthReference(
        tangentSpeed, crossed);
    bool positiveEnd = entryPositiveEnd ? !crossed : crossed;
    vec3 exitN = normalize(intrinsicRotateAxis(n, planeAxis, azimuth));
    vec3 exitTangent = normalize(intrinsicRotateAxis(
        tangent, planeAxis, azimuth));
    float radialSpeed = sqrt(max(1.0 -
        tangentSpeed * tangentSpeed, 0.0));
    float intrinsicRadial = positiveEnd ? radialSpeed : -radialSpeed;
    float contentRadial = positiveEnd ? intrinsicRadial : -intrinsicRadial;
    vec3 contentN = positiveEnd ? exitN : intrinsicRotateEndB(exitN);
    vec3 contentTangent = positiveEnd ? exitTangent
                                      : intrinsicRotateEndB(exitTangent);
    vec3 contentCenter = (positiveEnd ? intrinsicEndpointA.xyz
                                      : intrinsicEndpointB.xyz) *
        frame.planetRadius;
    float contentRadius = intrinsicAngular.w * frame.planetRadius;
    float epsilon = max(frame.hitEpsilon * 0.05, contentRadius * 2e-5);
    result.origin = contentCenter + contentN * (contentRadius + epsilon);
    result.direction = normalize(contentN * contentRadial +
                                 contentTangent * tangentSpeed);
    result.endIndex = positiveEnd ? 0u : 1u;
    result.finiteState = !any(isnan(result.origin)) &&
        !any(isinf(result.origin)) && !any(isnan(result.direction)) &&
        !any(isinf(result.direction));
    return result;
}

bool intrinsicRaySphere(vec3 origin, vec3 direction, vec3 center,
                        float radius, out float nearDistance) {
    vec3 relative = origin - center;
    float projected = dot(relative, direction);
    float discriminant = projected * projected -
        (dot(relative, relative) - radius * radius);
    if (discriminant < 0.0) {
        nearDistance = 0.0;
        return false;
    }
    float root = sqrt(max(discriminant, 0.0));
    float nearValue = -projected - root;
    float farValue = -projected + root;
    float epsilon = max(frame.hitEpsilon * 0.05, radius * 2e-5);
    if (farValue <= epsilon) {
        nearDistance = 0.0;
        return false;
    }
    nearDistance = max(nearValue, epsilon);
    return true;
}

IntrinsicEllisRayState traceIntrinsicAsymptoticRay(
    float cameraL, vec3 cameraN, vec3 localDirection) {
    bool positiveEnd = cameraL >= 0.0;
    vec3 n = normalize(cameraN);
    vec3 e1;
    vec3 e2;
    intrinsicAngularBasis(n, e1, e2);
    vec3 local = normalize(localDirection);
    vec3 contentN = positiveEnd ? n : intrinsicRotateEndB(n);
    vec3 contentTangent = e1 * local.y + e2 * local.z;
    if (!positiveEnd) {
        contentTangent = intrinsicRotateEndB(contentTangent);
    }
    float contentRadial = positiveEnd ? local.x : -local.x;
    vec3 center = (positiveEnd ? intrinsicEndpointA.xyz
                               : intrinsicEndpointB.xyz) * frame.planetRadius;
    float mouthRadius = intrinsicAngular.w * frame.planetRadius;
    float continuation = max(abs(cameraL) - intrinsicCamera.z, 0.0) *
        frame.planetRadius;
    IntrinsicEllisRayState direct = IntrinsicEllisRayState(
        center + contentN * (mouthRadius + continuation),
        normalize(contentN * contentRadial + contentTangent),
        positiveEnd ? 0u : 1u, 0u, 0u, true);
    direct.finiteState = !any(isnan(direct.origin)) &&
        !any(isinf(direct.origin)) && !any(isnan(direct.direction)) &&
        !any(isinf(direct.direction));
    if (!direct.finiteState) {
        return direct;
    }

    // Outside the native chart, ordinary content is authoritative until a
    // ray actually enters the spherical chart mouth. This gives the observer
    // an unbounded, C0-continuous Euclidean attachment instead of pinning it
    // to |l|=L. The conservative planet shell keeps foreground terrain from
    // being incorrectly bypassed by a mouth behind it.
    vec3 mouthCenters[2] = vec3[2](
        intrinsicEndpointA.xyz * frame.planetRadius,
        intrinsicEndpointB.xyz * frame.planetRadius);
    float mouthNear = 3.402823e38;
    uint mouthIndex = 2u;
    for (uint candidate = 0u; candidate < 2u; ++candidate) {
        float candidateNear = 0.0;
        if (intrinsicRaySphere(direct.origin, direct.direction,
                               mouthCenters[candidate], mouthRadius,
                               candidateNear) &&
            candidateNear < mouthNear) {
            mouthNear = candidateNear;
            mouthIndex = candidate;
        }
    }
    if (mouthIndex >= 2u) {
        return direct;
    }
    float planetNear = 0.0;
    float planetFar = 0.0;
    if (raySphereInterval(direct.origin, direct.direction,
                          frame.planetRadius * frame.planetOuterScale,
                          planetNear, planetFar) &&
        planetNear < mouthNear) {
        return direct;
    }

    // Both attachment mouths live in the same playable external chart. This
    // is a one-universe handle topology: A enters +l and B enters -l, while
    // the interior remains the exact two-ended Ellis manifold.
    bool entryPositiveEnd = mouthIndex == 0u;
    vec3 entryContentN = normalize(direct.origin + direct.direction *
        mouthNear - mouthCenters[mouthIndex]);
    vec3 entryN = entryPositiveEnd
        ? entryContentN : intrinsicRotateEndBInverse(entryContentN);
    vec3 entryDirection = entryPositiveEnd
        ? direct.direction : intrinsicRotateEndBInverse(direct.direction);
    float contentEntryRadial = dot(entryDirection, entryN);
    float chartEntryTolerance = max(
        frame.hitEpsilon / max(mouthRadius, 1e-6), 2e-5);
    if (contentEntryRadial >= -chartEntryTolerance) {
        // Half-open chart ownership: a tangent ray touches the overlap sphere
        // but never enters the Ellis chart. Sending that measure-zero set to
        // the curved integrator previously exhausted its exit classification
        // and leaked the red failure palette as a perfect mouth ring.
        return direct;
    }
    vec3 entryTangent = entryDirection - entryN * contentEntryRadial;
    vec3 entryE1;
    vec3 entryE2;
    intrinsicAngularBasis(entryN, entryE1, entryE2);
    float intrinsicEntryRadial = entryPositiveEnd
        ? contentEntryRadial : -contentEntryRadial;
    vec3 entryLocal = normalize(vec3(
        intrinsicEntryRadial, dot(entryTangent, entryE1),
        dot(entryTangent, entryE2)));
    IntrinsicEllisRayState curved = traceIntrinsicEllisCoreRay(
        entryPositiveEnd ? intrinsicCamera.z : -intrinsicCamera.z,
        entryN, entryLocal);
    if (!curved.finiteState) {
        // Near the critical impact, affine time diverges and a fixed RK4
        // budget cannot reach an exit. Resolve the actual Ellis exit with a
        // nonsingular transformed-variable reference integral instead of
        // returning a black external/background fallback band.
        IntrinsicEllisRayState reference = traceIntrinsicEllisMouthReference(
            entryPositiveEnd, entryN, entryLocal);
        if (reference.finiteState) {
            return reference;
        }
        atomicAdd(portalGrTelemetry.z, 1u);
        direct.pathClass = 3u;
        return direct;
    }
    return curved;
}

void prepareGlobalObserverSegment(vec3 localDirection);

// Smooth engineered same-universe handle metric.  This is a conformal static
// optical metric, not a vacuum GR solution.  Both mouth charts contribute via
// a C2 partition with non-compact tails; no finite sphere enables curvature.
#if VOXEL_GLOBAL_METRIC_LAB
void globalHandleLogConformal(vec3 position, out float value,
                              out vec3 gradient) {
    vec3 centers[2] = vec3[2](intrinsicEndpointA.xyz * frame.planetRadius,
                              intrinsicEndpointB.xyz * frame.planetRadius);
    // The metric core and topology event share the physical throat radius.
    // endpointA.w is a legacy content/camera standoff only; using it here
    // created the large fixed-radius aperture visible in the global lab.
    float mouth = max(intrinsicEndpointB.w * frame.planetRadius, 1e-5);
    float throat = mouth;
    float tail = max(intrinsicControl.z * frame.planetRadius, mouth * 2.0);
    float strength = clamp(intrinsicControl.w, 0.0, 4.0);
    vec3 radial[2];
    float s[2];
    float s4[2];
    float local[2];
    float localDerivative[2];
    for (uint i = 0u; i < 2u; ++i) {
        vec3 relative = position - centers[i];
        float radius = max(length(relative), 1e-8);
        radial[i] = relative / radius;
        float signedDistance = radius - mouth;
        s[i] = abs(signedDistance);
        float s2 = s[i] * s[i];
        s4[i] = s2 * s2;
        float denominator = s2 + throat * throat;
        local[i] = strength * throat * throat / denominator;
        localDerivative[i] = -2.0 * strength * throat * throat * s[i] /
            max(denominator * denominator, 1e-20);
        if (signedDistance < 0.0) localDerivative[i] *= -1.0;
    }
    float tail2 = tail * tail;
    float tail4 = tail2 * tail2;
    float denominator = s4[0] * s4[1] +
        tail4 * (s4[0] + s4[1]);
    if (!(denominator > 1e-20)) {
        value = strength;
        gradient = vec3(0.0);
        return;
    }
    float w0 = tail4 * s4[1] / denominator;
    float w1 = tail4 * s4[0] / denominator;
    value = w0 * local[0] + w1 * local[1];
    float dDen0 = 4.0 * s[0] * s[0] * s[0] * (s4[1] + tail4);
    float dDen1 = 4.0 * s[1] * s[1] * s[1] * (s4[0] + tail4);
    float den2 = denominator * denominator;
    float dw0s0 = -tail4 * s4[1] * dDen0 / den2;
    float dw0s1 = tail4 * 4.0 * s[1] * s[1] * s[1] / denominator -
                  tail4 * s4[1] * dDen1 / den2;
    float dw1s0 = tail4 * 4.0 * s[0] * s[0] * s[0] / denominator -
                  tail4 * s4[0] * dDen0 / den2;
    float dw1s1 = -tail4 * s4[0] * dDen1 / den2;
    float derivative0 = dw0s0 * local[0] + w0 * localDerivative[0] +
                        dw1s0 * local[1];
    float derivative1 = dw0s1 * local[0] + dw1s1 * local[1] +
                        w1 * localDerivative[1];
    gradient = radial[0] * derivative0 + radial[1] * derivative1;
}

bool globalHandleSegmentEntry(vec3 start, vec3 end, vec3 center,
                              float radius, out float fraction) {
    vec3 delta = end - start;
    vec3 relative = start - center;
    float aa = dot(delta, delta);
    float bb = 2.0 * dot(relative, delta);
    float cc = dot(relative, relative) - radius * radius;
    float boundaryRoundoff = 32.0 * 1.1920929e-7 *
        max(radius * radius, dot(relative, relative));
    // Deterministic half-open ownership for a boundary point rounded one ULP
    // inward.  Do not perturb q/direction: the zero-distance inward event is
    // the physical continuation and must be symmetric at both mouths.
    if (abs(cc) <= boundaryRoundoff && dot(relative, delta) < 0.0) {
        fraction = 0.0;
        return true;
    }
    float discriminant = bb * bb - 4.0 * aa * cc;
    if (!(aa > 1e-12) || discriminant < 0.0) return false;
    float candidate = (-bb - sqrt(max(discriminant, 0.0))) / (2.0 * aa);
    if (!(candidate >= 0.0 && candidate <= 1.0)) return false;
    vec3 normal = normalize(start + delta * candidate - center);
    if (dot(delta, normal) >= 0.0) return false;
    fraction = candidate;
    return true;
}

vec3 globalHandleRotateAcross(vec3 value, uint source) {
    return source == 0u ? intrinsicRotateEndB(value)
                        : intrinsicRotateEndBInverse(value);
}

bool globalHandleDerivative(vec3 position, vec3 direction,
                            out vec3 positionDerivative,
                            out vec3 directionDerivative,
                            out float curvature) {
    float phi;
    vec3 gradient;
    globalHandleLogConformal(position, phi, gradient);
    if (isnan(phi) || isinf(phi) || any(isnan(gradient)) ||
        any(isinf(gradient))) return false;
    float inverseConformal = exp(-phi);
    curvature = length(gradient);
    positionDerivative = direction * inverseConformal;
    directionDerivative = (gradient - direction * dot(direction, gradient)) *
                          inverseConformal;
    return !any(isnan(positionDerivative)) &&
           !any(isinf(positionDerivative)) &&
           !any(isnan(directionDerivative)) &&
           !any(isinf(directionDerivative));
}

// Embedded midpoint/RK4 pair.  The old Euler/midpoint estimate forced the
// critical family down to ~0.003R steps and routinely consumed the entire
// 256-step correctness budget.  RK4 supplies a smooth high-order accepted
// state while the independently lower-order midpoint result remains a real
// local error estimate; no radial/refinement class selects visibility.
bool globalHandleAdaptiveStep(vec3 position, vec3 direction,
                              float requestedStep, float planetRadius,
                              float startPhi, vec3 startGradient,
                              out vec3 nextPosition, out vec3 nextDirection,
                              out float acceptedStep,
                              out float curvature,
                              out uint refinements) {
    float stepLength = requestedStep;
    refinements = 0u;
    curvature = 0.0;
    float inverseConformal0 = exp(-startPhi);
    vec3 dx1 = direction * inverseConformal0;
    vec3 dd1 = (startGradient -
                direction * dot(direction, startGradient)) *
               inverseConformal0;
    for (uint refinement = 0u; refinement < 4u; ++refinement) {
        vec3 p2 = position + dx1 * (0.5 * stepLength);
        vec3 d2 = normalize(direction + dd1 * (0.5 * stepLength));
        vec3 dx2;
        vec3 dd2;
        float c2;
        if (!globalHandleDerivative(p2, d2, dx2, dd2, c2)) return false;
        vec3 p3 = position + dx2 * (0.5 * stepLength);
        vec3 d3 = normalize(direction + dd2 * (0.5 * stepLength));
        vec3 dx3;
        vec3 dd3;
        float c3;
        if (!globalHandleDerivative(p3, d3, dx3, dd3, c3)) return false;
        vec3 p4 = position + dx3 * stepLength;
        vec3 d4 = normalize(direction + dd3 * stepLength);
        vec3 dx4;
        vec3 dd4;
        float c4;
        if (!globalHandleDerivative(p4, d4, dx4, dd4, c4)) return false;
        vec3 rkPosition = position +
            (dx1 + 2.0 * dx2 + 2.0 * dx3 + dx4) *
            (stepLength / 6.0);
        vec3 rkDirection = normalize(direction +
            (dd1 + 2.0 * dd2 + 2.0 * dd3 + dd4) *
            (stepLength / 6.0));
        vec3 midpointPosition = position + dx2 * stepLength;
        vec3 midpointDirection = normalize(direction + dd2 * stepLength);
        float positionError = length(rkPosition - midpointPosition) /
                              max(planetRadius, 1e-5);
        float directionError = length(rkDirection - midpointDirection);
        float error = max(positionError, directionError);
        float tolerance = 2.0e-4;
        float minimumStep = planetRadius * 0.008;
        nextPosition = rkPosition;
        nextDirection = rkDirection;
        curvature = max(max(length(startGradient), c2), max(c3, c4));
        if (error <= tolerance || stepLength <= minimumStep) {
            acceptedStep = stepLength;
            return true;
        }
        stepLength *= 0.5;
        ++refinements;
    }
    acceptedStep = stepLength;
    return true;
}

void recordGlobalContentInterval(vec3 entryPosition, vec3 entryDirection,
                                 float contentOuter) {
    float segmentNear = 0.0;
    float segmentFar = 0.0;
    vec3 direction = normalize(entryDirection);
    vec3 queryOrigin = entryPosition;
    if (length(entryPosition) >= contentOuter) {
        queryOrigin += direction * max(
            frame.hitEpsilon * 0.01,
            frame.planetRadius * 2.0 * 1.1920929e-7);
    }
    if (!raySphereInterval(queryOrigin, direction, contentOuter,
                           segmentNear, segmentFar) ||
        !(segmentFar > 0.0)) {
        return;
    }
    if (globalObserverSegmentValid == 0u) {
        globalObserverSegmentOrigin = queryOrigin;
        globalObserverSegmentDirection = direction;
        globalObserverSegmentLimit = segmentFar;
        globalObserverSegmentValid = 1u;
        globalObserverBroadCandidate = 1u;
    }
    globalContentShellCrossing = 1u;
}

IntrinsicEllisRayState traceGlobalHandleRay(vec3 worldDirection) {
    vec3 centers[2] = vec3[2](intrinsicEndpointA.xyz * frame.planetRadius,
                              intrinsicEndpointB.xyz * frame.planetRadius);
    float mouth = max(intrinsicEndpointB.w * frame.planetRadius, 1e-5);
    vec3 position = intrinsicCamera.xyz * frame.planetRadius;
    vec3 direction = normalize(worldDirection);
    IntrinsicEllisRayState result = IntrinsicEllisRayState(
        position, direction, 2u, 0u, 1u, true);
    globalHandlePathActive = 1u;

    // The planet-centred shell is only a conservative content-query bound.
    // It records a local exact-DDA/media interval, but never terminates or
    // owns the global geodesic.  A camera already inside starts that interval
    // at its current position; outside observers record it at the actual
    // integrated entry event below.
    float contentOuter = frame.planetRadius * (frame.planetOuterScale + 0.30);
    if (length(position) < contentOuter) {
        recordGlobalContentInterval(position, direction, contentOuter);
    }

    float remaining = frame.planetRadius * 3.5;
    float observerPathDistance = 0.0;
    uint lastMouth = uint(clamp(intrinsicControl.x, 0.0, 2.0));
    float accumulatedCurvature = 0.0;
    // Near the throat the old 72-step cap could end a perfectly finite ray
    // before it reached either content or the full affine budget. Those rays
    // were then shaded as sky, producing the all-screen jump in the recorded
    // camera crossing. The adaptive solver remains bounded, but its budget is
    // now sufficient for the worst certified near-throat path.
    for (uint step = 0u; step < 256u && remaining > 1e-5; ++step) {
        float phi;
        vec3 gradient;
        globalHandleLogConformal(position, phi, gradient);
        if (isnan(phi) || isinf(phi) || any(isnan(gradient)) ||
            any(isinf(gradient))) {
            result.finiteState = false;
            return result;
        }
        float curvature = length(gradient);
        float requestedStep = min(remaining, clamp(
            frame.planetRadius * 0.32 /
                (1.0 + curvature * frame.planetRadius * 0.45),
            frame.planetRadius * 0.008, frame.planetRadius * 0.32));
        // Keep the event chord local near either throat so the exact
        // half-open sphere crossing cannot be skipped by a curved RK step.
        for (uint endpoint = 0u; endpoint < 2u; ++endpoint) {
            if (lastMouth == endpoint &&
                length(position - centers[endpoint]) < mouth * 1.10) {
                continue;
            }
            float surfaceDistance = abs(
                length(position - centers[endpoint]) - mouth);
            requestedStep = min(requestedStep, max(
                surfaceDistance * 0.45, frame.planetRadius * 0.0015));
        }
        vec3 candidate;
        vec3 candidateDirection;
        float properStep;
        uint stepRefinements;
        if (curvature * frame.planetRadius < 0.025) {
            properStep = requestedStep;
            float inverseConformal = exp(-phi);
            float euclideanLength = properStep * inverseConformal;
            vec3 bend = gradient - direction * dot(direction, gradient);
            vec3 midpointDirection = normalize(
                direction + bend * (0.5 * euclideanLength));
            candidate = position + midpointDirection * euclideanLength;
            candidateDirection = normalize(
                direction + bend * euclideanLength);
            stepRefinements = 0u;
        } else if (!globalHandleAdaptiveStep(
                       position, direction, requestedStep,
                       frame.planetRadius, phi, gradient,
                       candidate, candidateDirection, properStep, curvature,
                       stepRefinements)) {
                result.finiteState = false;
                return result;
        }
        float euclideanStep = length(candidate - position);

        float bestFraction = 2.0;
        uint source = 2u;
        for (uint endpoint = 0u; endpoint < 2u; ++endpoint) {
            if (lastMouth == endpoint &&
                length(position - centers[endpoint]) < mouth * 1.001) continue;
            float fraction = 0.0;
            if (globalHandleSegmentEntry(position, candidate,
                                         centers[endpoint], mouth, fraction) &&
                fraction < bestFraction) {
                bestFraction = fraction;
                source = endpoint;
            }
        }
        float contentFraction = 2.0;
        float possibleContentFraction = 0.0;
        bool entersContent = globalObserverSegmentValid == 0u &&
            length(position) > contentOuter &&
            globalHandleSegmentEntry(position, candidate, vec3(0.0),
                                     contentOuter,
                                     possibleContentFraction);
        if (entersContent) contentFraction = possibleContentFraction;

        // Interpolate the exact entry only to seed the bounded local content
        // query.  Unlike the rejected implementation, do not consume a
        // partial step, stop, restart, or change the ray family here.  The
        // global RK path continues through the same candidate and affine
        // budget, so tangent/inside/outside rays share one endpoint policy.
        if (contentFraction < bestFraction) {
            vec3 entryPosition = mix(position, candidate, contentFraction);
            vec3 entryDirection = normalize(mix(
                direction, candidateDirection, contentFraction));
            recordGlobalContentInterval(
                entryPosition, entryDirection, contentOuter);
        }
        if (source < 2u) {
            float crossingDistance = observerPathDistance +
                euclideanStep * bestFraction;
            if (globalObserverSegmentValid != 0u) {
                globalObserverSegmentLimit = min(
                    globalObserverSegmentLimit, crossingDistance);
            }
            globalObserverMouthIndex = source;
            position = mix(position, candidate, bestFraction);
            vec3 sourceN = normalize(position - centers[source]);
            uint destination = 1u - source;
            vec3 destinationN = normalize(globalHandleRotateAcross(
                -sourceN, source));
            float epsilon = max(mouth * (4.0 * 1.1920929e-7),
                                frame.hitEpsilon * 0.01);
            position = centers[destination] + destinationN *
                (mouth + epsilon);
            direction = normalize(globalHandleRotateAcross(
                normalize(mix(direction, candidateDirection, bestFraction)),
                source));
            lastMouth = destination;
            result.endIndex = destination;
            result.pathClass = 2u;
            float consumedProperStep = properStep * bestFraction;
            accumulatedCurvature += curvature * consumedProperStep;
            remaining -= consumedProperStep;
            observerPathDistance += euclideanStep * bestFraction;
            ++result.steps;
            // Continue the unconsumed part of this affine step from the
            // destination chart. Dropping it made camera and rays accumulate
            // different depth precisely on the body crossing frame.
            continue;
        } else {
            position = candidate;
            direction = candidateDirection;
            // Match the CPU camera's deterministic half-open chart owner.
            // The owner survives the remainder of a crossing step and is
            // released only outside the overlap neighborhood; otherwise the
            // first rendered frame after a body crossing can immediately
            // re-enter the destination mouth and select a different scene
            // family from the preceding optical frame.
            if (lastMouth < 2u &&
                length(position - centers[lastMouth]) > mouth * 1.10) {
                lastMouth = 2u;
            }
        }
        accumulatedCurvature += curvature * properStep;
        remaining -= properStep;
        observerPathDistance += euclideanStep;
        ++result.steps;

        // Hand the first possible content interval to exact event-DDA.  The
        // metric was integrated continuously up to this point; there is no
        // direct-vs-curved mouth policy or restart.
        // Do not terminate on a curvature/refinement class.  That former
        // threshold made neighboring pixels integrate different affine
        // extents and produced a fixed circular seam in stars and content.
        // All background rays now complete the same proper-distance budget;
        // content rays stop only at their exact query-boundary event above.
    }
    bool completedPath = remaining <= 1e-5;
    globalMetricBudgetExhausted = completedPath ? 0u : 1u;
    globalMetricPathSteps = result.steps;
    result.origin = position;
    result.direction = direction;
    result.finiteState = completedPath &&
                         !any(isnan(position)) && !any(isinf(position)) &&
                         !any(isnan(direction)) && !any(isinf(direction));
    intrinsicPathMaxCurvature = max(intrinsicPathMaxCurvature,
                                    accumulatedCurvature);
    float baseFootprint = 2.0 / max(float(frame.resolution.y), 1.0);
    globalStarAngularFootprint = baseFootprint *
        clamp(1.0 + accumulatedCurvature * frame.planetRadius * 0.02,
              1.0, 8.0);
    globalMetricMappedFinite = result.finiteState ? 1u : 0u;
    return result;
}
#endif

IntrinsicEllisRayState traceIntrinsicEllisRay(vec3 localDirection) {
#if VOXEL_GLOBAL_METRIC_LAB
    if (intrinsicControl.x < -0.5) {
        IntrinsicEllisRayState nativeRay = traceIntrinsicEllisCoreRay(
            intrinsicCamera.x, intrinsicAngular.xyz, localDirection);
        globalHandlePathActive = 1u;
        globalCurvedSelected = 1u;
        globalObserverMouthIndex = nativeRay.endIndex;
        globalMetricPathSteps += nativeRay.steps;
        return nativeRay;
    }
    return traceGlobalHandleRay(localDirection);
#else
    if (abs(intrinsicCamera.x) > intrinsicCamera.z) {
        return traceIntrinsicAsymptoticRay(
            intrinsicCamera.x, intrinsicAngular.xyz, localDirection);
    }
    return traceIntrinsicEllisCoreRay(
        intrinsicCamera.x, intrinsicAngular.xyz, localDirection);
#endif
}

#if VOXEL_GLOBAL_METRIC_LAB
void prepareGlobalObserverSegment(vec3 localDirection) {
    if (!(abs(intrinsicCamera.x) > intrinsicCamera.z)) {
        return;
    }
    bool positiveEnd = intrinsicCamera.x >= 0.0;
    vec3 n = normalize(intrinsicAngular.xyz);
    vec3 e1;
    vec3 e2;
    intrinsicAngularBasis(n, e1, e2);
    vec3 local = normalize(localDirection);
    vec3 contentN = positiveEnd ? n : intrinsicRotateEndB(n);
    vec3 contentTangent = e1 * local.y + e2 * local.z;
    if (!positiveEnd) {
        contentTangent = intrinsicRotateEndB(contentTangent);
    }
    float contentRadial = positiveEnd ? local.x : -local.x;
    vec3 center = (positiveEnd ? intrinsicEndpointA.xyz
                               : intrinsicEndpointB.xyz) *
                  frame.planetRadius;
    float observerRadius = intrinsicRadialProfile(
        intrinsicCamera.x, intrinsicCamera.y).x * frame.planetRadius;
    globalObserverSegmentOrigin = center + contentN * observerRadius;
    globalObserverSegmentDirection = normalize(
        contentN * contentRadial + contentTangent);
    bool finiteSegment = !any(isnan(globalObserverSegmentOrigin)) &&
        !any(isinf(globalObserverSegmentOrigin)) &&
        !any(isnan(globalObserverSegmentDirection)) &&
        !any(isinf(globalObserverSegmentDirection));
    if (!finiteSegment) {
        return;
    }

    float mouthRadius = intrinsicRadialProfile(
        intrinsicCamera.z, intrinsicCamera.y).x * frame.planetRadius;
    vec3 mouthCenters[2] = vec3[2](
        intrinsicEndpointA.xyz * frame.planetRadius,
        intrinsicEndpointB.xyz * frame.planetRadius);
    float mouthNear = kFarDistance;
    uint mouthIndex = 2u;
    for (uint candidate = 0u; candidate < 2u; ++candidate) {
        float candidateNear = 0.0;
        if (intrinsicRaySphere(globalObserverSegmentOrigin,
                               globalObserverSegmentDirection,
                               mouthCenters[candidate], mouthRadius,
                               candidateNear) && candidateNear < mouthNear) {
            mouthNear = candidateNear;
            mouthIndex = candidate;
        }
    }
    globalObserverSegmentLimit = mouthNear;
    globalObserverMouthIndex = mouthIndex;
    globalObserverSegmentValid = 1u;
    globalMetricMappedFinite = 1u;

    // This conservative shell is a workload hint only. It may request an
    // exact initial DDA/media query, but it can never select visibility.
    float sceneNear = 0.0;
    float sceneFar = 0.0;
    float sceneOuter = frame.planetRadius *
        (frame.planetOuterScale + 0.30);
    globalObserverBroadCandidate =
        raySphereInterval(globalObserverSegmentOrigin,
                          globalObserverSegmentDirection,
                          sceneOuter, sceneNear, sceneFar) &&
        sceneNear < mouthNear ? 1u : 0u;
}
#endif
#endif

#if VOXEL_GLOBAL_METRIC_LAB
void recordGlobalMetricRayTelemetry(uvec2 pixel, bool hitPlanet) {
    if (frame.geodesicTraversalMode != 5u ||
        (pixel.x & 3u) != 0u || (pixel.y & 3u) != 0u) {
        return;
    }
    atomicAdd(scaleTelemetryPadding[0], globalMetricMappedFinite);
    atomicAdd(scaleTelemetryPadding[1],
              globalMetricRadialClass == 1u ? 1u : 0u);
    atomicAdd(scaleTelemetryPadding[2],
              globalMetricRadialClass != 1u ? 1u : 0u);
    atomicAdd(scaleTelemetryPadding[3], globalMetricTerrainInterval);
    atomicAdd(scaleTelemetryPadding[4], globalMetricDdaCandidate);
    atomicAdd(scaleTelemetryPadding[5], hitPlanet ? 0u : 1u);
    atomicAdd(scaleMacroStats[0], globalMetricOriginRepair);
    atomicAdd(scaleMacroStats[1], globalMetricFrontFaceRejected);
    atomicAdd(scaleMacroStats[2], globalMetricFrontFaceRecovered);
    atomicAdd(scaleMacroStats[3], globalMetricTangentQ > 0.999 ? 1u : 0u);
    atomicAdd(scaleDdaHistogram[0],
              globalMetricRadialClass == 2u ? 1u : 0u);
    atomicAdd(scaleDdaHistogram[1], globalMetricAtmosphereInterval);
    atomicAdd(scaleDdaHistogram[2], globalMetricCloudInterval);
    atomicAdd(scaleDdaHistogram[3],
              globalMetricMappedFinite == 0u ? 1u : 0u);
    atomicAdd(scaleDdaHistogram[4], globalMetricBudgetExhausted);
    atomicAdd(scaleAtlasHistogram[0], globalObserverBroadCandidate);
    atomicAdd(scaleAtlasHistogram[1], globalObserverExactHit);
    atomicAdd(scaleAtlasHistogram[2], globalObserverSelected);
    atomicAdd(scaleAtlasHistogram[3], globalCurvedSelected);
    atomicAdd(scaleAtlasHistogram[4], globalObserverMediaComposited);
    atomicAdd(scaleAtlasHistogram[5],
              globalObserverMouthIndex == 0u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[6],
              globalObserverMouthIndex == 1u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[7],
              globalObserverMouthIndex >= 2u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[8],
              globalObserverExactHit != 0u &&
              globalObserverSelected == 0u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[9],
              globalObserverBroadCandidate != 0u &&
              globalCurvedSelected != 0u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[10],
              globalObserverBroadCandidate != 0u &&
              globalCurvedSelected != 0u &&
              globalObserverMouthIndex == 0u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[11],
              globalObserverBroadCandidate != 0u &&
              globalCurvedSelected != 0u &&
              globalObserverMouthIndex == 1u ? 1u : 0u);
    atomicAdd(scaleAtlasHistogram[12], globalContentShellCrossing);
}

void recordGlobalMetricCenterSample(uvec2 pixel, vec3 linearColor,
                                    bool hitPlanet, uint hitClass,
                                    float depth, vec3 mappedOrigin,
                                    vec3 mappedDirection) {
    if (any(notEqual(pixel, frame.resolution / 2u))) return;
    vec3 finiteColor = vec3(
        !isnan(linearColor.x) && !isinf(linearColor.x) ? linearColor.x : 0.0,
        !isnan(linearColor.y) && !isinf(linearColor.y) ? linearColor.y : 0.0,
        !isnan(linearColor.z) && !isinf(linearColor.z) ? linearColor.z : 0.0);
    atomicExchange(scaleAtlasHistogram[13], 1u);
    atomicExchange(scaleAtlasHistogram[14], floatBitsToUint(finiteColor.x));
    atomicExchange(scaleAtlasHistogram[15], floatBitsToUint(finiteColor.y));
    atomicExchange(scaleAtlasHistogram[16], floatBitsToUint(finiteColor.z));
    atomicExchange(scaleAtlasHistogram[17], hitPlanet ? 1u : 0u);
    atomicExchange(scaleAtlasHistogram[18], floatBitsToUint(depth));
    atomicExchange(scaleAtlasHistogram[19], floatBitsToUint(mappedOrigin.x));
    atomicExchange(scaleAtlasHistogram[20], floatBitsToUint(mappedOrigin.y));
    atomicExchange(scaleAtlasHistogram[21], floatBitsToUint(mappedOrigin.z));
    atomicExchange(scaleAtlasHistogram[22],
                   floatBitsToUint(mappedDirection.x));
    atomicExchange(scaleAtlasHistogram[23],
                   floatBitsToUint(mappedDirection.y));
    atomicExchange(scaleAtlasHistogram[24],
                   floatBitsToUint(mappedDirection.z));
    atomicExchange(scaleAtlasHistogram[25], hitClass);
    atomicExchange(scaleAtlasHistogram[26], globalObserverMouthIndex);
    atomicExchange(scaleAtlasHistogram[27],
                   floatBitsToUint(globalStarAngularFootprint));
}

#if !VOXEL_GLOBAL_SPATIAL_AA_PASS
bool enqueueGlobalSpatialAaCandidate(uvec2 pixel, vec2 screen,
                                     vec3 forward, vec3 right, vec3 up,
                                     vec3 mappedOrigin,
                                     vec3 mappedDirection) {
    uint debugMode = uint(clamp(intrinsicUp.w, 0.0, 10.0));
    bool enabled = intrinsicEndpointA.w > 0.5;
    bool sampledTelemetry = (pixel.x & 3u) == 0u &&
                            (pixel.y & 3u) == 0u;
    if (sampledTelemetry) {
        atomicAdd(scaleDdaHistogram[18], globalMetricPathSteps);
        atomicAdd(scaleDdaHistogram[19], 1u);
    }
    if (!enabled && debugMode < 7u) return false;
    vec3 worldDirection = normalize(
        forward + screen.x * right + screen.y * up);
    vec3 centers[2] = vec3[2](
        intrinsicEndpointA.xyz * frame.planetRadius,
        intrinsicEndpointB.xyz * frame.planetRadius);
    float mouth = max(intrinsicEndpointB.w * frame.planetRadius, 1e-5);
    float minimumMouthClearance = kFarDistance;
    vec3 observer = intrinsicCamera.xyz * frame.planetRadius;
    for (uint mouthIndex = 0u; mouthIndex < 2u; ++mouthIndex) {
        vec3 relative = observer - centers[mouthIndex];
        float along = max(-dot(relative, worldDirection), 0.0);
        float closest = length(relative + worldDirection * along);
        minimumMouthClearance = min(
            minimumMouthClearance, abs(closest - mouth) / mouth);
    }
    float closestT = max(-dot(mappedOrigin, mappedDirection), 0.0);
    float planetClearance = abs(length(mappedOrigin +
        mappedDirection * closestT) -
        frame.planetRadius * frame.planetOuterScale);
    float basePixel = 2.0 / max(float(frame.resolution.y), 1.0);
    float silhouetteWidth = max(basePixel * max(closestT, 1.0) * 3.0,
                                frame.hitEpsilon * 2.0);
    float curvatureDistortion = 1.0 +
        max(intrinsicPathMaxCurvature * frame.planetRadius, 0.0);
    uint reason = 0u;
    if (curvatureDistortion > max(intrinsicAngular.w, 1.01) * 3.0 ||
        minimumMouthClearance < 0.02) {
        reason |= 1u;
    }
    if (planetClearance < silhouetteWidth) reason |= 2u;
    if (sampledTelemetry) {
        atomicAdd(scaleDdaHistogram[10], 1u);
        atomicAdd(scaleDdaHistogram[5], reason != 0u ? 1u : 0u);
    }
    if (reason == 0u) return false;
    uint queueIndex = atomicAdd(scaleDdaHistogram[11], 1u);
    if (queueIndex < kArtifactDiagnosticCapacity) {
        uint storageIndex = kArtifactDiagnosticCapacity - 1u - queueIndex;
        artifactRecords[storageIndex].pixelClassTermination =
            uvec4(pixel, reason, 0u);
        atomicMax(scaleDdaHistogram[12], queueIndex / 16u + 1u);
        atomicMax(scaleDdaHistogram[13], 1u);
        atomicMax(scaleDdaHistogram[14], 1u);
        atomicMax(scaleDdaHistogram[15], queueIndex / 64u + 1u);
        atomicMax(scaleDdaHistogram[16], 1u);
        atomicMax(scaleDdaHistogram[17], 1u);
        return true;
    }
    return false;
}
#endif

#if VOXEL_GLOBAL_SPATIAL_AA_PASS
struct GlobalMetricRenderSample {
    vec3 radiance;
    vec3 mappedOrigin;
    vec3 mappedDirection;
    float depth;
    float curvatureCue;
    uint family;
    uint hitClass;
    uint steps;
    bool hit;
    bool finiteState;
};

void resetGlobalMetricSampleState() {
    traversalTermination = 0u;
    traversalTerminalTile = 0xffffffffu;
    traversalTerminalTravel = 0.0;
    traversalTerminalFar = 0.0;
    traversalTerminalCapDenominator = 0.0;
    traversalTerminalCapDistance = 0.0;
    traversalTerminalConeMargin = 0.0;
    traversalIntervalNear = 0.0;
    traversalIntervalFar = 0.0;
    productionTerrainHitSunVisibility = 1.0;
    productionCloudHitSunVisibility = 1.0;
    globalMetricMappedFinite = 0u;
    globalMetricRadialClass = 2u;
    globalMetricTangentQ = 0.0;
    globalMetricTerrainInterval = 0u;
    globalMetricDdaCandidate = 0u;
    globalMetricOriginRepair = 0u;
    globalMetricFrontFaceRejected = 0u;
    globalMetricFrontFaceRecovered = 0u;
    globalMetricAtmosphereInterval = 0u;
    globalMetricCloudInterval = 0u;
    globalMetricBudgetExhausted = 0u;
    globalMetricPathSteps = 0u;
    globalObserverSegmentOrigin = vec3(0.0);
    globalObserverSegmentDirection = vec3(0.0, 0.0, -1.0);
    globalObserverSegmentLimit = 0.0;
    globalObserverSegmentValid = 0u;
    globalObserverBroadCandidate = 0u;
    globalObserverExactHit = 0u;
    globalObserverSelected = 0u;
    globalCurvedSelected = 0u;
    globalObserverMediaComposited = 0u;
    globalObserverMouthIndex = 2u;
    globalHandlePathActive = 0u;
    globalContentShellCrossing = 0u;
    intrinsicPathMaxCurvature = 0.0;
    globalStarAngularFootprint = 2.0 /
        max(float(frame.resolution.y), 1.0);
}

GlobalMetricRenderSample renderGlobalMetricSample(
    uvec2 pixel, vec3 worldDirection, bool collectCentralTelemetry) {
    resetGlobalMetricSampleState();
    IntrinsicEllisRayState intrinsicRay = traceGlobalHandleRay(worldDirection);
    GlobalMetricRenderSample renderSample;
    renderSample.radiance = vec3(0.0);
    renderSample.mappedOrigin = intrinsicRay.origin;
    renderSample.mappedDirection = intrinsicRay.direction;
    renderSample.depth = kFarDistance;
    renderSample.curvatureCue = intrinsicPathMaxCurvature * frame.planetRadius;
    renderSample.family = intrinsicRay.endIndex & 1u;
    renderSample.hitClass = 7u;
    renderSample.steps = intrinsicRay.steps;
    renderSample.hit = false;
    renderSample.finiteState = intrinsicRay.finiteState;
    if (!intrinsicRay.finiteState) {
        renderSample.radiance = spaceBackground(
            intrinsicRay.origin, normalize(worldDirection));
        if (collectCentralTelemetry) {
            recordGlobalMetricRayTelemetry(pixel, false);
        }
        return renderSample;
    }

    vec3 contentOrigin = intrinsicRay.origin;
    vec3 contentDirection = intrinsicRay.direction;
    bool hitPlanet = false;
    uint hitClass = 0u;
    GeodesicHitDebug debugHit;
    vec3 color;

    bool observerHit = false;
    uint observerHitClass = 0u;
    GeodesicHitDebug observerDebugHit;
    vec3 observerColor = vec3(0.0);
    if (globalObserverSegmentValid != 0u &&
        globalObserverBroadCandidate != 0u) {
        observerColor = shadeGeodesicPlanet(
            globalObserverSegmentOrigin, globalObserverSegmentDirection,
            observerHit, observerHitClass, observerDebugHit);
    }
    bool observerOwns = observerHit &&
        observerDebugHit.distance < globalObserverSegmentLimit;
    globalObserverExactHit = observerOwns ? 1u : 0u;
    if (observerOwns) {
        globalObserverSelected = 1u;
        contentOrigin = globalObserverSegmentOrigin;
        contentDirection = globalObserverSegmentDirection;
        hitPlanet = true;
        hitClass = observerHitClass;
        debugHit = observerDebugHit;
        color = observerColor;
        renderSample.family |= 1u << 2u;
    } else {
        globalCurvedSelected = 1u;
        // The completed global geodesic supplies the ordered destination
        // content query. Unlike the rejected shell endpoint, this origin and
        // direction are continuous for inside/tangent/outside rays.
        color = shadeGeodesicPlanet(
            contentOrigin, contentDirection,
            hitPlanet, hitClass, debugHit);
        if (!hitPlanet) {
            color = spaceBackground(contentOrigin, contentDirection);
        }
    }

    if (!observerOwns) {
        color = applyProductionAtmosphere(
            contentOrigin, contentDirection,
            hitPlanet ? debugHit.distance : kFarDistance, color);
        color = applyProductionClouds(
            contentOrigin, contentDirection,
            hitPlanet ? debugHit.distance : kFarDistance, color);
    }
    if (globalObserverSegmentValid != 0u &&
        globalObserverSegmentLimit > 0.0 &&
        globalObserverSegmentLimit < kFarDistance) {
        float mediumDistance = observerOwns
            ? min(observerDebugHit.distance, globalObserverSegmentLimit)
            : globalObserverSegmentLimit;
        color = applyProductionAtmosphere(
            globalObserverSegmentOrigin, globalObserverSegmentDirection,
            mediumDistance, color);
        color = applyProductionClouds(
            globalObserverSegmentOrigin, globalObserverSegmentDirection,
            mediumDistance, color);
        bool atmosphereActive =
            (frame.simulationTick & (1u << 27u)) != 0u;
        bool cloudsActive = productionCloudSettings().enabled;
        globalObserverMediaComposited =
            atmosphereActive || cloudsActive ? 1u : 0u;
    }

    renderSample.radiance = color;
    renderSample.mappedOrigin = observerOwns
        ? globalObserverSegmentOrigin : intrinsicRay.origin;
    renderSample.mappedDirection = observerOwns
        ? globalObserverSegmentDirection : intrinsicRay.direction;
    renderSample.depth = hitPlanet ? debugHit.distance : kFarDistance;
    renderSample.hitClass = hitPlanet ? hitClass : 7u;
    renderSample.hit = hitPlanet;
    renderSample.family |= (hitPlanet ? 1u : 0u) << 3u;
    renderSample.family |= (min(hitClass, 7u) & 7u) << 4u;
    if (collectCentralTelemetry) {
        recordGlobalMetricRayTelemetry(pixel, hitPlanet);
    }
    return renderSample;
}

void globalMetricAngularBasis(vec3 direction, out vec3 axisU,
                              out vec3 axisV) {
    vec3 reference = abs(direction.y) < 0.92
        ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    axisU = normalize(cross(reference, direction));
    axisV = normalize(cross(direction, axisU));
}

float globalMetricJacobianDeterminant(
    vec3 directions[4], vec2 offsets[4], vec3 centerDirection,
    out float distortion) {
    vec3 axisU;
    vec3 axisV;
    globalMetricAngularBasis(centerDirection, axisU, axisV);
    vec2 inputA = offsets[2] - offsets[0];
    vec2 inputB = offsets[3] - offsets[1];
    vec2 outputA = vec2(dot(directions[2] - directions[0], axisU),
                        dot(directions[2] - directions[0], axisV));
    vec2 outputB = vec2(dot(directions[3] - directions[1], axisU),
                        dot(directions[3] - directions[1], axisV));
    float inputDet = inputA.x * inputB.y - inputA.y * inputB.x;
    float outputDet = outputA.x * outputB.y - outputA.y * outputB.x;
    float scaleA = length(outputA) / max(length(inputA), 1e-8);
    float scaleB = length(outputB) / max(length(inputB), 1e-8);
    distortion = max(scaleA, scaleB) /
                 max(min(scaleA, scaleB), 1e-6);
    return abs(inputDet) > 1e-12 ? outputDet / inputDet : 0.0;
}

vec3 renderGlobalMetricAdaptivePixel(
    uvec2 pixel, uint candidateReason, vec2 screen,
    vec3 forward, vec3 right, vec3 up, out bool overwritePixel) {
    vec3 centerWorldDirection = normalize(
        forward + screen.x * right + screen.y * up);
    overwritePixel = true;
    uint debugMode = uint(clamp(intrinsicUp.w, 0.0, 10.0));
    float distortionThreshold = max(intrinsicAngular.w, 1.01);
    float magnificationThreshold = max(intrinsicEndBRotation.w, 1.01);
    float basePixel = 2.0 / max(float(frame.resolution.y), 1.0);
    bool silhouetteCandidate = (candidateReason & 2u) != 0u;
    bool sampledTelemetry = (pixel.x & 3u) == 0u &&
                            (pixel.y & 3u) == 0u;

    // Deterministic rotated-grid pattern.  It is fixed in pixel space and has
    // no frame/time/hash term, so subpixel camera motion cannot shimmer.
    vec2 offsets[4] = vec2[4](vec2(-0.375, -0.125),
                              vec2( 0.125, -0.375),
                              vec2( 0.375,  0.125),
                              vec2(-0.125,  0.375));
    GlobalMetricRenderSample samples[4];
    vec3 mappedDirections[4];
    vec3 inputDirections[4];
    uint familyTransitions = 0u;
    bool hitTransition = false;
    float minimumDepth = kFarDistance;
    float maximumDepth = 0.0;
    for (uint sampleIndex = 0u; sampleIndex < 4u; ++sampleIndex) {
        vec2 sampleScreen = screen + offsets[sampleIndex] * basePixel;
        inputDirections[sampleIndex] = normalize(
            forward + sampleScreen.x * right + sampleScreen.y * up);
        samples[sampleIndex] = renderGlobalMetricSample(
            pixel, inputDirections[sampleIndex], false);
        mappedDirections[sampleIndex] = samples[sampleIndex].mappedDirection;
        if (sampleIndex != 0u) {
            familyTransitions += samples[sampleIndex].family !=
                samples[0].family ? 1u : 0u;
            hitTransition = hitTransition || samples[sampleIndex].hit !=
                samples[0].hit;
        }
        if (samples[sampleIndex].hit) {
            minimumDepth = min(minimumDepth, samples[sampleIndex].depth);
            maximumDepth = max(maximumDepth, samples[sampleIndex].depth);
        }
    }
    float mappedDistortion;
    float mappedDet = globalMetricJacobianDeterminant(
        mappedDirections, offsets, mappedDirections[0],
        mappedDistortion);
    float inputDistortion;
    float inputDet = globalMetricJacobianDeterminant(
        inputDirections, offsets, centerWorldDirection, inputDistortion);
    float relativeDet = abs(inputDet) > 1e-8 ? mappedDet / inputDet : 0.0;
    float magnification = sqrt(max(abs(relativeDet), 0.0));
    float relativeDistortion = mappedDistortion /
        max(inputDistortion, 1e-6);
    bool parityChange = relativeDet < 0.0;
    bool depthDiscontinuity = maximumDepth > 0.0 &&
        minimumDepth < kFarDistance &&
        maximumDepth - minimumDepth > max(minimumDepth * 0.08,
                                           frame.hitEpsilon * 8.0);
    bool rapidJacobian = magnification > magnificationThreshold ||
        magnification < 1.0 / magnificationThreshold ||
        relativeDistortion > distortionThreshold ||
        relativeDistortion < 1.0 / distortionThreshold;
    bool coverageTransition = familyTransitions != 0u || hitTransition ||
                              depthDiscontinuity || parityChange;
    bool useFourSamples = rapidJacobian || coverageTransition ||
                          silhouetteCandidate;
    if (sampledTelemetry) {
        atomicAdd(scaleDdaHistogram[6], useFourSamples ? 1u : 0u);
        atomicAdd(scaleDdaHistogram[7], coverageTransition ? 1u : 0u);
        atomicAdd(scaleDdaHistogram[8], useFourSamples ? 4u : 0u);
        atomicAdd(scaleDdaHistogram[9], useFourSamples ? 0u : 1u);
    }

    if (debugMode == 7u) {
        return useFourSamples ? vec3(0.12, 0.95, 0.32)
             : vec3(0.95, 0.52, 0.08);
    }
    if (debugMode == 8u) {
        float determinantTone = clamp(log2(1.0 + abs(relativeDet)) / 5.0,
                                      0.08, 1.0);
        return relativeDet < 0.0
            ? vec3(0.10, 0.32, 1.0) * determinantTone
            : vec3(1.0, 0.30, 0.08) * determinantTone;
    }
    if (debugMode == 9u) {
        float heat = clamp(abs(log2(max(magnification, 1e-5))) / 4.0,
                           0.0, 1.0);
        return mix(vec3(0.02, 0.10, 0.20),
                   vec3(1.0, 0.18, 0.02), heat);
    }
    if (debugMode == 10u) {
        return coverageTransition ? vec3(1.0, 0.0, 0.8)
             : useFourSamples ? vec3(0.12, 0.90, 0.30)
                              : vec3(0.95, 0.52, 0.08);
    }
    if (!useFourSamples) {
        overwritePixel = false;
        return vec3(0.0);
    }

    // Each subray remains an independent first-hit/media sample.  Their HDR
    // radiance is integrated as deterministic subpixel coverage; depths or
    // unrelated family states are never averaged into a fabricated ray.
    return 0.25 * (samples[0].radiance + samples[1].radiance +
                   samples[2].radiance + samples[3].radiance);
}

vec2 globalMetricOctEncode(vec3 direction) {
    direction /= max(abs(direction.x) + abs(direction.y) +
                     abs(direction.z), 1e-8);
    vec2 encoded = direction.xy;
    if (direction.z < 0.0) {
        encoded = (1.0 - abs(encoded.yx)) * sign(encoded.xy);
    }
    return clamp(encoded, -1.0, 1.0);
}

vec3 globalMetricOctDecode(vec2 encoded) {
    vec3 direction = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (direction.z < 0.0) {
        direction.xy = (1.0 - abs(direction.yx)) * sign(direction.xy);
    }
    return normalize(direction);
}

void storeGlobalMetricAaSubray(uint recordIndex, uint sampleIndex,
                               GlobalMetricRenderSample renderSample) {
    uvec4 packed = uvec4(
        packHalf2x16(clamp(renderSample.radiance.rg,
                           vec2(0.0), vec2(65504.0))),
        packHalf2x16(vec2(clamp(renderSample.radiance.b, 0.0, 65504.0),
                          clamp(renderSample.depth, 0.0, 65504.0))),
        packSnorm2x16(globalMetricOctEncode(renderSample.mappedDirection)),
        renderSample.family | (renderSample.finiteState ? 0u : 0x80000000u));
    if (sampleIndex == 0u) artifactRecords[recordIndex].cell = packed;
    else if (sampleIndex == 1u) artifactRecords[recordIndex].footprint = packed;
    else if (sampleIndex == 2u) artifactRecords[recordIndex].ray = packed;
    else artifactRecords[recordIndex].state = packed;
}

uvec4 loadGlobalMetricAaSubray(uint recordIndex, uint sampleIndex) {
    if (sampleIndex == 0u) return artifactRecords[recordIndex].cell;
    if (sampleIndex == 1u) return artifactRecords[recordIndex].footprint;
    if (sampleIndex == 2u) return artifactRecords[recordIndex].ray;
    return artifactRecords[recordIndex].state;
}

vec3 resolveGlobalMetricAaPixel(uint recordIndex, uvec2 pixel,
                                uint candidateReason, vec2 screen,
                                vec3 forward, vec3 right, vec3 up,
                                out bool overwritePixel) {
    vec2 offsets[4] = vec2[4](vec2(-0.375, -0.125),
                              vec2( 0.125, -0.375),
                              vec2( 0.375,  0.125),
                              vec2(-0.125,  0.375));
    float basePixel = 2.0 / max(float(frame.resolution.y), 1.0);
    vec3 radiance[4];
    vec3 mappedDirections[4];
    vec3 inputDirections[4];
    float depths[4];
    uint families[4];
    bool allFinite = true;
    for (uint sampleIndex = 0u; sampleIndex < 4u; ++sampleIndex) {
        uvec4 packed = loadGlobalMetricAaSubray(recordIndex, sampleIndex);
        vec2 rg = unpackHalf2x16(packed.x);
        vec2 bd = unpackHalf2x16(packed.y);
        radiance[sampleIndex] = vec3(rg, bd.x);
        depths[sampleIndex] = bd.y;
        mappedDirections[sampleIndex] = globalMetricOctDecode(
            unpackSnorm2x16(packed.z));
        families[sampleIndex] = packed.w & 0x7fffffffu;
        allFinite = allFinite && (packed.w & 0x80000000u) == 0u;
        vec2 sampleScreen = screen + offsets[sampleIndex] * basePixel;
        inputDirections[sampleIndex] = normalize(
            forward + sampleScreen.x * right + sampleScreen.y * up);
    }
    vec3 centerWorldDirection = normalize(
        forward + screen.x * right + screen.y * up);
    float mappedDistortion;
    float mappedDet = globalMetricJacobianDeterminant(
        mappedDirections, offsets, mappedDirections[0], mappedDistortion);
    float inputDistortion;
    float inputDet = globalMetricJacobianDeterminant(
        inputDirections, offsets, centerWorldDirection, inputDistortion);
    float relativeDet = abs(inputDet) > 1e-8 ? mappedDet / inputDet : 0.0;
    float magnification = sqrt(max(abs(relativeDet), 0.0));
    float relativeDistortion = mappedDistortion /
        max(inputDistortion, 1e-6);
    uint familyTransitions = 0u;
    float minimumDepth = kFarDistance;
    float maximumDepth = 0.0;
    for (uint sampleIndex = 0u; sampleIndex < 4u; ++sampleIndex) {
        if (sampleIndex != 0u) {
            familyTransitions += families[sampleIndex] != families[0]
                ? 1u : 0u;
        }
        bool hit = (families[sampleIndex] & (1u << 3u)) != 0u;
        if (hit) {
            minimumDepth = min(minimumDepth, depths[sampleIndex]);
            maximumDepth = max(maximumDepth, depths[sampleIndex]);
        }
    }
    bool depthDiscontinuity = maximumDepth > 0.0 &&
        minimumDepth < kFarDistance &&
        maximumDepth - minimumDepth > max(minimumDepth * 0.08,
                                           frame.hitEpsilon * 8.0);
    bool parityChange = relativeDet < 0.0;
    float distortionThreshold = max(intrinsicAngular.w, 1.01);
    float magnificationThreshold = max(intrinsicEndBRotation.w, 1.01);
    bool rapidJacobian = magnification > magnificationThreshold ||
        magnification < 1.0 / magnificationThreshold ||
        relativeDistortion > distortionThreshold ||
        relativeDistortion < 1.0 / distortionThreshold;
    bool coverageTransition = familyTransitions != 0u ||
        depthDiscontinuity || parityChange || !allFinite;
    bool silhouetteCandidate = (candidateReason & 2u) != 0u;
    bool useFourSamples = rapidJacobian || coverageTransition ||
                          silhouetteCandidate;
    bool sampledTelemetry = (pixel.x & 3u) == 0u &&
                            (pixel.y & 3u) == 0u;
    if (sampledTelemetry) {
        atomicAdd(scaleDdaHistogram[6], useFourSamples ? 1u : 0u);
        atomicAdd(scaleDdaHistogram[7], coverageTransition ? 1u : 0u);
        atomicAdd(scaleDdaHistogram[8], useFourSamples ? 4u : 0u);
        atomicAdd(scaleDdaHistogram[9], useFourSamples ? 0u : 1u);
    }
    uint debugMode = uint(clamp(intrinsicUp.w, 0.0, 10.0));
    overwritePixel = useFourSamples || debugMode >= 7u;
    if (debugMode == 7u) {
        return useFourSamples ? vec3(0.12, 0.95, 0.32)
                              : vec3(0.95, 0.52, 0.08);
    }
    if (debugMode == 8u) {
        float determinantTone = clamp(log2(1.0 + abs(relativeDet)) / 5.0,
                                      0.08, 1.0);
        return relativeDet < 0.0
            ? vec3(0.10, 0.32, 1.0) * determinantTone
            : vec3(1.0, 0.30, 0.08) * determinantTone;
    }
    if (debugMode == 9u) {
        float heat = clamp(abs(log2(max(magnification, 1e-5))) / 4.0,
                           0.0, 1.0);
        return mix(vec3(0.02, 0.10, 0.20),
                   vec3(1.0, 0.18, 0.02), heat);
    }
    if (debugMode == 10u) {
        return coverageTransition ? vec3(1.0, 0.0, 0.8)
             : useFourSamples ? vec3(0.12, 0.90, 0.30)
                              : vec3(0.95, 0.52, 0.08);
    }
    if (!useFourSamples) return vec3(0.0);
    return 0.25 * (radiance[0] + radiance[1] +
                   radiance[2] + radiance[3]);
}
