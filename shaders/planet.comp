                                // for color proof, but no aggregate counters.
                            } else if (closestApproach < 0.94) {
                                atomicAdd(artifactHorizonCounts.x, 1u);
                            } else if (closestApproach < 0.97) {
                                atomicAdd(artifactHorizonCounts.y, 1u);
                            } else if (closestApproach < 1.0) {
                                atomicAdd(artifactHorizonCounts.z, 1u);
                            } else {
                                atomicAdd(artifactHorizonCounts.w, 1u);
                            }
                        }
                    }
                }
            }
            if (rayStatusOverlay &&
                (sampledHorizonRay || centerProbe ||
                 diagnosticClass == 6u || diagnosticClass == 8u)) {
                // Record every pixel in the horizon band, the 3x3 center
                // probe, and every non-ordinary miss. This maps an observed
                // overlay pixel directly to its GPU traversal state without
                // consulting the procedural background path.
                recordDiagnostic = true;
            }
            if (failureOnlyOverlay) {
                // Lightweight proof mode is visual-only. Never touch the
                // readback buffer; confirmed failures are colored below.
                recordDiagnostic = false;
            }
            if (recordDiagnostic) {
                uint recordIndex = atomicAdd(artifactControl.x, 1u);
                if (recordIndex < kArtifactDiagnosticCapacity) {
                    artifactRecords[recordIndex].pixelClassTermination =
                        uvec4(pixel, diagnosticClass, traversalTermination);
                    artifactRecords[recordIndex].cell = uvec4(
                        debugHit.tile, debugHit.layer, debugHit.neighbor,
                        debugHit.columnHeight);
                    artifactRecords[recordIndex].footprint = uvec4(
                        floatBitsToUint(debugHit.distance),
                        floatBitsToUint(debugHit.geometryDetail),
                        floatBitsToUint(debugHit.sideIncidence),
                        floatBitsToUint(debugHit.projectedWidth));
                    artifactRecords[recordIndex].ray = uvec4(
                        floatBitsToUint(debugHit.projectedHeight),
                        floatBitsToUint(rayDirection.x),
                        floatBitsToUint(rayDirection.y),
                        floatBitsToUint(rayDirection.z));
                    artifactRecords[recordIndex].state = uvec4(
                        debugHit.neighborHeight, debugHit.material,
                        floatBitsToUint(debugHit.sideMask),
                        floatBitsToUint(debugHit.localInteriorPixels));
                    float candidateDistance = hitPlanet
                        ? debugHit.distance : traversalTerminalCapDistance;
                    artifactRecords[recordIndex].intervalCandidate = uvec4(
                        floatBitsToUint(traversalIntervalNear),
                        floatBitsToUint(traversalIntervalFar),
                        floatBitsToUint(candidateDistance),
                        floatBitsToUint(closestApproach));
                    artifactRecords[recordIndex].normalMaterial = uvec4(
                        floatBitsToUint(debugHit.normal.x),
                        floatBitsToUint(debugHit.normal.y),
                        floatBitsToUint(debugHit.normal.z),
                        debugHit.material);
                } else {
                    atomicAdd(artifactControl.y, 1u);
                }
            }
            if (rayStatusOverlay) {
                if (hitPlanet) {
                    color = hitClass == 0u ? vec3(0.10, 0.85, 0.28)
                          : hitClass == 1u ? vec3(0.08, 0.42, 0.72)
                          : hitClass == 2u ? vec3(0.0, 0.85, 0.90)
                          : hitClass == 3u ? vec3(1.0, 0.48, 0.02)
                          : hitClass == 4u ? vec3(0.92)
                                           : vec3(1.0, 0.15, 0.65);
                } else {
                    bool coverageFailure = diagnosticClass == 6u ||
                        diagnosticClass == 8u;
                    if (!coverageFailure) {
                        // Different blue levels retain the raw termination
                        // distinction without labelling an exact-resolver-
                        // validated empty shell as a lost terrain hit.
                        color = traversalTermination == 1u
                            ? vec3(0.03, 0.10, 0.34)
                            : traversalTermination == 3u
                                ? vec3(0.08, 0.18, 0.42)
                                : vec3(0.13, 0.20, 0.46);
                    } else {
                        color = traversalTermination == 3u
                            ? vec3(1.0, 0.0, 1.0)
                            : traversalTermination == 4u
                                ? vec3(1.0, 0.0, 0.0)
                                : traversalTermination == 5u
                                    ? vec3(1.0, 0.92, 0.0)
                                    : vec3(0.55, 0.1, 0.8);
                    }
                }
                imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
                return;
            }
            if (failureOnlyOverlay && !hitPlanet &&
                (diagnosticClass == 6u || diagnosticClass == 8u)) {
                color = traversalTermination == 3u ? vec3(1.0, 0.0, 1.0)
                      : traversalTermination == 4u ? vec3(1.0, 0.0, 0.0)
                      : traversalTermination == 5u ? vec3(1.0, 0.92, 0.0)
                                                   : vec3(0.55, 0.1, 0.8);
                imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
                return;
            }
        }
        if (frame.geodesicTraversalMode == 3u ||
            frame.geodesicTraversalMode == 4u) {
            if (!hitPlanet) {
                float shellNear = 0.0;
                float shellFar = 0.0;
                bool crossesConservativeBound = raySphereInterval(
                    cameraPosition, rayDirection,
                    frame.planetRadius * frame.planetOuterScale,
                    shellNear, shellFar);
                color = crossesConservativeBound
                    ? vec3(1.0, 0.0, 1.0)
                    : vec3(0.0);
            } else if (frame.geodesicTraversalMode == 4u) {
                color = vec3(0.42);
            } else {
                color = hitClass == 0u ? vec3(0.42)
                      : hitClass == 1u ? vec3(0.1, 0.25, 1.0)
                      : hitClass == 2u ? vec3(0.0, 1.0, 1.0)
                      : hitClass == 3u ? vec3(1.0, 1.0, 0.0)
                      : hitClass == 4u ? vec3(1.0)
                                       : vec3(1.0, 0.0, 0.0);
            }
            imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
            return;
        }
        if (!hitPlanet) {
            color = spaceBackground(cameraPosition, rayDirection);
        }
#if !VOXEL_SCALE_LAB && !VOXEL_ADAPTIVE_SDF_LAB && \
    !VOXEL_FRACTAL_PLANET_SDF_LAB
#if VOXEL_GLOBAL_METRIC_LAB
        // Integrate participating media only over the finite content interval
        // encountered by the continuous global path.  A miss uses the fully
        // integrated geodesic for its sky/star direction; the former 1.30R
        // shell never supplies a separate background endpoint.
        if (!observerOwns) {
            color = applyProductionAtmosphere(
                cameraPosition, rayDirection,
                hitPlanet ? debugHit.distance : kFarDistance, color);
            color = applyProductionClouds(
                cameraPosition, rayDirection,
                hitPlanet ? debugHit.distance : kFarDistance, color);
        }
        if (globalObserverSegmentValid != 0u &&
            globalObserverSegmentLimit > 0.0 &&
            globalObserverSegmentLimit < kFarDistance) {
            float mediumDistance = observerOwns
                ? min(observerDebugHit.distance,
                      globalObserverSegmentLimit)
                : globalObserverSegmentLimit;
            color = applyProductionAtmosphere(
                globalObserverSegmentOrigin,
                globalObserverSegmentDirection,
                mediumDistance, color);
            color = applyProductionClouds(
                globalObserverSegmentOrigin,
                globalObserverSegmentDirection,
                mediumDistance, color);
            bool atmosphereActive =
                (frame.simulationTick & (1u << 27u)) != 0u;
            bool cloudsActive = productionCloudSettings().enabled;
            globalObserverMediaComposited =
                atmosphereActive || cloudsActive ? 1u : 0u;
        }
#else
        // The exact terrain result remains authoritative. Atmosphere only
        // integrates the camera-to-hit segment (or the finite shell for a sky
        // miss), so it cannot alter depth, coverage, picking, or collision.
        color = applyProductionAtmosphere(
            cameraPosition, rayDirection,
            hitPlanet ? debugHit.distance : kFarDistance, color);
        // Clouds are a participating medium in front of the already shaded
        // terrain/atmosphere/star scene. They never alter the exact terrain
        // hit, depth, traversal ownership, picking, or collision result.
        color = applyProductionClouds(
            cameraPosition, rayDirection,
            hitPlanet ? debugHit.distance : kFarDistance, color);
#endif
#endif
#if VOXEL_GLOBAL_METRIC_LAB
        bool aaQueued = enqueueGlobalSpatialAaCandidate(
            pixel, screen, forward, right, up,
            cameraPosition, rayDirection);
        uint aaDebugMode = uint(clamp(intrinsicUp.w, 0.0, 10.0));
        if (aaDebugMode >= 7u && !aaQueued) {
            color = aaDebugMode == 7u ? vec3(0.02, 0.08, 0.16)
                  : aaDebugMode == 8u ? vec3(0.08, 0.22, 0.08)
                  : aaDebugMode == 9u ? vec3(0.02, 0.06, 0.12)
                                       : vec3(0.03, 0.12, 0.05);
        }
        recordGlobalMetricRayTelemetry(pixel, hitPlanet);
        recordGlobalMetricCenterSample(
            pixel, color, hitPlanet, hitPlanet ? hitClass : 7u,
            hitPlanet ? debugHit.distance : kFarDistance,
            cameraPosition, rayDirection);
#endif
#if VOXEL_GLOBAL_METRIC_LAB
        if (uint(clamp(intrinsicUp.w, 0.0, 10.0)) < 7u) {
            color = color / (color + vec3(1.0));
            color = pow(color, vec3(1.0 / 2.2));
        }
#else
        color = color / (color + vec3(1.0));
        color = pow(color, vec3(1.0 / 2.2));
#endif
        imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
        return;
    }

    float travel = 0.0;
    bool reachedVoxelBand = false;
    float switchDistance = max(frame.planetRadius * 0.13, frame.hitEpsilon * 4.0);
    for (uint step = 0; step < (frame.maxMarchSteps & 0xffffu); ++step) {
        vec3 samplePosition = cameraPosition + rayDirection * travel;
        float distanceToSurface = macroSphereDistance(samplePosition);
        if (distanceToSurface <= switchDistance) {
            reachedVoxelBand = true;
            break;
        }
        travel += max(distanceToSurface - switchDistance, frame.hitEpsilon);
        if (travel >= kFarDistance) {
            break;
        }
    }

    vec3 color;
    if (reachedVoxelBand) {
        vec3 ddaOrigin = cameraPosition + rayDirection * travel;
        DdaHit hit = traceVoxelVolume(ddaOrigin, rayDirection);
        if (hit.hit) {
            vec3 position = ddaOrigin + rayDirection * hit.distance;
            color = shadeVoxel(hit.material, position, hit.normal, rayDirection, hit.steps);
        } else {
            color = vec3(0.006, 0.012, 0.024);
        }
    } else {
        color = spaceBackground(cameraPosition, rayDirection);
    }

    color = color / (color + vec3(1.0));
    color = pow(color, vec3(1.0 / 2.2));
    imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
}
#endif
